#!/bin/sh
set -eu

WORKBENCH_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

select_python() {
    for candidate in python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
        if command -v "$candidate" >/dev/null 2>&1 &&
            "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

PYTHON_EXECUTABLE=$(select_python || true)
if [ -z "$PYTHON_EXECUTABLE" ]; then
    printf '%s\n' \
        '{"passed":false,"error":"Biomed Workbench requires Python 3.10 or newer for its core tools. Install a compatible Python runtime and retry."}' >&2
    exit 2
fi

command_name=${1:-help}
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command_name" in
    doctor)
        exec "$PYTHON_EXECUTABLE" "$WORKBENCH_ROOT/tools/doctor.py" "$@"
        ;;
    route)
        exec "$PYTHON_EXECUTABLE" "$WORKBENCH_ROOT/tools/route_task.py" "$@"
        ;;
    plan)
        exec "$PYTHON_EXECUTABLE" "$WORKBENCH_ROOT/tools/plan_research.py" "$@"
        ;;
    search)
        exec "$PYTHON_EXECUTABLE" "$WORKBENCH_ROOT/tools/search_tools.py" "$@"
        ;;
    run)
        exec "$PYTHON_EXECUTABLE" "$WORKBENCH_ROOT/tools/run_tool.py" "$@"
        ;;
    validate)
        exec "$PYTHON_EXECUTABLE" "$WORKBENCH_ROOT/tools/validate_workbench.py" "$@"
        ;;
    credentials)
        exec "$PYTHON_EXECUTABLE" "$WORKBENCH_ROOT/tools/configure_credentials.py" "$@"
        ;;
    project)
        exec "$PYTHON_EXECUTABLE" "$WORKBENCH_ROOT/tools/project_workflow.py" "$@"
        ;;
    help|-h|--help)
        printf '%s\n' \
            'Usage: tools/workbench doctor [--strict]' \
            '       tools/workbench route "SCIENTIFIC OBJECTIVE"' \
            '       tools/workbench plan "SCIENTIFIC OBJECTIVE"' \
            '       tools/workbench search [--id CAPABILITY_ID | SEARCH TERMS]' \
            '       tools/workbench run CAPABILITY_ID --input JSON --project-root DIR --artifact-bindings FILE --compatibility-row ROW' \
            '       tools/workbench project init|admit|review|decide|map|resume [OPTIONS]' \
            '       tools/workbench credentials [status | set NAME | remove NAME | connect-service SERVICE | mark-service SERVICE STATE | disconnect-service SERVICE | location]' \
            '       tools/workbench validate [--release]'
        ;;
    *)
        printf '{"passed":false,"error":"unknown workbench command: %s"}\n' "$command_name" >&2
        exit 2
        ;;
esac
