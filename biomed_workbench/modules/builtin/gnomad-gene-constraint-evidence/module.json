{
  "schema_version": 1,
  "id": "gnomad-gene-constraint-evidence",
  "version": "0.1.0",
  "title": "Retrieve gnomAD gene constraint evidence",
  "description": "Retrieve fixed-field gnomAD GRCh38 gene identity and aggregate loss-of-function constraint metrics for one bounded gene symbol.",
  "module_type": "data_source",
  "domains": [
    "evidence",
    "omics"
  ],
  "intents": [
    "gnomAD gene constraint",
    "LOEUF gene evidence",
    "gnomAD基因约束",
    "查询基因LOEUF"
  ],
  "questions": [
    "What current gnomAD GRCh38 aggregate constraint context is returned for this exact gene symbol?"
  ],
  "entrypoint": "biomed_workbench.capabilities.evidence:gnomad_gene_constraint_evidence",
  "execution": {
    "kind": "service",
    "timeout_seconds": 60,
    "max_output_bytes": 10000000
  },
  "maturity": "validated",
  "input_artifacts": [
    {
      "name": "gnomad_gene_query",
      "artifact_type": "gene_identifier_query",
      "processing_levels": [
        "declared"
      ],
      "required_metadata": [
        "constraint-interpretation-context"
      ],
      "formats": [
        {
          "name": "inline-json",
          "versions": [
            "1"
          ],
          "representations": [
            "structured"
          ],
          "compression": [
            "none"
          ],
          "required_indexes": [],
          "coordinate_systems": [
            "1-based-closed"
          ],
          "genome_build_policy": "required",
          "genome_builds": [
            "GRCh38"
          ],
          "annotation_releases": [],
          "orientations": [
            "request-object"
          ]
        }
      ]
    }
  ],
  "output_artifacts": [
    {
      "name": "gnomad_gene_constraint_evidence",
      "artifact_type": "gene_constraint_evidence",
      "processing_levels": [
        "retrieved",
        "source-preserved"
      ],
      "required_metadata": [
        "module-version",
        "service-contract-version",
        "reference-genome",
        "gene-id"
      ],
      "formats": [
        {
          "name": "normalized-json",
          "versions": [
            "1"
          ],
          "representations": [
            "structured"
          ],
          "compression": [
            "none"
          ],
          "required_indexes": [],
          "coordinate_systems": [
            "1-based-closed"
          ],
          "genome_build_policy": "required",
          "genome_builds": [
            "GRCh38"
          ],
          "annotation_releases": [
            "observed-service-contract"
          ],
          "orientations": [
            "gene-by-constraint-record"
          ]
        }
      ]
    }
  ],
  "preconditions": [
    "One bounded uppercase HGNC-style gene symbol is declared."
  ],
  "assumptions": [
    "The gnomAD GraphQL response preserves an exact GRCh38 gene identity."
  ],
  "quality_gates": [
    {
      "id": "gnomad-exact-gene-identity",
      "severity": "major",
      "description": "Only accept a response preserving the requested gene symbol and a nonempty gene ID.",
      "blocks_interpretation": true
    },
    {
      "id": "gnomad-constraint-boundary",
      "severity": "major",
      "description": "Aggregate constraint metrics are not clinical, causal, individual-risk, or treatment conclusions.",
      "blocks_interpretation": true
    }
  ],
  "limitations": [
    "Gene constraint metrics do not establish disease causality, variant pathogenicity, individual risk, gene essentiality, or therapeutic actionability."
  ],
  "evidence_effects": [
    "adds-source-preserved-gnomad-gene-constraint"
  ],
  "alternatives": [],
  "complements": [
    "gene-evidence",
    "variant-evidence",
    "dbsnp-rsid-evidence"
  ],
