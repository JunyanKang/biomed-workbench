{
  "schema_version": 1,
  "id": "variant-region-query-tabix",
  "version": "1.0.0",
  "title": "Retrieve indexed VCF records by genomic region",
  "description": "Guide and execute a header-preserving tabix query against a coordinate-sorted BGZF VCF 4.5 artifact with its declared TBI index, then validate sample identity, reference coordinates, record structure, and bounded regional membership.",
  "module_type": "analysis",
  "domains": ["omics"],
  "intents": ["query VCF by region", "retrieve indexed variants", "tabix VCF query", "按基因组区域提取VCF变异"],
  "questions": ["Which records in a declared, indexed VCF overlap one bounded one-based genomic region without changing their original header, sample order, alleles, filters, or genotypes?"],
  "maturity": "validated",
  "entrypoint": "scientific-command",
  "input_schema": {"type": "object", "additionalProperties": false, "properties": {"region": {"type": "string", "minLength": 5, "maxLength": 200, "pattern": "[^:\\s]+:[1-9][0-9]*-[1-9][0-9]*"}}, "required": ["region"]},
  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"payload_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1}}, "required": ["payload_roles"]},
  "input_artifacts": [{"name": "variants", "artifact_type": "variant_bundle", "formats": [{"name": "vcf", "versions": ["4.5"], "representations": ["text"], "compression": ["bgzf"], "required_indexes": ["tbi"], "coordinate_systems": ["one-based-inclusive"], "genome_build_policy": "required", "genome_builds": ["declared-in-project"], "annotation_releases": ["declared-in-project"], "orientations": ["sites-by-samples"]}], "processing_levels": ["raw-calls", "filtered", "normalized", "annotated"], "required_metadata": ["fileformat", "contig", "sample-id", "sample-manifest-digest", "reference-build", "reference-sequence-digest", "sort-order", "index-type"]}],
  "output_artifacts": [{"name": "regional_variants", "artifact_type": "variant_table", "formats": [{"name": "vcf", "versions": ["4.5"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["one-based-inclusive"], "genome_build_policy": "required", "genome_builds": ["inherited-matching-input-build"], "annotation_releases": ["inherited-from-input"], "orientations": ["sites-by-samples"]}], "processing_levels": ["raw-calls", "filtered", "normalized", "annotated"], "required_metadata": ["module_version", "compatibility_row_id", "fileformat", "contig", "sample-id", "sample-manifest-digest", "reference-build", "reference-sequence-digest", "query-region", "sort-order"]}],
  "assumptions": ["The BGZF VCF and TBI are a matched pair; contig names, coordinate convention, reference build, reference sequence digest, sample order, and processing level are correctly declared."],
  "preconditions": ["VCF records are coordinate sorted and structurally valid under VCF 4.5; the TBI digest is bound to the same variant artifact; the requested region names a declared contig and uses one-based inclusive coordinates."],
  "quality_gates": [
    {"id": "tabix-vcf-bundle-integrity", "severity": "fatal", "description": "VCF payload, TBI payload, fileformat, contig dictionary, sample manifest, reference build, sequence digest, sort order, and index type must reconcile before execution.", "blocks_interpretation": true},
    {"id": "tabix-vcf-region-output-integrity", "severity": "fatal", "description": "Output must preserve the VCF 4.5 header and sample order, remain coordinate sorted, and contain only records overlapping the declared one-based inclusive region.", "blocks_interpretation": true},
    {"id": "tabix-vcf-inference-scope", "severity": "major", "description": "Regional retrieval alone does not establish calling validity, normalization, annotation quality, cohort association, pathogenicity, or clinical actionability.", "blocks_interpretation": true}
  ],
  "evidence_effects": ["retrieves_declared_regional_variant_observations"],
  "alternatives": [],
  "complements": ["variant-summary", "variant-evidence", "tumor-mutation-burden"],
  "tool_requirements": [{"name": "tabix", "ecosystem": "system", "identity": "tabix", "required": true, "tested_versions": ["1.23"], "allowed_versions": [">=1.23,<1.24"], "version_source": "https://github.com/samtools/htslib/releases/tag/1.23", "verified_at": "2026-07-13", "version_probe": ["tabix", "--version"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "tabix \\(htslib\\) ([0-9]+(?:\\.[0-9]+)+)", "mismatch_policy": "block", "version_differences": [{"id": "tabix-123-header-region-query", "affected_versions": [">=1.23,<1.24"], "category": "behavior", "description": "The supported line validates -h header-preserving retrieval from a BGZF VCF with an adjacent TBI for reference:start-end regions.", "compatibility_effect": "requires-parser", "required_action": "Validate VCF fileformat, fixed header, sample order, coordinate sorting, regional membership, and exact source-record reconciliation after retrieval.", "source": "https://www.htslib.org/doc/1.23/tabix.html"}], "platforms": ["macos-arm64"]}],
  "dependencies": [{"name": "htslib", "ecosystem": "runtime", "identity": "htslib-runtime", "required": true, "tested_versions": ["1.23"], "allowed_versions": [">=1.23,<1.24"], "version_source": "https://github.com/samtools/htslib/releases/tag/1.23", "verified_at": "2026-07-13", "version_probe": ["tabix", "--version"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "htslib\\) ([0-9]+(?:\\.[0-9]+)+)", "purpose": "Decode BGZF VCF blocks, read the TBI coordinate index, and retrieve bounded genomic regions.", "conflicts": [], "platforms": ["macos-arm64"]}],
  "compatibility_matrix": [{"id": "tabix-1.23-vcf-4.5-bgzf-tbi-region", "module_version": "1.0.0", "tool_versions": {"tabix": [">=1.23,<1.24"]}, "dependency_versions": {"htslib": [">=1.23,<1.24"]}, "input_formats": {"variants": ["vcf@4.5"]}, "output_formats": {"regional_variants": ["vcf@4.5"]}, "platforms": ["macos-arm64"], "regression_evidence_ids": ["variant-region-query-tabix-regression-v1"], "end_to_end_evidence_ids": ["variant-region-query-tabix-e2e-v1"], "verified_at": "2026-07-13"}],
  "execution": {"kind": "command", "timeout_seconds": 120, "max_output_bytes": 10000000, "command": {"tool_name": "tabix", "executable": "tabix", "arguments": ["-h", "{input:vcf}", "{parameter:region}"], "inputs": [{"name": "vcf", "port": "variants", "role": "variants", "filename": "variants.vcf.gz"}, {"name": "index", "port": "variants", "role": "index", "filename": "variants.vcf.gz.tbi", "sidecar_for": "vcf"}], "outputs": [{"name": "subset", "port": "regional_variants", "role": "variants", "filename": "regional-variants.vcf", "media_type": "text/vcf", "capture": "stdout"}], "parameter_names": ["region"], "timeout_seconds": 120, "max_output_bytes": 10000000, "max_payload_bytes": 100000000, "path_mode": "workdir-relative"}},
  "access": "offline",
  "mutability": "read_only",
  "credentials": [],
  "limitations": ["The validated row supports one explicit region per invocation against VCF 4.5 BGZF+TBI on macOS arm64. It does not normalize alleles, split multiallelic records, verify REF against FASTA, annotate consequences, filter genotypes, calculate association, or interpret clinical significance."],
  "kernel_compatibility": [">=0.2.0,<0.3.0"],
  "provenance": {"license": "MIT", "concept_sources": ["https://github.com/samtools/htslib"]}
}
