          ],
          "category": "behavior",
          "compatibility_effect": "requires-parser",
          "description": "The supported line validates -h header-preserving retrieval from a BGZF VCF with an adjacent TBI for reference:start-end regions.",
          "id": "tabix-123-header-region-query",
          "required_action": "Validate VCF fileformat, fixed header, sample order, coordinate sorting, regional membership, and exact source-record reconciliation after retrieval.",
          "source": "https://www.htslib.org/doc/1.23/tabix.html"
        }
      ],
      "version_pattern": "tabix \\(htslib\\) ([0-9]+(?:\\.[0-9]+)+)",
      "version_probe": [
        "tabix",
        "--version"
      ],
      "version_probe_kind": "command",
      "version_probe_timeout_seconds": 10,
      "version_source": "https://github.com/samtools/htslib/releases/tag/1.23"
    }
