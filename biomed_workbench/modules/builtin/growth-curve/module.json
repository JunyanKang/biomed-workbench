{
  "schema_version": 1,
  "id": "growth-curve",
  "version": "2.0.0",
  "title": "Fit replicate-preserving bacterial growth curves",
  "description": "Blank-correct replicate-level OD measurements, fit logistic and modified Gompertz curves, compare them by AICc, retain residual and replicate diagnostics, and block condition-level interpretation when biological replication is not declared.",
  "module_type": "analysis",
  "domains": ["wetlab"],
  "intents": [
    "fit bacterial growth curve",
    "analyze bacterial OD growth curve",
    "compare logistic and Gompertz growth models",
    "analyze growth rate and lag phase",
    "细菌生长曲线拟合",
    "OD 生长曲线分析"
  ],
  "questions": [
    "Which declared empirical growth curve is best supported by the replicate-level OD measurements, and are its fit and replication diagnostics sufficient for the requested interpretation?"
  ],
  "entrypoint": "biomed_workbench.capabilities.experiment:growth_curve_summary",
  "execution": {"kind": "python", "timeout_seconds": 30, "max_output_bytes": 10000000},
  "maturity": "validated",
  "access": "offline",
  "mutability": "read_only",
  "credentials": [],
  "kernel_compatibility": [">=0.2.0,<0.3.0"],
  "input_artifacts": [
    {
      "name": "growth_measurements",
      "artifact_type": "microbial_growth_assay_table",
      "processing_levels": ["raw", "blank-declared"],
      "required_metadata": ["sample-identity", "organism-or-culture-identity", "measurement-unit", "instrument-identity", "plate-layout-or-vessel-layout", "replicate-level"],
      "formats": [
        {
          "name": "inline-json",
          "versions": ["1"],
          "representations": ["structured"],
          "compression": ["none"],
          "required_indexes": [],
          "coordinate_systems": [],
          "genome_build_policy": "not_applicable",
          "genome_builds": [],
          "annotation_releases": [],
          "orientations": ["observation-by-timepoint-and-replicate"]
        }
      ]
    }
  ],
  "output_artifacts": [
    {
      "name": "growth_curve_summary",
      "artifact_type": "microbial_growth_curve_summary",
      "processing_levels": ["model-derived", "diagnostic-bound"],
      "required_metadata": ["module_version", "compatibility_row_id", "fit-status", "replicate-level", "blank-correction-policy"],
      "formats": [
        {
          "name": "inline-json",
          "versions": ["1"],
          "representations": ["structured"],
          "compression": ["none"],
          "required_indexes": [],
          "coordinate_systems": [],
          "genome_build_policy": "not_applicable",
          "genome_builds": [],
          "annotation_releases": [],
          "orientations": ["curve-summary-with-model-diagnostics"]
        }
      ]
    }
  ],
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "observations": {
        "type": "array",
        "minItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_hours": {"type": "number"},
            "od": {"type": "number"},
            "replicate_id": {"type": "string", "minLength": 1}
          },
          "required": ["time_hours", "od", "replicate_id"]
        }
      },
      "blank_od": {"type": "number", "minimum": 0},
      "replicate_level": {"type": "string", "enum": ["unspecified", "technical", "biological"]},
      "times": {"type": "array", "minItems": 4, "items": {"type": "number"}},
      "values": {"type": "array", "minItems": 4, "items": {"type": "number"}},
      "window": {"type": "integer", "minimum": 2}
    },
    "required": []
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fit_admissible": {"type": "boolean"},
      "fit_status": {"type": "string"},
      "interpretation_status": {"type": "string"},
      "selected_model": {"type": "string"},
      "model_candidates": {"type": "array"},
      "selected_model_summary": {"type": "object"},
      "replicate_level": {"type": "string"},
      "replicate_design_status": {"type": "string"},
      "blank_correction": {"type": "object"},
      "input_observation_count": {"type": "integer"},
      "distinct_timepoint_count": {"type": "integer"},
      "timepoint_summary": {"type": "array"},
      "max_growth_rate_per_time": {"type": "number", "nullable": true},
      "doubling_time": {"type": "number", "nullable": true},
      "log_phase_start_time": {"type": "number", "nullable": true},
      "log_phase_end_time": {"type": "number", "nullable": true},
      "window": {"type": "integer"},
      "method": {"type": "string"},
      "quality_gates": {"type": "array"}
    },
    "required": ["fit_admissible", "fit_status", "interpretation_status", "selected_model", "model_candidates", "selected_model_summary", "replicate_level", "replicate_design_status", "blank_correction", "input_observation_count", "distinct_timepoint_count", "timepoint_summary", "max_growth_rate_per_time", "doubling_time", "log_phase_start_time", "log_phase_end_time", "window", "method", "quality_gates"]
  },
  "preconditions": [
    "Measurements use one declared OD or equivalent growth-readout unit, an explicit blank policy, stable culture identity, stable instrument settings, and retained replicate-level rows.",
    "At least four distinct timepoints and enough retained observations exist to compare four-parameter logistic and modified Gompertz models."
  ],
  "assumptions": [
    "A sigmoidal empirical curve is suitable for the supplied culture interval after blank correction.",
    "Logistic and modified Gompertz comparisons are descriptive model selection, not evidence that either model is a mechanistic account of growth."
  ],
  "quality_gates": [
    {
      "id": "growth-curve-input-contract",
      "severity": "fatal",
      "description": "Require finite, duplicate-free replicate-level time and OD measurements, a nonnegative declared blank correction, four distinct timepoints, and nontrivial post-blank dynamic range.",
      "blocks_interpretation": true
    },
    {
      "id": "growth-curve-fit-diagnostics",
      "severity": "fatal",
      "description": "Block curve interpretation unless at least one declared model converges and the selected model reaches the declared residual-quality threshold; retain both candidate diagnostics for review.",
      "blocks_interpretation": true
    },
    {
      "id": "growth-curve-replication-boundary",
      "severity": "major",
      "description": "Block strain, treatment, fitness, viability, or causal claims unless independently cultured biological replicates, layout review, and an appropriate between-condition model are declared outside this per-curve fit.",
      "blocks_interpretation": true
    }
  ],
  "limitations": [
    "This module does not infer species identity, detect contamination, normalize plate effects, replace blank or positive controls, select a mechanistic growth model, estimate colony-forming units, or perform treatment comparisons.",
    "AICc is used only to compare the two declared empirical models on the supplied observations. It does not validate extrapolation, causality, or biological reproducibility.",
    "Legacy times/values requests remain supported for continuity but have no repeated-measurement evidence and therefore remain blocked for biological interpretation."
  ],
  "evidence_effects": ["adds_diagnostic_bound_growth_curve_summary"],
  "alternatives": [],
  "complements": ["dose-response", "immunoassay-quantification", "qpcr-relative-expression"],
