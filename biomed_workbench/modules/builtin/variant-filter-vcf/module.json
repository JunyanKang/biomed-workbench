{
  "schema_version": 1,
  "id": "variant-filter-vcf",
  "version": "1.0.0",
  "title": "Filter biallelic VCF records with explicit evidence rules",
  "description": "Execute a digest-bound project implementation that strictly validates one-sample or sites-only VCF 4.5 records and filters them by FILTER status, QUAL, DP, AF, and optional ANN gene membership while preserving a complete exclusion audit.",
  "module_type": "analysis",
  "domains": ["omics"],
  "intents": ["filter VCF variants", "quality filter variant calls", "filter variants by depth allele fraction and genes", "按质量深度频率和基因过滤VCF"],
  "questions": ["Which declared biallelic variants remain after explicit FILTER, quality, depth, allele-fraction, missing-metric, and ANN gene rules, and why was every other record excluded?"],
  "maturity": "validated",
  "entrypoint": "scientific-command",
  "input_schema": {"type": "object", "additionalProperties": false, "properties": {"minimum_quality": {"type": "number", "minimum": 0}, "minimum_depth": {"type": "integer", "minimum": 0}, "minimum_allele_fraction": {"type": "number", "minimum": 0, "maximum": 1}, "genes": {"type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\*|[A-Za-z0-9_.-]+(?:,[A-Za-z0-9_.-]+)*"}, "require_pass": {"type": "boolean"}, "missing_metric_policy": {"type": "string", "enum": ["error", "exclude"]}}, "required": ["minimum_quality", "minimum_depth", "minimum_allele_fraction", "genes", "require_pass", "missing_metric_policy"]},
  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"payload_roles": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}, "required": ["payload_roles"]},
  "input_artifacts": [{"name": "variants", "artifact_type": "variant_table", "formats": [{"name": "vcf", "versions": ["4.5"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["one-based-inclusive"], "genome_build_policy": "required", "genome_builds": ["declared-in-project"], "annotation_releases": ["declared-in-project"], "orientations": ["sites-by-samples"]}], "processing_levels": ["raw-calls", "filtered", "normalized", "annotated"], "required_metadata": ["fileformat", "contig", "sample-id", "sample-manifest-digest", "reference-build", "reference-sequence-digest", "sort-order"]}],
  "output_artifacts": [
    {"name": "filtered_variants", "artifact_type": "variant_table", "formats": [{"name": "vcf", "versions": ["4.5"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["one-based-inclusive"], "genome_build_policy": "required", "genome_builds": ["inherited-matching-input-build"], "annotation_releases": ["inherited-from-input"], "orientations": ["sites-by-samples"]}], "processing_levels": ["filtered"], "required_metadata": ["module_version", "compatibility_row_id", "fileformat", "contig", "sample-id", "sample-manifest-digest", "reference-build", "reference-sequence-digest", "sort-order", "filter-parameter-digest"]},
    {"name": "filter_report", "artifact_type": "quality_report", "formats": [{"name": "biomed-vcf-filter-report", "versions": ["1.0.0"], "representations": ["structured", "text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["one-based-inclusive"], "genome_build_policy": "required", "genome_builds": ["inherited-matching-input-build"], "annotation_releases": ["inherited-from-input"], "orientations": ["record-accounting-by-exclusion-reason"]}], "processing_levels": ["derived"], "required_metadata": ["module_version", "compatibility_row_id", "reference-build", "sample-manifest-digest", "filter-parameter-digest"]}
  ],
  "assumptions": ["The input contains sites only or exactly one sample; INFO/DP and INFO/AF or single-sample FORMAT/DP and FORMAT/AD represent the intended record-level depth and allele fraction; ANN follows the allele|annotation|impact|gene convention."],
  "preconditions": ["VCF 4.5 header, contig dictionary, reference identity, sample identity, coordinate sorting, biallelic representation, and required filtering metrics are validated before a record can contribute evidence."],
  "quality_gates": [
    {"id": "vcf-filter-input-integrity", "severity": "fatal", "description": "VCF fileformat, fixed columns, contig dictionary, sample count, sort order, allele representation, numeric QUAL/DP/AF bounds, and declared metadata must be internally consistent.", "blocks_interpretation": true},
    {"id": "vcf-filter-missing-metric-policy", "severity": "fatal", "description": "Missing QUAL, DP, or AF must follow the explicitly declared error or exclusion policy; missing values are never silently accepted.", "blocks_interpretation": true},
    {"id": "vcf-filter-output-accounting", "severity": "fatal", "description": "Accepted plus reason-stratified excluded records must exactly equal input records, and every output record must independently satisfy all declared rules.", "blocks_interpretation": true},
    {"id": "vcf-filter-inference-scope", "severity": "major", "description": "Threshold filtering does not establish variant calling validity, allele normalization, consequence correctness, association, pathogenicity, clonality, or clinical actionability.", "blocks_interpretation": true}
  ],
  "evidence_effects": ["selects_variant_observations_under_declared_quality_rules"],
  "alternatives": [],
  "complements": ["variant-region-query-tabix", "variant-summary", "variant-evidence", "tumor-mutation-burden"],
  "tool_requirements": [{"name": "python3", "ecosystem": "system", "identity": "python3", "required": true, "tested_versions": ["3.14.3"], "allowed_versions": [">=3.14,<3.15"], "version_source": "https://www.python.org/downloads/release/python-3143/", "verified_at": "2026-07-13", "version_probe": ["python3", "--version"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "Python ([0-9]+(?:\\.[0-9]+)+)", "mismatch_policy": "block", "version_differences": [{"id": "python-314-project-implementation", "affected_versions": [">=3.14,<3.15"], "category": "behavior", "description": "The supported line executes the digest-bound project implementation with Python 3.14 standard-library parsing and strict zip and finite-number semantics.", "compatibility_effect": "requires-parser", "required_action": "Record the interpreter and implementation hashes and independently validate VCF and report outputs against the declared fixture.", "source": "https://docs.python.org/3.14/"}], "platforms": ["macos-arm64"]}],
  "dependencies": [{"name": "python-stdlib", "ecosystem": "runtime", "identity": "python-standard-library", "required": true, "tested_versions": ["3.14.3"], "allowed_versions": [">=3.14,<3.15"], "version_source": "https://www.python.org/downloads/release/python-3143/", "verified_at": "2026-07-13", "version_probe": ["python3", "--version"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "Python ([0-9]+(?:\\.[0-9]+)+)", "purpose": "Provide argparse, JSON, finite-number, path, and collection primitives used by the digest-bound VCF filter implementation.", "conflicts": [], "platforms": ["macos-arm64"]}],
  "compatibility_matrix": [{"id": "python-3.14-vcf-4.5-biallelic-filter-v1", "module_version": "1.0.0", "tool_versions": {"python3": [">=3.14,<3.15"]}, "dependency_versions": {"python-stdlib": [">=3.14,<3.15"]}, "input_formats": {"variants": ["vcf@4.5"]}, "output_formats": {"filtered_variants": ["vcf@4.5"], "filter_report": ["biomed-vcf-filter-report@1.0.0"]}, "platforms": ["macos-arm64"], "regression_evidence_ids": ["variant-filter-vcf-regression-v1"], "end_to_end_evidence_ids": ["variant-filter-vcf-e2e-v1"], "verified_at": "2026-07-13"}],
  "execution": {"kind": "command", "timeout_seconds": 120, "max_output_bytes": 2000000, "command": {"tool_name": "python3", "executable": "python3", "implementation_module": "biomed_workbench.implementations.vcf_filter", "arguments": ["{implementation}", "--input", "{input:vcf}", "--output", "{output:filtered}", "--report", "{output:report}", "--minimum-quality", "{parameter:minimum-quality}", "--minimum-depth", "{parameter:minimum-depth}", "--minimum-allele-fraction", "{parameter:minimum-allele-fraction}", "--genes", "{parameter:genes}", "--require-pass", "{parameter:require-pass}", "--missing-metric-policy", "{parameter:missing-metric-policy}"], "inputs": [{"name": "vcf", "port": "variants", "role": "variants", "filename": "variants.vcf"}], "outputs": [{"name": "filtered", "port": "filtered_variants", "role": "variants", "filename": "filtered.vcf", "media_type": "text/vcf"}, {"name": "report", "port": "filter_report", "role": "report", "filename": "filter-report.json", "media_type": "application/json"}], "parameter_names": ["minimum-quality", "minimum-depth", "minimum-allele-fraction", "genes", "require-pass", "missing-metric-policy"], "timeout_seconds": 120, "max_output_bytes": 2000000, "max_payload_bytes": 100000000, "path_mode": "workdir-relative"}},
  "access": "offline",
  "mutability": "read_only",
  "credentials": [],
  "limitations": ["The validated row accepts uncompressed VCF 4.5 with sites only or exactly one sample and rejects multiallelic and symbolic records. It does not normalize alleles, verify REF against FASTA, parse arbitrary consequence schemas, model tumor purity or clonality, or interpret clinical significance."],
  "kernel_compatibility": [">=0.2.0,<0.3.0"],
  "provenance": {"license": "Apache-2.0", "concept_sources": ["Independent clean-room implementation of explicit VCF filtering and record-accounting requirements."]}
}
