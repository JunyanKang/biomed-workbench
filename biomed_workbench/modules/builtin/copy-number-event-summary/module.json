            "copy-number-event-by-sample"
          ]
        }
      ]
    }
  ],
  "output_artifacts": [
    {
      "name": "copy_number_event_coverage_summary",
      "artifact_type": "cancer_genomics_copy_number_summary",
      "processing_levels": [
        "derived",
        "quality-controlled"
      ],
      "required_metadata": [
        "declared-sample-count",
        "coverage-status"
      ],
      "formats": [
        {
          "name": "normalized-json",
          "versions": [
            "1"
          ],
          "representations": [
            "structured"
          ],
          "compression": [
            "none"
          ],
          "required_indexes": [],
          "coordinate_systems": [],
          "genome_build_policy": "not_applicable",
          "genome_builds": [],
          "annotation_releases": [],
          "orientations": [
            "cohort-by-event-summary"
          ]
        }
      ]
    }
  ],
  "preconditions": [
    "Every record declares one unique sample_id and a discrete alteration code in -2..2.",
    "sample_count is the scientifically declared eligible denominator, not a value parsed from prose."
  ],
  "assumptions": [
    "Records share one cohort, assay interpretation, and discrete alteration convention."
  ],
  "quality_gates": [
    {
      "id": "cna-record-identity",
      "severity": "fatal",
      "description": "Reject duplicate or missing sample identifiers and unsupported discrete alteration codes.",
      "blocks_interpretation": true
    },
    {
      "id": "cna-coverage",
      "severity": "major",
      "description": "Block cohort-wide prevalence claims when observed records do not cover the declared eligible denominator.",
      "blocks_interpretation": true
    }
  ],
  "limitations": [
    "This module does not infer purity, ploidy, focality, allele-specific copy number, clonality, absolute copy number, driver status, or clinical actionability."
  ],
  "evidence_effects": [
    "adds-quality-controlled-discrete-copy-number-summary"
  ],
