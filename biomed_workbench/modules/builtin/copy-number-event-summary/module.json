      "name": "discrete_copy_number_records",
      "artifact_type": "cancer_genomics_copy_number_records",
      "processing_levels": [
        "declared"
      ],
      "required_metadata": [
        "declared-sample-count"
      ],
      "formats": [
        {
          "name": "inline-json",
          "versions": [
