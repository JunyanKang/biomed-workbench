{
  "schema_version": 1,
  "id": "copy-number-event-summary",
  "version": "0.1.0",
  "title": "Audit discrete copy-number event coverage",
  "description": "Audit sample identity, declared cohort denominator, coverage, and categorical event composition for discrete copy-number records before downstream cancer inference.",
  "module_type": "analysis",
  "domains": [
    "clinical",
    "omics"
  ],
  "intents": [
    "CNA队列质量审计",
    "拷贝数事件汇总",
    "copy number event coverage"
  ],
  "questions": [
    "Do declared discrete copy-number records cover the cohort sufficiently for descriptive event summaries?"
  ],
  "entrypoint": "biomed_workbench.capabilities.clinical:copy_number_event_summary",
  "execution": {
    "kind": "python",
    "timeout_seconds": 30,
    "max_output_bytes": 10000000
  },
  "maturity": "validated",
  "input_artifacts": [
