      "processing_levels": ["validated", "derived"],
      "required_metadata": ["module_version", "compatibility_row_id", "audit_digest", "parent_document_hash"]
    }
  ],
  "preconditions": [
    "The manuscript is represented as ordered machine-anchored blocks with mechanically generated full SHA-256 digests.",
    "Reviewer and editor comments have stable identifiers and the extraction-completeness state is declared.",
    "Every patch operation is bound to the current base digest, expected target digest, roadmap item, and reviewer comment."
  ],
  "assumptions": [
    "A revision is a new lineage artifact; the base manuscript remains immutable.",
    "Unchanged blocks must remain byte-content equivalent and retain their identifiers and digests.",
    "Claiming a completed analysis, experiment, figure, or citation requires a real evidence artifact identifier.",
    "Conflicting reviewer requests require an explicit editor-priority reconciliation rather than incompatible promises."
  ],
  "quality_gates": [
    {"id": "revision-base-integrity", "severity": "fatal", "description": "Reject stale, fabricated, malformed, or mismatched base and target digests before mutation.", "blocks_interpretation": true},
    {"id": "revision-all-or-none", "severity": "fatal", "description": "Validate all operations and reviewer commitments before deriving any revised artifact.", "blocks_interpretation": true},
    {"id": "revision-structural-checkpoint", "severity": "major", "description": "Require explicit acknowledgment for heading changes or touched-block ratios above the declared threshold.", "blocks_interpretation": true},
    {"id": "revision-response-traceability", "severity": "major", "description": "Block unsupported completion, unresolved placeholders, missing response locations, incomplete extraction, and unresolved reviewer conflicts.", "blocks_interpretation": true}
  ],
  "limitations": [
    "The module operates on a structured block contract and does not itself parse or redline DOCX or LaTeX files.",
    "Scientific sufficiency of bound evidence requires complementary claim, statistics, ethics, and editorial audits.",
    "A structural acknowledgment records a reviewed decision; it does not prove that the revised scientific argument is correct."
  ],
  "evidence_effects": ["creates_traceable_revision_artifact", "validates_delivery_readiness", "blocks_unsupported_revision_claims"],
  "alternatives": [],
