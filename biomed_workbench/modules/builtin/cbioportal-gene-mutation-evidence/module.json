  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"study_id": {"type": "string"}, "gene_symbol": {"type": "string"}, "entrez_gene_id": {"type": "integer"}, "found": {"type": "boolean"}, "resolution_status": {"type": "string"}, "molecular_profile": {"type": "object", "nullable": true}, "sample_list": {"type": "object", "nullable": true}, "records": {"type": "array"}, "returned_count": {"type": "integer"}, "truncated": {"type": "boolean"}, "provenance": {"type": "object"}, "limitations": {"type": "array"}}, "required": ["study_id", "gene_symbol", "found", "resolution_status", "molecular_profile", "sample_list", "records", "returned_count", "truncated", "provenance", "limitations"]},
