{
  "schema_version": 1,
  "id": "cbioportal-gene-mutation-evidence",
  "version": "0.1.0",
  "title": "Retrieve cBioPortal study-gene mutation evidence",
  "description": "Retrieve bounded source-preserved mutation records for one exact gene in one exact public cBioPortal study, with explicit molecular-profile, sample-list, coordinate, genome-build and truncation context.",
  "module_type": "data_source",
  "domains": ["clinical", "evidence", "omics"],
  "intents": ["cBioPortal gene mutation", "cBioPortal突变", "肿瘤队列基因突变", "查询研究中基因突变"],
  "questions": ["Which bounded cBioPortal mutation records are returned for this exact gene in this exact public study?"],
  "entrypoint": "biomed_workbench.capabilities.clinical:cbioportal_gene_mutations",
  "execution": {"kind": "service", "timeout_seconds": 90, "max_output_bytes": 20000000},
  "maturity": "validated",
  "input_artifacts": [{"name": "cbioportal_study_gene_mutation_query", "artifact_type": "cancer_study_gene_query", "processing_levels": ["declared"], "required_metadata": ["study-selection-rationale", "gene-selection-rationale"], "formats": [{"name": "inline-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["request-object"]}]}],
  "output_artifacts": [{"name": "cbioportal_study_gene_mutation_evidence", "artifact_type": "cancer_genomics_mutation_records", "processing_levels": ["retrieved", "source-preserved"], "required_metadata": ["module-version", "service-contract-version", "study-id", "gene-symbol", "molecular-profile-id", "sample-list-id", "truncation-status"], "formats": [{"name": "normalized-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["1-based-closed"], "genome_build_policy": "declared", "genome_builds": ["GRCh37", "GRCh38", "hg19"], "annotation_releases": ["observed-service-contract"], "orientations": ["mutation-record-by-sample"]}]}],
  "preconditions": ["One exact public cBioPortal study ID and one bounded uppercase HGNC-style gene symbol are declared.", "A declared molecular-profile or sample-list identifier, when supplied, belongs to the declared study and is scientifically justified."],
  "assumptions": ["The cBioPortal public REST API preserves gene, study, mutation-profile and sample-list identity in the returned records."],
  "quality_gates": [{"id": "cbioportal-mutation-post-filter", "severity": "fatal", "description": "Use the fixed POST mutation endpoint with an Entrez gene filter; do not use the GET endpoint because it can ignore gene filtering.", "blocks_interpretation": true}, {"id": "cbioportal-mutation-identity", "severity": "major", "description": "Every retained record must preserve the requested study, selected mutation profile and resolved Entrez gene identity.", "blocks_interpretation": true}, {"id": "cbioportal-truncation", "severity": "major", "description": "A capped response must be marked truncated and cannot be reported as an exhaustive mutation set or frequency estimate.", "blocks_interpretation": true}, {"id": "cbioportal-genome-build", "severity": "major", "description": "Returned coordinates must retain their declared NCBI build and cannot be combined with another coordinate system without explicit liftover and validation.", "blocks_interpretation": true}],
  "limitations": ["This module does not estimate cohort-wide mutation frequency, prevalence, clonality, coverage, calling sensitivity, survival, treatment response, pathogenicity, clinical actionability, or causality."],
  "evidence_effects": ["adds-source-preserved-cancer-study-gene-mutation-records"],
