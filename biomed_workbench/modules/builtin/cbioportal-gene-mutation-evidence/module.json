  "compatibility_matrix": [{"id": "cbioportal-study-gene-mutation-2026-07-24", "module_version": "0.1.0", "tool_versions": {}, "dependency_versions": {"python": [">=3.14,<3.15"]}, "input_formats": {"cbioportal_study_gene_mutation_query": ["inline-json@1"]}, "output_formats": {"cbioportal_study_gene_mutation_evidence": ["normalized-json@1"]}, "platforms": ["any"], "regression_evidence_ids": ["cbioportal-gene-mutation-evidence-regression-v1"], "end_to_end_evidence_ids": ["cbioportal-gene-mutation-evidence-e2e-v1"], "verified_at": "2026-07-24"}],
  "access": "public_api",
