  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "All requested modalities must contain exactly the same unique cells in the same order; no silent intersection, imputation, or duplication is allowed.",
      "id": "multimodal-cell-alignment",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Raw counts, WNN preprocessing, MOFA+ model layers, feature namespaces and assay provenance must be explicit and finite.",
      "id": "multimodal-matrix-semantics",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "WNN requires bounded finite cell-specific modality weights that sum to one plus reloadable weighted KNN, SNN, neighbor, UMAP and cluster fields.",
      "id": "multimodal-wnn-weights-graphs",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "MOFA+ requires finite factors, feature loadings and view-wise factor variance for every declared view after nonconstant-feature filtering.",
      "id": "multimodal-mofa-factors",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "WNN neighborhoods and MOFA+ latent factors remain method-specific evidence and cannot be collapsed into one unqualified integrated state.",
      "id": "multimodal-backend-separation",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Reload every object and table and reconcile cells, source counts, graphs, weights, factors, loadings, variance, parameters, versions and digests.",
      "id": "multimodal-source-and-output-reload",
      "severity": "fatal"
    }
  ],
  "questions": [
    "Which paired-cell neighborhoods and latent factors are jointly supported across RNA, chromatin accessibility, and protein views while retaining modality-specific evidence and uncertainty?"
  ],
