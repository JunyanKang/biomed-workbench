{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not silently intersect or reorder cells, guess transformations, overwrite source counts, impute absent modalities, tune factors or clusters toward desired labels, or treat integration as biological truth.",
      "Do not collapse WNN weights and MOFA+ factors into one score or report generated or unreloaded outputs as evidence."
    ],
    "languages": [
      "r",
      "python",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "paired modalities",
          "local-neighborhood objective",
          "global-factor objective",
          "missingness"
        ],
        "id": "multimodal-backend",
        "parameter": "backend",
        "selection_rule": "Use WNN for paired local neighborhoods and MOFA+ for view-resolved latent factors; run both only when both questions are justified.",
        "validation_rule": "Method disagreement remains evidence and is never averaged away."
      }
    ],
    "postflight_checks": [
      "Reconcile every source cell and count and inspect WNN weights, graphs, neighbors, UMAP and clusters.",
      "Inspect MOFA+ convergence, factors, loadings, view-wise variance and complete HDF5/table reloads."
    ],
    "preflight_checks": [
      "Inspect actual Seurat RDS or H5MU, paired cell order, modality counts and layers, feature namespaces, transformations, assay provenance, dimensions and output paths.",
      "Detect exact Seurat, Signac, MOFA+, R, Python and dependency versions in existing runtimes."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
      "input-sha256",
      "modalities",
      "cell-identity-policy",
      "raw-count-locations",
      "model-layers",
      "preprocessing",
      "dimensions",
      "neighbor-parameters",
      "mofa-options",
      "actual-tool-versions",
      "output-sha256",
      "quality-gates"
