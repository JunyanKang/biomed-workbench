    "schema_version": 1,
    "template_sections": [
      {
        "id": "inspect-multimodal-contract",
        "output_artifact_types": [
          "single_cell_multimodal_evidence"
        ],
        "purpose": "Establish paired cells, counts, transformations, features and backend scope.",
        "required_logic": [
          "Inspect every modality, cell order, raw counts, model layers, feature namespaces, assay provenance, genome build where relevant, source digests and missingness.",
          "Freeze WNN preprocessing and dimensions or MOFA+ model layers, features, factors and convergence parameters before execution."
        ],
        "template_files": [
          "templates/prepare_10x_multiome.R",
          "templates/run_wnn.R",
          "templates/fit_mofaplus.py"
        ]
      },
      {
        "id": "fit-wnn",
        "output_artifact_types": [
          "single_cell_multimodal_evidence"
        ],
        "purpose": "Build RNA+ATAC or RNA+ADT weighted neighborhoods.",
        "required_logic": [
          "Use log-normalized RNA PCA, TF-IDF/LSI for ATAC with the first component excluded, or CLR/PCA for ADT.",
          "Retain both cell-specific modality weights, weighted KNN/SNN, weighted neighbor, UMAP and cluster fields."
        ],
        "template_files": [
          "templates/run_wnn.R"
        ]
      },
      {
        "id": "fit-mofaplus",
        "output_artifact_types": [
          "single_cell_multimodal_evidence"
        ],
        "purpose": "Fit shared latent factors without losing view-specific loadings.",
        "required_logic": [
          "Use only declared finite model matrices, remove constant features, preserve exact paired cells and scale views explicitly.",
          "Retain factors, every view's feature loadings, view-factor variance explained and the complete HDF5 model."
        ],
        "template_files": [
          "templates/fit_mofaplus.py"
        ]
      },
      {
        "id": "reload-and-admit",
        "output_artifact_types": [
          "single_cell_multimodal_evidence"
        ],
        "purpose": "Verify source preservation and method-specific evidence.",
        "required_logic": [
          "Reload all objects and tables and reconcile cells, counts, graphs, weights, factors, loadings, variance, parameters, versions and digests.",
          "Use independent truth only after parameters are frozen and never collapse WNN and MOFA+ outputs into one score."
        ],
        "template_files": [
          "templates/prepare_10x_multiome.R",
          "templates/run_wnn.R",
          "templates/fit_mofaplus.py"
        ]
      }
    ]
  },
