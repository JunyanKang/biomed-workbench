  "preconditions": [
    "Every modality has unique feature identities, immutable source counts, identical cells in identical order, at least 15 informative cells and features, declared model matrices and transformations, and new output paths."
  ],
  "provenance": {
    "concept_sources": [
      "Project-owned paired multimodal workflow retaining method-specific WNN and MOFA+ evidence.",
      "https://satijalab.org/seurat/reference/findmultimodalneighbors",
      "https://stuartlab.org/signac/reference/index.html",
