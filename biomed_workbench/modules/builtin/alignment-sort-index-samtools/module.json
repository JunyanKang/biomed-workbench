  "maturity": "validated",
  "entrypoint": "scientific-command",
  "input_schema": {"type": "object", "additionalProperties": false, "properties": {"threads": {"type": "integer", "minimum": 1, "maximum": 16}}, "required": ["threads"]},
  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"payload_roles": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}, "required": ["payload_roles"]},
  "input_artifacts": [{"name": "alignments", "artifact_type": "sequence_alignments", "formats": [{"name": "sam", "versions": ["1.6"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["one-based-leftmost"], "genome_build_policy": "required", "genome_builds": ["declared-in-project"], "annotation_releases": [], "orientations": ["alignment-records"]}], "processing_levels": ["aligned"], "required_metadata": ["sample-id", "read-group", "reference-build", "reference-sequence-digest", "sort-order"]}],
  "output_artifacts": [{"name": "alignment_bundle", "artifact_type": "alignment_bundle", "formats": [{"name": "bam", "versions": ["1.6"], "representations": ["binary", "container"], "compression": ["bgzf"], "required_indexes": ["csi"], "coordinate_systems": ["one-based-leftmost"], "genome_build_policy": "required", "genome_builds": ["inherited-matching-input-build"], "annotation_releases": [], "orientations": ["alignment-records"]}], "processing_levels": ["aligned"], "required_metadata": ["module_version", "compatibility_row_id", "sample-id", "read-group", "reference-build", "reference-sequence-digest", "sort-order", "index-type"]}],
  "assumptions": ["The input SAM header, sequence dictionary, read groups, sample identity, reference build, and reference digest are complete and internally consistent."],
