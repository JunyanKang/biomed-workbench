  "compatibility_matrix": [{"id": "samtools-sort-1.23-sam-1.6-bam-csi", "module_version": "1.0.0", "tool_versions": {"samtools": [">=1.23,<1.24"]}, "dependency_versions": {"htslib": [">=1.23,<1.24"]}, "input_formats": {"alignments": ["sam@1.6"]}, "output_formats": {"alignment_bundle": ["bam@1.6"]}, "platforms": ["macos-arm64"], "regression_evidence_ids": ["alignment-sort-index-samtools-regression-v1"], "end_to_end_evidence_ids": ["alignment-sort-index-samtools-e2e-v1"], "verified_at": "2026-07-13"}],
  "execution": {"kind": "command", "timeout_seconds": 300, "max_output_bytes": 2000000, "command": {"tool_name": "samtools", "executable": "samtools", "arguments": ["sort", "--write-index", "--threads", "{parameter:threads}", "-o", "{output:bam}", "{input:sam}"], "inputs": [{"name": "sam", "port": "alignments", "role": "alignments", "filename": "alignments.sam"}], "outputs": [{"name": "bam", "port": "alignment_bundle", "role": "alignments", "filename": "alignments.bam", "media_type": "application/bam"}, {"name": "csi", "port": "alignment_bundle", "role": "index", "filename": "alignments.bam.csi", "media_type": "application/octet-stream", "capture": "derived"}], "parameter_names": ["threads"], "timeout_seconds": 300, "max_output_bytes": 2000000, "max_payload_bytes": 100000000, "path_mode": "workdir-relative"}},
