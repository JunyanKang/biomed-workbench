  "questions": ["Does this NSFC biomedical proposal satisfy the current declared agency profile and a coherent phenotype-mechanism research argument?"],
  "entrypoint": "biomed_workbench.capabilities.proposal_writing:audit_nsfc_proposal",
  "execution": {"kind": "python", "timeout_seconds": 30, "max_output_bytes": 10000000},
  "maturity": "validated",
  "input_artifacts": [{"name":"proposal","artifact_type":"nsfc_proposal_semantic_model","formats":[{"name":"inline-json","versions":["1"],"representations":["structured"],"compression":["none"],"required_indexes":[],"coordinate_systems":[],"genome_build_policy":"not_applicable","genome_builds":[],"annotation_releases":["nsfc-2026"],"orientations":["request-object"]}],"processing_levels":["declared"],"required_metadata":["guideline-year","program-type"]}],
