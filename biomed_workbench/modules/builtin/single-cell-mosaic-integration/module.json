  "assumptions": ["totalVI is for RNA+protein, MultiVI is for RNA+ATAC with paired anchors and shared feature universes, and GLUE uses an external feature graph to orient paired or unpaired modalities."],
  "quality_gates": [
    {"id": "multimodal-count-identity-missingness", "severity": "fatal", "description": "Require immutable nonnegative integer counts, unique union cell identities, explicit modality-presence masks, paired-anchor accounting and unchanged cells after reload.", "blocks_interpretation": true},
    {"id": "method-specific-feature-and-prior-contract", "severity": "fatal", "description": "Require RNA+protein for totalVI, a shared peak universe and paired anchors for MultiVI, and a versioned feature-matched guidance graph for GLUE.", "blocks_interpretation": true},
    {"id": "mosaic-benchmark-and-inference-boundary", "severity": "fatal", "description": "Evaluate modality/batch mixing together with biological preservation, paired-anchor FOSCTTM and held-out modality reconstruction; forbid integrated, imputed or latent values as confirmatory differential-inference responses.", "blocks_interpretation": true}
  ],
  "limitations": ["A joint latent space does not prove cell identity, regulatory linkage or modality reconstruction accuracy. totalVI does not replace protein-panel QC. MultiVI needs a shared ATAC peak universe and paired anchors. GLUE results depend on the declared guidance graph. Missing modalities remain modelled missing values rather than observations."],
