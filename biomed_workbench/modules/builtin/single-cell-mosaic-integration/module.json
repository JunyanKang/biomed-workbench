{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Do not install into or mutate the host environment, silently intersect or reorder cells, fabricate missing modalities, infer unmeasured features without held-out validation, use desired labels to tune integration, or use latent/imputed values for confirmatory differential inference."
    ],
    "languages": [
      "python",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "modalities",
          "paired anchors",
          "missingness pattern",
          "shared peak universe",
          "guidance graph",
          "GPU"
        ],
        "id": "mosaic-method",
        "parameter": "totalvi-multivi-scglue",
        "selection_rule": "Use totalVI for CITE-seq RNA+protein, MultiVI for paired/mosaic RNA+ATAC, and GLUE for graph-linked paired or unpaired modalities.",
        "validation_rule": "Block a method whose required modality, anchors, feature universe or prior graph is absent."
      },
      {
        "decision_inputs": [
          "labels",
          "batches",
          "modalities",
          "paired IDs",
          "held-out measurements"
        ],
        "id": "mosaic-evaluation",
        "parameter": "mixing-preservation-anchor-reconstruction",
        "selection_rule": "Evaluate mixing and biology separately and retain all metric families rather than constructing one winner score.",
        "validation_rule": "Require paired-anchor and held-out reconstruction evidence when those claims are made."
      }
    ],
    "postflight_checks": [
      "Reload native models, H5AD/H5MU, latent tables and reports; reconcile cells, modalities, features, missingness, parameters, versions and digests."
    ],
    "preflight_checks": [
      "Inspect actual H5AD/H5MU axes, raw counts, cell identities, modality masks, paired anchors, feature namespaces, batch/sample metadata, guidance graph and isolated runtime."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "input-digests",
      "method-version",
      "cell-identity-policy",
      "modality-presence",
      "paired-anchors",
      "feature-universes",
      "guidance-graph-release",
      "parameters",
      "seed",
      "output-digests",
      "quality-gates"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "inspect-mosaic-design",
        "output_artifact_types": [
          "single_cell_mosaic_integration_evidence"
        ],
        "purpose": "Freeze cell identity, modality presence, feature universes and model scope.",
        "required_logic": [
          "Inspect raw counts, union cells, paired anchors, RNA genes, protein panels, ATAC peak universes, batches, samples and source digests.",
          "Use totalVI only for RNA+protein, MultiVI only for RNA+ATAC with paired anchors, and GLUE only with a reviewed feature guidance graph."
        ],
        "template_files": [
          "templates/run_scvi_mosaic.py",
          "templates/run_scglue.py"
        ]
      },
      {
        "id": "fit-native-model",
        "output_artifact_types": [
          "single_cell_mosaic_integration_evidence"
        ],
        "purpose": "Fit the declared backend without converting missing modalities into observations.",
        "required_logic": [
          "Preserve raw counts and source cell order.",
          "Retain native models, joint embeddings, modality-presence accounting, parameters and versions.",
          "For MultiVI use a shared peak universe; for GLUE retain graph nodes, edges and release."
        ],
        "template_files": [
          "templates/run_scvi_mosaic.py",
          "templates/run_scglue.py"
        ]
      },
      {
        "id": "benchmark-and-admit",
        "output_artifact_types": [
          "single_cell_mosaic_integration_evidence"
        ],
        "purpose": "Admit integration only when mixing and biological preservation are jointly acceptable.",
        "required_logic": [
          "Review modality and batch ASW within biology, label ASW, cross-modality transfer, paired-anchor FOSCTTM, rare states and donor reproducibility.",
          "Evaluate imputation only by hiding observed measurements before fitting.",
          "Return differential inference to raw counts and biological-sample replication."
        ],
        "template_files": [
          "templates/evaluate_mosaic.py"
        ]
      }
    ]
  },
  "alternatives": [
    "single-cell-multimodal-integration"
  ],
  "assumptions": [
    "totalVI is for RNA+protein, MultiVI is for RNA+ATAC with paired anchors and shared feature universes, and GLUE uses an external feature graph to orient paired or unpaired modalities."
  ],
  "code_templates": [
