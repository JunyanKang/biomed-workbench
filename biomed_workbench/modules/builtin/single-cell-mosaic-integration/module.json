  "questions": ["Which joint representation preserves biological state while handling the declared paired, unpaired or mosaic modality design without fabricating missing measurements?"],
  "entrypoint": "biomed_workbench.capabilities.agent_analysis:prepare_agent_analysis",
  "execution": {"kind": "workflow", "timeout_seconds": 30, "max_output_bytes": 2000000},
