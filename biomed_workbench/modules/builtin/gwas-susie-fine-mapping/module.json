            "purpose": "Validate, run and serialize a constrained SuSiE-RSS fine-mapping analysis.",
            "quality_gate_ids": [
                "finemap-harmonization",
                "finemap-ld-validity",
                "finemap-convergence-and-credible-set",
                "finemap-claim-boundary"
