                    "name": "normalized-json",
                    "versions": [
                        "1"
                    ],
                    "representations": [
                        "structured"
                    ],
                    "compression": [
                        "none"
                    ],
                    "required_indexes": [],
                    "coordinate_systems": [
                        "inherited-variant-build"
                    ],
                    "genome_build_policy": "declared",
                    "genome_builds": [
                        "inherited-from-input"
                    ],
                    "annotation_releases": [],
                    "orientations": [
                        "variant-by-posterior-evidence"
                    ]
                }
            ]
        }
    ],
    "preconditions": [
        "The locus was selected independently of desired results; summary statistics and LD have identical ordered variant identifiers, harmonized effect alleles, compatible build and ancestry; sample size, maximum effects, coverage and output path are declared before fitting."
    ],
    "assumptions": [
        "The requested locus is adequately represented by the supplied LD reference and SuSiE-RSS sparse-effect model. This assumption is examined but never proved by the model output."
    ],
    "quality_gates": [
        {
            "id": "finemap-harmonization",
            "severity": "fatal",
            "description": "Block unless variant identifiers, order, build, alleles, beta, standard error, p value, sample size and LD reference provenance are complete and mutually compatible.",
            "blocks_interpretation": true
        },
        {
            "id": "finemap-ld-validity",
            "severity": "fatal",
            "description": "Require a finite symmetric unit-diagonal positive-semidefinite LD correlation matrix exactly ordered to the summary statistics; reject a mismatched or ill-conditioned matrix rather than repair it silently.",
            "blocks_interpretation": true
        },
        {
            "id": "finemap-convergence-and-credible-set",
            "severity": "fatal",
            "description": "Require detected compatible susieR/digest/jsonlite versions, model convergence, reloaded PIP and credible-set outputs, declared coverage/purity policy, and retained LD diagnostics.",
            "blocks_interpretation": true
        },
        {
            "id": "finemap-claim-boundary",
            "severity": "major",
            "description": "PIPs and credible sets are not causal variants, causal genes, colocalization, mechanism, clinical interpretation or functional validation.",
            "blocks_interpretation": true
        }
    ],
    "limitations": [
        "This module does not select loci, harmonize alleles, generate LD, impute variants, estimate heritability, perform colocalization, select a gene, or establish causality. It expects a compatible project-approved scientific runtime before execution."
    ],
    "evidence_effects": [
        "adds-reloaded-susie-rss-pip-and-credible-set-evidence",
        "preserves-summary-LD-harmonization-and-convergence-policy"
    ],
    "alternatives": [],
    "complements": [
        "gene-identifier-resolution",
        "gene-ortholog-evidence",
        "genome-coordinate-liftover"
    ],
