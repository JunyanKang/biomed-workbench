                        "text"
                    ],
                    "compression": [
                        "none"
                    ],
                    "required_indexes": [],
                    "coordinate_systems": [
                        "same-as-summary-statistics"
                    ],
                    "genome_build_policy": "declared",
                    "genome_builds": [
                        "same-as-summary-statistics"
                    ],
                    "annotation_releases": [],
                    "orientations": [
                        "variant-by-variant-correlation"
                    ]
                }
            ]
        }
    ],
    "output_artifacts": [
        {
            "name": "fine_mapping_evidence",
            "artifact_type": "gwas_fine_mapping_evidence",
            "processing_levels": [
                "fitted",
                "convergence-checked",
                "reloaded"
            ],
            "required_metadata": [
                "module-version",
                "summary-sha256",
                "ld-sha256",
                "susieR-version",
                "sample-size",
                "L",
                "credible-set-coverage",
