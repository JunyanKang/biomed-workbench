      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require detected compatible susieR/digest/jsonlite versions, model convergence, reloaded PIP and credible-set outputs, declared coverage/purity policy, and retained LD diagnostics.",
