      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require a finite symmetric unit-diagonal positive-semidefinite LD correlation matrix exactly ordered to the summary statistics; reject a mismatched or ill-conditioned matrix rather than repair it silently.",
