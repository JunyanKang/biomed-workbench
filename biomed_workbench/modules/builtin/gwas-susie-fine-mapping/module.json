{
    "schema_version": 1,
    "id": "gwas-susie-fine-mapping",
    "version": "0.1.0",
    "title": "Fine-map a GWAS locus with SuSiE-RSS",
    "description": "Direct Codex to prepare, validate, execute, reload and interpret a SuSiE-RSS fine-mapping analysis from pre-harmonized locus summary statistics and exactly aligned LD evidence.",
    "module_type": "analysis",
    "domains": [
        "omics",
        "genetics"
    ],
    "intents": [
        "GWAS fine mapping",
        "SuSiE RSS",
        "credible set",
        "posterior inclusion probability",
        "GWAS \u7cbe\u7ec6\u5b9a\u4f4d"
    ],
    "questions": [
        "Which variants receive model- and LD-reference-dependent posterior inclusion probabilities and credible-set membership in one predeclared GWAS locus after strict harmonization and convergence checks?"
    ],
    "entrypoint": "biomed_workbench.capabilities.agent_analysis:prepare_agent_analysis",
    "execution": {
        "kind": "workflow",
        "timeout_seconds": 30,
        "max_output_bytes": 2000000
    },
    "maturity": "validated",
    "input_artifacts": [
        {
            "name": "locus_summary_statistics",
            "artifact_type": "gwas_locus_summary_statistics",
            "processing_levels": [
                "harmonized",
