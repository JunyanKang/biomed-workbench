    "agent_protocol": {
        "schema_version": 1,
        "mode": "packaged_parameterized_workflow",
        "languages": [
            "R",
            "notebook"
        ],
        "template_sections": [
            {
                "id": "freeze-finemapping-contract",
                "purpose": "Validate locus, allele, LD and parameter identity before fitting.",
                "required_logic": [
                    "Inspect exact ordered variant IDs, effect alleles, build, association model, sample size, LD reference ancestry and immutable digests.",
                    "Reject summary-statistic/LD mismatch, implicit allele harmonization, non-PSD LD, mutable outputs and result-driven locus selection."
                ],
                "output_artifact_types": [
                    "gwas_fine_mapping_evidence"
                ],
                "template_files": [
                    "templates/run_susie_rss_finemapping.R"
                ]
            },
            {
                "id": "fit-reload-and-bound",
                "purpose": "Run SuSiE-RSS and preserve model-bounded posterior evidence.",
                "required_logic": [
                    "Detect R packages and versions, run frozen L and coverage settings, require convergence, reload PIPs and credible sets, and retain LD eigenvalue diagnostics.",
                    "Do not transform PIP or credible-set membership into causal, gene, colocalization or clinical claims."
                ],
                "output_artifact_types": [
                    "gwas_fine_mapping_evidence"
                ],
                "template_files": [
                    "templates/run_susie_rss_finemapping.R"
                ]
            }
        ],
        "parameter_rules": [
            {
                "id": "fine-mapping-prior-and-complexity",
                "parameter": "maximum-effects-and-credible-set-coverage",
                "decision_inputs": [
                    "locus-width",
                    "LD-structure",
                    "independent-signal-prior",
                    "trait-and-sample-design"
                ],
                "selection_rule": "Declare L and credible-set coverage before inspecting PIPs or credible sets; conduct an explicit sensitivity run when scientifically warranted.",
                "validation_rule": "Do not increase L or alter coverage until a desired variant enters a credible set."
            }
        ],
        "preflight_checks": [
            "Detect R, susieR, digest and jsonlite versions in an existing compatible scientific environment.",
            "Validate summary/LD variant order, alleles, numerical fields, build, sample size, ancestry compatibility, matrix properties and new output path."
        ],
        "postflight_checks": [
            "Reload result JSON and reconcile source SHA-256 digests, versions, sample size, L, coverage, convergence, PIPs, credible sets and LD diagnostics."
        ],
        "provenance_fields": [
            "module-id",
            "module-version",
            "summary-sha256",
            "ld-sha256",
            "build",
            "trait-definition",
            "LD-reference",
            "R-version",
            "susieR-version",
            "parameters",
            "convergence",
            "output-sha256",
            "quality-gates"
        ],
        "forbidden_actions": [
            "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
            "Do not harmonize alleles, repair LD, impute variants, choose loci or tune L/coverage after observing results.",
            "Do not call posterior evidence a causal variant, causal gene, colocalized signal, clinical result or biological mechanism without independent evidence."
        ],
        "requires_observed_execution": true
    }
