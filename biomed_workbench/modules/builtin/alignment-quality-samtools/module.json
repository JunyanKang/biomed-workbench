{
  "schema_version": 1,
  "id": "alignment-quality-samtools",
  "version": "1.0.0",
  "title": "Qualify alignment mechanics with samtools flagstat",
  "description": "Execute exact-version samtools flagstat on a content-addressed coordinate-sorted BAM bundle and preserve the QC-stratified JSON report for downstream scientific gating.",
  "module_type": "validation",
  "domains": ["omics"],
  "intents": ["BAM alignment QC", "samtools flagstat", "mapping quality summary", "比对结果质控"],
  "questions": ["Are alignment class counts, mapping, duplication, pairing, singleton, and QC-failure metrics mechanically consistent and ready for assay-specific review?"],
  "maturity": "validated",
  "entrypoint": "scientific-command",
  "input_schema": {"type": "object", "additionalProperties": false, "properties": {"threads": {"type": "integer", "minimum": 1, "maximum": 16}}, "required": ["threads"]},
  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"payload_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1}}, "required": ["payload_roles"]},
  "input_artifacts": [{
    "name": "alignments", "artifact_type": "alignment_bundle",
    "formats": [{"name": "bam", "versions": ["1.6"], "representations": ["binary", "container"], "compression": ["bgzf"], "required_indexes": ["bai"], "coordinate_systems": ["one-based-leftmost"], "genome_build_policy": "required", "genome_builds": ["declared-in-project"], "annotation_releases": [], "orientations": ["alignment-records"]}],
    "processing_levels": ["aligned", "deduplicated", "recalibrated"],
    "required_metadata": ["sample-id", "sample-manifest-digest", "read-group", "sort-order", "reference-build", "reference-sequence-digest"]
  }],
  "output_artifacts": [{
    "name": "alignment_quality_report", "artifact_type": "alignment_quality_report",
    "formats": [{"name": "samtools-flagstat-json", "versions": ["1.23"], "representations": ["structured", "text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["qc-strata-by-alignment-metric"]}],
    "processing_levels": ["derived"], "required_metadata": ["module_version", "compatibility_row_id", "sample-id", "reference-build"]
  }],
  "assumptions": ["The BAM header, declared sample identity, read groups, reference build, and reference sequence digest describe the same alignment payload."],
  "preconditions": ["The bundle contains one root alignment.bam plus alignment.bam.bai, and the BAM header declares coordinate sorting, reference sequences, and read groups consistent with project metadata."],
  "quality_gates": [
    {"id": "alignment-bundle-integrity", "severity": "fatal", "description": "BAM, index, header, read groups, sample identity, reference build, and reference digest must reconcile before interpretation.", "blocks_interpretation": true},
    {"id": "flagstat-count-conservation", "severity": "fatal", "description": "QC pass/fail strata, primary/secondary/supplementary classes, and paired read counts must be internally consistent.", "blocks_interpretation": true},
    {"id": "alignment-assay-context", "severity": "major", "description": "Mapping and pairing percentages require assay-, library-, and reference-specific thresholds; flagstat alone cannot establish biological adequacy.", "blocks_interpretation": true}
  ],
  "evidence_effects": ["qualifies_alignment_mechanics"],
  "alternatives": [],
  "complements": ["read-quality-fastqc", "read-quality-fastp", "read-contamination-screen"],
  "tool_requirements": [{
    "name": "samtools", "ecosystem": "system", "identity": "samtools", "required": true, "tested_versions": ["1.23"], "allowed_versions": [">=1.23,<1.24"],
    "version_source": "https://github.com/samtools/samtools/releases/tag/1.23", "verified_at": "2026-07-12", "version_probe": ["samtools", "--version"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10,
    "version_pattern": "samtools ([0-9]+(?:\\.[0-9]+)+)", "mismatch_policy": "block",
    "version_differences": [{"id": "samtools-123-flagstat-json", "affected_versions": [">=1.23,<1.24"], "category": "output-format", "description": "The validated release emits the tested JSON QC strata and metric field names.", "compatibility_effect": "requires-parser", "required_action": "Use the samtools 1.23 flagstat JSON parser and exact regression fixture.", "source": "https://www.htslib.org/doc/samtools-flagstat.html"}],
    "platforms": ["macos-arm64"]
  }],
  "dependencies": [{
    "name": "htslib", "ecosystem": "runtime", "identity": "htslib-runtime", "required": true, "tested_versions": ["1.23"], "allowed_versions": [">=1.23,<1.24"],
    "version_source": "https://github.com/samtools/htslib/releases/tag/1.23", "verified_at": "2026-07-12", "version_probe": ["samtools", "--version"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10,
    "version_pattern": "Using htslib ([0-9]+(?:\\.[0-9]+)+)", "purpose": "Decode BAM records and alignment flags for samtools flagstat.", "conflicts": [], "platforms": ["macos-arm64"]
  }],
  "compatibility_matrix": [{
    "id": "samtools-1.23-htslib-1.23-bam-1.6-flagstat-json", "module_version": "1.0.0", "tool_versions": {"samtools": [">=1.23,<1.24"]}, "dependency_versions": {"htslib": [">=1.23,<1.24"]},
    "input_formats": {"alignments": ["bam@1.6"]}, "output_formats": {"alignment_quality_report": ["samtools-flagstat-json@1.23"]}, "platforms": ["macos-arm64"],
    "regression_evidence_ids": ["alignment-quality-samtools-regression-v1"], "end_to_end_evidence_ids": ["alignment-quality-samtools-e2e-v1"], "verified_at": "2026-07-12"
  }],
  "execution": {"kind": "command", "timeout_seconds": 120, "max_output_bytes": 1000000, "command": {
    "tool_name": "samtools", "executable": "samtools", "arguments": ["flagstat", "--threads", "{parameter:threads}", "--output-fmt", "json", "{input:alignments}"],
    "inputs": [{"name": "alignments", "port": "alignments", "role": "alignments", "filename": "alignment-bundle", "materialization": "zip-directory", "member": "alignment.bam"}],
    "outputs": [{"name": "report", "port": "alignment_quality_report", "role": "report", "filename": "flagstat.json", "media_type": "application/json", "capture": "stdout"}],
    "parameter_names": ["threads"], "timeout_seconds": 120, "max_output_bytes": 1000000, "max_payload_bytes": 1000000, "working_directory_input": "alignments"
  }},
  "access": "offline", "mutability": "read_only", "credentials": [],
  "limitations": ["The validated row covers coordinate-sorted BAM 1.6 with BAI on macOS arm64; flagstat does not assess coverage uniformity, reference suitability, contamination outside tested references, expression quantification, peak quality, or biological validity."],
  "kernel_compatibility": [">=0.2.0,<0.3.0"],
  "provenance": {"license": "MIT", "concept_sources": ["https://github.com/samtools/samtools"]}
}
