{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not fabricate, infer, or silently convert spliced and unspliced counts from total expression.",
      "Do not use experimental time, desired lineage, annotations, markers, conditions, or conclusions to select genes or tune the model.",
      "Do not infer direction from UMAP layout, arrows, root choice alone, or one pseudotime correlation.",
      "Do not overwrite source layers, h5ad objects, cells, genes, samples, anchors, or provenance.",
      "Do not treat cells as condition-level replicates or velocity as proof of lineage causality.",
      "Do not report generated code, an unreloaded object, or a blocked direction as validated trajectory evidence."
    ],
    "languages": [
      "python",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "spliced counts",
          "unspliced counts",
          "gene detection",
          "kinetic fit",
          "cell count"
        ],
        "id": "velocity-gene-foundation",
        "parameter": "hvg-modeled-gene-and-fit-thresholds",
        "selection_rule": "Declare minimum HVG, finite-fit, and velocity-gene counts before model results.",
        "validation_rule": "Do not cherry-pick genes by agreement with desired direction."
      },
      {
        "decision_inputs": [
          "cell count",
          "state continuity",
          "rare states",
          "batch design"
        ],
        "id": "velocity-neighborhood",
        "parameter": "pca-and-neighbors",
        "selection_rule": "Choose a stable local neighborhood before velocity graph construction.",
        "validation_rule": "Repeat justified neighboring values and block unstable direction."
      },
      {
        "decision_inputs": [
          "experimental time",
          "root evidence",
          "terminal evidence",
          "sampling density"
        ],
        "id": "velocity-direction",
        "parameter": "time-correlation-and-anchor-separation",
        "selection_rule": "Predeclare temporal correlations and normalized root-terminal separation required for direction.",
        "validation_rule": "Withhold experimental time from fitting and block direction when independent checks fail."
      },
      {
        "decision_inputs": [
          "velocity coherence",
          "transition confidence",
          "state coverage"
        ],
        "id": "velocity-confidence",
        "parameter": "minimum-median-confidence",
        "selection_rule": "Declare a confidence floor separately from temporal direction.",
        "validation_rule": "An attractive UMAP vector field cannot substitute for confidence or time validation."
      }
    ],
    "postflight_checks": [
      "Inspect modeled genes, finite fits, velocity layers, graph, pseudotime, latent time, confidence, and warnings.",
      "Recompute time correlations and root-terminal separation independently from fields withheld during fitting.",
      "Reconcile all source cells, genes, samples, anchors, spliced and unspliced counts, derived fields, parameters, versions, and digests after reload.",
      "Keep cell-level trajectory interpretation separate from donor-level condition inference and from causal lineage claims."
    ],
    "preflight_checks": [
      "Inspect real spliced/unspliced counts, quantification provenance, sample design, time, roots, terminals, batches, states, feature namespace, and source object.",
      "Detect scVelo, Scanpy, AnnData, NumPy, pandas, SciPy, scikit-learn, Numba, UMAP, and Python versions in the existing scientific environment.",
      "Verify unique identifiers, layer alignment, integer-like counts, multiple samples, time coverage, nonoverlapping anchors, source immutability, and new output paths.",
      "Freeze normalization, HVG, PCA, neighbors, dynamics iterations, seed, direction and confidence thresholds, and reload checks."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
      "input-h5ad-sha256",
      "spliced-layer",
      "unspliced-layer",
      "quantification-provenance",
      "sample-key",
      "experimental-time-key",
      "root-score-key",
      "terminal-score-key",
      "actual-tool-versions",
      "actual-dependency-versions",
      "preprocessing-parameters",
      "dynamics-parameters",
      "random-seed",
      "modeled-genes",
      "time-correlations",
      "root-terminal-separation",
      "velocity-confidence",
      "output-h5ad-sha256",
      "quality-gate-results"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "inspect-splicing-temporal-design",
        "output_artifact_types": [
          "single_cell_trajectory_validation"
        ],
        "purpose": "Establish whether velocity and directional trajectory inference are identifiable.",
        "required_logic": [
          "Inspect real spliced and unspliced layers, quantification provenance, cells, genes, samples, time, root and terminal evidence, batches, cell states, and source digest.",
          "Block missing or non-count layers, one-sample designs, ambiguous anchors, inadequate temporal coverage, and guessed direction.",
          "Freeze preprocessing, model, genes, neighbors, anchors, direction thresholds, confidence thresholds, and outputs before execution."
        ],
        "template_files": [
          "templates/run_velocity.py"
        ]
      },
      {
        "id": "fit-dynamical-velocity",
        "output_artifact_types": [
          "single_cell_trajectory_object",
          "single_cell_trajectory_validation"
        ],
        "purpose": "Execute the detected scVelo dynamical API without modifying source counts.",
        "required_logic": [
          "Normalize working copies, select HVGs, compute PCA, neighbors, moments, dynamics, velocity, graph, UMAP vectors, velocity pseudotime, latent time, and confidence using version-correct calls.",
          "Keep experimental time out of model fitting and use only declared root and terminal scores for orientation.",
          "Retain failed fit genes and warnings rather than selecting genes from desired temporal behavior."
        ],
        "template_files": [
          "templates/run_velocity.py"
        ]
      },
      {
        "id": "validate-direction-confidence",
        "output_artifact_types": [
          "single_cell_trajectory_validation"
        ],
        "purpose": "Test whether the inferred direction is independently supported.",
        "required_logic": [
          "Compute Spearman correlations of latent time and velocity pseudotime with withheld experimental time.",
          "Require root cells to precede terminal cells and median velocity confidence to pass predeclared thresholds.",
          "Block temporal interpretation when any direction or confidence gate fails even if the embedding arrows appear coherent."
        ],
        "template_files": [
          "templates/run_velocity.py"
        ]
      },
      {
        "id": "merge-reload-and-admit",
        "output_artifact_types": [
          "single_cell_trajectory_object",
          "single_cell_trajectory_validation"
        ],
        "purpose": "Write derived trajectory fields to a new full-feature h5ad and verify source preservation.",
        "required_logic": [
          "Merge velocity layers, graph, UMAP vectors, pseudotimes, confidence, fit fields, parameters, and quality status into a copy of the full source object.",
          "Reload cells, genes, spliced and unspliced counts, sample and anchor fields, trajectory fields, graph, versions, thresholds, and digest.",
          "Admit only observed direction-validated outputs and keep blocked runs as non-evidentiary model history."
        ],
        "template_files": [
          "templates/run_velocity.py"
        ]
      }
    ]
  },
