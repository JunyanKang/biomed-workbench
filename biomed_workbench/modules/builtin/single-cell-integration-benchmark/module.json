      "artifact_type": "single_cell_expression",
      "processing_levels": ["quality-controlled", "raw-count-preserved", "batch-annotated"],
      "required_metadata": ["sample-key", "batch-key", "reviewed-label-key", "raw-count-location", "feature-namespace", "source-digest"],
      "source_policy": "project_or_upstream",
