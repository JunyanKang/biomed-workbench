{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Do not install dependencies inside an analysis run, score UMAP appearance, tune against desired labels, repair confounding computationally, overwrite raw counts, or use integrated values for confirmatory differential inference."
    ],
    "languages": [
      "python",
      "r"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "platform similarity",
          "cell-type overlap",
          "cell count",
          "batch strength"
        ],
        "id": "seurat-method-settings",
        "parameter": "features-dimensions-anchor-and-mnn-settings",
        "selection_rule": "Freeze shared preprocessing and method-native parameters before inspecting integrated labels.",
        "validation_rule": "Require raw-count preservation, reload, scIB mixing and conservation gates for each method."
      },
      {
        "decision_inputs": [
          "system effect strength",
          "shared HVGs",
          "sample nesting",
          "GPU availability"
        ],
        "id": "sysvi-settings",
        "parameter": "system-covariates-cycle-weight-prior-components",
        "selection_rule": "Use sysVI only for predeclared strong system effects and evaluate multiple cycle weights and seeds.",
        "validation_rule": "Block any model that erases labels, species-specific populations or within-label biology."
      }
    ],
    "postflight_checks": [
      "Reload all objects and reconcile cells, features, raw counts, reductions, parameters, versions and digests.",
      "Report complete scIB metrics, N/A reasons, sensitivity and failed gates."
    ],
    "preflight_checks": [
      "Inspect count semantics, sample-to-batch nesting, target biology, unknown labels, feature namespace and runtime versions.",
      "Reject perfect confounding and label leakage before generating code."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
      "input-digests",
      "method-and-version",
      "parameters",
      "seed",
      "runtime",
      "output-digests",
      "quality-gates"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "design-and-native-backends",
        "output_artifact_types": [
          "integration_benchmark_evidence"
        ],
        "purpose": "Validate the crossed design and execute every requested native backend from one frozen foundation.",
        "required_logic": [
          "Prove raw-count, cell, feature, sample and batch identity before fitting.",
          "Remove reviewed labels from unsupervised backends and retain unknown cells.",
          "Run CCA, RPCA, FastMNN or sysVI separately with exact parameters and seeds."
        ],
        "template_files": [
          "templates/run_seurat_v5_integration.R",
          "templates/run_sysvi.py"
        ]
      },
      {
        "id": "metric-adjudication",
        "output_artifact_types": [
          "integration_benchmark_evidence"
        ],
        "purpose": "Score mixing and conservation without UMAP-based selection.",
        "required_logic": [
          "Run the complete official scIB metric family and record explicit not-applicable reasons.",
          "Compare every candidate against the unchanged baseline and reject overcorrection.",
          "Keep all native outputs and one reviewable method decision table."
        ],
        "template_files": [
          "templates/score_scib.py"
        ]
      }
    ]
  },
  "alternatives": [
    "single-cell-batch-integration",
    "single-cell-generative-modeling"
  ],
  "assumptions": [
    "Integrated embeddings support neighborhood, visualization and annotation tasks but do not become expression measurements; sysVI receives normalized log-transformed shared HVGs as required by its official workflow."
  ],
  "code_templates": [
    {
      "language": "r",
      "path": "templates/run_seurat_v5_integration.R",
