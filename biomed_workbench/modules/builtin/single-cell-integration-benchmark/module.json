      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "CCA, RPCA and FastMNN must use the same frozen counts, features, PCA policy, cells, parameters and seeds, and retain method-native reductions separately.",
      "id": "same-foundation-multi-method",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Report batch ASW, graph connectivity, iLISI, kBET, PCR, ARI, NMI, cLISI, label ASW, isolated-label, HVG, cell-cycle and trajectory families or a data-derived not-applicable reason; block biological erasure.",
      "id": "complete-scib-and-conservation",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Forbid integrated, corrected, denoised, imputed or latent values for confirmatory differential inference; require raw-count sample-aware analysis.",
      "id": "count-level-inference-boundary",
      "severity": "fatal"
    }
  ],
