        {"name": "seurat-rds", "versions": ["5"], "representations": ["binary", "container"], "compression": ["internal"], "required_indexes": ["cell-id", "feature-id"], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["declared-in-project"], "orientations": ["cell-by-feature"]}
      ]
    }
  ],
  "output_artifacts": [
    {
