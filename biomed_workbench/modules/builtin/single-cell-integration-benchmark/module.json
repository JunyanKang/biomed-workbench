      "artifact_type": "integration_benchmark_evidence",
      "processing_levels": ["method-native", "metric-scored", "gate-adjudicated", "reloaded"],
      "required_metadata": ["method", "version", "parameters", "seed", "input-digests", "scib-metrics", "quality-gates", "output-digests"],
      "source_policy": "upstream_required",
      "formats": [
        {"name": "h5ad", "versions": ["0.1.0"], "representations": ["binary", "sparse"], "compression": ["internal"], "required_indexes": ["observation-id", "feature-id"], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["inherited-from-input"], "orientations": ["cell-by-gene-with-integrated-embedding"]},
        {"name": "seurat-rds", "versions": ["5"], "representations": ["binary", "container"], "compression": ["internal"], "required_indexes": ["cell-id", "feature-id"], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["inherited-from-input"], "orientations": ["cell-by-feature-with-reductions"]},
        {"name": "inline-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["method-by-metric-and-gate"]}
      ]
    }
  ],
  "preconditions": ["Raw counts and cell identities are immutable; sample, batch and reviewed labels are explicit; target biology is not perfectly confounded with batch; labels are excluded from unsupervised fitting."],
  "assumptions": ["Integrated embeddings support neighborhood, visualization and annotation tasks but do not become expression measurements; sysVI receives normalized log-transformed shared HVGs as required by its official workflow."],
  "quality_gates": [
    {"id": "crossed-design-and-label-isolation", "severity": "fatal", "description": "Reject ambiguous sample nesting, perfect technical-biological confounding, missing raw counts, label leakage or absent unknown cells.", "blocks_interpretation": true},
    {"id": "same-foundation-multi-method", "severity": "fatal", "description": "CCA, RPCA and FastMNN must use the same frozen counts, features, PCA policy, cells, parameters and seeds, and retain method-native reductions separately.", "blocks_interpretation": true},
    {"id": "complete-scib-and-conservation", "severity": "fatal", "description": "Report batch ASW, graph connectivity, iLISI, kBET, PCR, ARI, NMI, cLISI, label ASW, isolated-label, HVG, cell-cycle and trajectory families or a data-derived not-applicable reason; block biological erasure.", "blocks_interpretation": true},
    {"id": "count-level-inference-boundary", "severity": "fatal", "description": "Forbid integrated, corrected, denoised, imputed or latent values for confirmatory differential inference; require raw-count sample-aware analysis.", "blocks_interpretation": true}
  ],
  "limitations": ["sysVI is an emerging candidate backed by official scvi-tools documentation and a preprint rather than a default winner. scIB metrics quantify declared properties but cannot rescue a confounded design. Method choice remains dataset-specific."],
  "evidence_effects": ["adds-seurat-v5-cca-rpca-fastmnn-sysvi-and-complete-scib-evidence"],
  "alternatives": ["single-cell-batch-integration", "single-cell-generative-modeling"],
