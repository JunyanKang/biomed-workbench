  "version": "1.0.0",
  "title": "Single-cell integration benchmark",
  "description": "Execute Seurat v5 CCA, RPCA and FastMNN from one count-preserving foundation, evaluate strong-system sysVI only as a candidate, compute the complete official scIB metric families with explicit not-applicable reasons, and admit no integration that improves mixing by erasing reviewed biology.",
  "module_type": "analysis",
  "domains": ["omics", "statistics"],
  "intents": ["batch integration benchmark", "batch-correct", "Seurat v5 integration", "scIB benchmark", "sysVI integration"],
  "questions": ["Which batch integration is admissible for this crossed design?", "Does integration improve mixing while preserving biological states?", "Are all scIB metric families reported or explicitly not applicable?"],
  "entrypoint": "agent-generated-analysis",
  "execution": {"kind": "workflow", "timeout_seconds": 30, "max_output_bytes": 2000000},
  "maturity": "validated",
  "input_artifacts": [
    {
