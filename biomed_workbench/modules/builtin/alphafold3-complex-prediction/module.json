{
  "schema_version": 1,
  "id": "alphafold3-complex-prediction",
  "version": "1.2.0",
  "title": "Prepare, run and review AlphaFold 3 biomolecular-complex predictions",
  "description": "Prepare official AlphaFold Server packages for manual Google-authenticated submission, stream and verify observed Server ZIP archives without expanding large MSA or template payloads, read local AlphaFold 3 results, enforce origin-specific reuse terms, audit ranked structures and confidence outputs, and export R-rendered publication figures with replot tables. An optional local official runtime is gated by current host headroom and explicit user permission.",
  "module_type": "analysis",
  "domains": [
    "molecular_design"
  ],
  "intents": [
    "AlphaFold 3 complex prediction",
    "protein ligand structure prediction",
    "AlphaFold3蛋白复合物结构预测"
  ],
  "questions": [
    "Which AlphaFold 3 complex samples and chain-pair hypotheses remain interpretable after identity, license, confidence, clash and output-integrity review?"
  ],
  "entrypoint": "agent-generated-analysis",
  "execution": {
    "kind": "workflow",
    "timeout_seconds": 30,
    "max_output_bytes": 3000000
  },
  "maturity": "validated",
