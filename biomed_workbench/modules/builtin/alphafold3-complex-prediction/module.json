  "preconditions": [
    "For AlphaFold Server, Codex confirms non-commercial eligibility, current terms, interactive Google-account access, immutable entity identities, and manual user review before submission. Local inference additionally requires approved weights, complete versioned databases, a compatible Linux NVIDIA host, at least half of current resource headroom remaining unused, and explicit user permission."
  ],
  "assumptions": [
    "Every sequence, chain ID, modification, CCD ligand, SMILES ligand, covalent context and model seed describes the intended molecular system."
  ],
  "quality_gates": [
    {
      "id": "af3-input-identity",
      "severity": "fatal",
      "description": "Require unique chain IDs, bounded valid sequences, explicit ligand identity and a closed official AlphaFold 3 input dialect.",
      "blocks_interpretation": true
    },
    {
      "id": "af3-license-runtime",
      "severity": "fatal",
      "description": "Record the current code, model-weight and output terms plus runtime, database and weight provenance before inference.",
      "blocks_interpretation": true
    },
    {
      "id": "af3-output-confidence",
      "severity": "fatal",
      "description": "Reconcile all seeds and samples, ranking scores, pTM, ipTM, chain and chain-pair confidence, clashes, mmCIF models and documented confidence files.",
      "blocks_interpretation": true
    },
    {
      "id": "af3-publication-figures",
      "severity": "major",
      "description": "Export confidence and structural figure panels as PDF, SVG and 600-dpi PNG with source tables, labels, legends and model-confidence semantics.",
      "blocks_interpretation": true
    }
  ],
  "limitations": [
    "AlphaFold Server submission is manual because the official service uses interactive Google sign-in and documents no public submission API; the workbench stores no password, token, cookie or browser session.",
    "Server outputs are non-commercial and must not be connected to automated ligand or peptide binding or interaction prediction systems; origin-specific handoffs enforce this restriction.",
    "The repository does not bundle AlphaFold 3 model weights or reference databases and cannot grant rights beyond current terms.",
    "AlphaFold 3 outputs are theoretical predictions and do not establish binding, affinity, kinetics, function, mechanism or clinical validity."
  ],
  "evidence_effects": [
    "produces-biomolecular-complex-structure-hypotheses",
    "produces-confidence-aware-structure-figures",
    "blocks-prediction-as-experimental-proof"
  ],
  "alternatives": [
    "protein-complex-docking",
    "alphafold-structure-evidence"
  ],
  "complements": [
    "structure-quality-assessment",
    "structure-chain-comparison",
    "structure-interactive-visualization",
    "protein-interaction-network-evidence"
  ],
