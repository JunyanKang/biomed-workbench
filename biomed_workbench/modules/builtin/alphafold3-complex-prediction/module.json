  "agent_protocol": {
    "schema_version": 1,
    "mode": "packaged_parameterized_workflow",
    "languages": [
      "python",
      "r"
    ],
    "template_sections": [
      {
        "id": "prepare-run-review-alphafold3",
        "purpose": "Prepare an official Server submission package, import complete Server or local outputs, optionally connect an approved local runtime, and render confidence-aware figures.",
        "required_logic": [
          "Use AlphaFold Server as the default route; require interactive Google sign-in, current terms review and manual submission; record access errors as actionable states; tag imported output origin; prohibit docking handoff for Server outputs; execute locally only after the half-headroom resource gate and explicit permission."
        ],
        "output_artifact_types": [
          "structure_prediction_bundle",
          "structure_figure_bundle"
        ],
        "template_files": [
          "templates/run_alphafold3_complex_prediction.py",
          "templates/render_alphafold3_publication_figures.R"
        ]
      }
    ],
    "parameter_rules": [
      {
        "id": "select-af3-execution-mode",
        "parameter": "server-package-import-or-local",
        "decision_inputs": [
          "license-eligibility",
          "interactive-access-state",
          "molecular-system",
          "existing-output",
          "host-headroom",
          "user-permission"
        ],
        "selection_rule": "Default to a manually submitted AlphaFold Server package and result import. Use local inference only when current Linux/NVIDIA, CPU, available-memory, free-disk and free-GPU headroom leaves at least 50 percent unused and the user explicitly authorizes deployment or execution.",
        "validation_rule": "Block submission, execution or interpretation when terms, access state, molecular identity, runtime provenance, output origin, confidence files or chain-pair scope are unresolved."
      }
    ],
    "preflight_checks": [
      "Verify current Server and output terms, non-commercial eligibility, privacy implications, interactive Google-account status, entity identity, copy counts, seeds, modifications and ligand representation. For local execution, additionally verify approved weights, complete databases, current available resources and explicit user permission."
    ],
    "postflight_checks": [
      "Reconcile every seed and sample, reload ranking and confidence files, verify mmCIF and figure exports, bind every digest, preserve terms notices, and apply output-origin reuse restrictions."
    ],
    "provenance_fields": [
      "module-version",
      "alphafold-version",
      "output-origin",
      "terms-reviewed-at",
      "database-versions",
      "entity-identities",
      "input-output-digests",
      "confidence-semantics",
      "figure-style-version",
      "host-resource-gate"
    ],
    "forbidden_actions": [
      "Do not ask the user to paste a Google password into a project file or store a password, OAuth token, browser cookie or recovery secret.",
      "Do not automate the public AlphaFold Server through an undocumented interface.",
      "Do not pass AlphaFold Server outputs or derivatives to automated ligand or peptide docking or interaction-prediction systems.",
      "Do not deploy or execute local AlphaFold 3 without the half-headroom resource gate and explicit user permission.",
      "Do not bundle or redistribute AlphaFold 3 weights or imply rights beyond current terms.",
      "Do not treat pTM, ipTM, ranking score or a rendered complex as binding or functional proof."
    ],
    "requires_observed_execution": true
  }
