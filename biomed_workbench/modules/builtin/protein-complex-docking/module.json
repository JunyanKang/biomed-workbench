{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Do not treat a docking score, model rank, predicted affinity or attractive figure as experimental interaction evidence.",
      "Do not silently remove non-standard residues, change chain mappings or increase allowed sequence mismatches.",
      "Do not run the official-test sampling profile as a research-grade production analysis."
    ],
    "languages": [
      "python"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "scientific-purpose",
          "restraint-evidence",
          "complex-size",
          "reference-availability"
        ],
        "id": "select-complex-docking-profile",
        "parameter": "sampling-and-restraints",
        "selection_rule": "Use the small official-test profile only for integration checks and the declared production profile for research sampling.",
        "validation_rule": "Block production interpretation when sampling, restraints, identity, preparation, clustering or reference mapping is unresolved."
      }
    ],
    "postflight_checks": [
      "Reload CAPRI, DockQ and PRODIGY outputs; reconcile every model; reload PDF, SVG and PNG exports; verify all digests."
    ],
    "preflight_checks": [
      "Resolve molecule identity, chain mapping, coordinate quality, non-standard residues, restraints, sampling profile and isolated tool environments."
    ],
    "provenance_fields": [
      "module-version",
      "compatibility-row-id",
      "tool-and-environment-versions",
      "input-and-output-digests",
      "parameters",
      "quality-gate-results",
      "figure-style-version"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "execute-complex-docking",
        "output_artifact_types": [
          "complex_docking_bundle"
        ],
        "purpose": "Run the packaged docking workflow in isolated validated environments.",
        "required_logic": [
          "Validate identities and preparation, freeze the sampling profile, execute HADDOCK3, and reconcile every ranked model."
        ],
        "template_files": [
          "templates/run_haddock3_complex_docking.py"
        ]
      },
      {
        "id": "render-complex-figures",
        "output_artifact_types": [
          "structure_figure_bundle"
        ],
        "purpose": "Render publication-ready structure and quality panels from admitted outputs.",
        "required_logic": [
          "Export vector and raster figures, editable scene instructions, interface tables, score tables and a digest-bound manifest."
        ],
        "template_files": [
          "templates/render_complex_publication_figures.py"
        ]
      }
    ]
  },
