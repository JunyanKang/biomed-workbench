  ],
  "preconditions": ["Codex can inspect immutable coordinate inputs, restraints, reference availability, and separate compatible HADDOCK3 and DockQ runtimes before execution."],
  "assumptions": ["Molecular identity, protonation and residue naming, chain mapping, restraint provenance, and coordinate units are declared and reviewed."],
  "quality_gates": [
    {"id": "complex-input-identity", "severity": "fatal", "description": "Require two or more parseable PDB inputs with explicit molecular identity, chain scope, coordinate units, and immutable digests.", "blocks_interpretation": true},
    {"id": "docking-sampling-profile", "severity": "fatal", "description": "Separate the official small integration test from the production profile and record every sampling, selection, restraint, seed, and clustering parameter.", "blocks_interpretation": true},
    {"id": "complex-result-accounting", "severity": "fatal", "description": "Reconcile every generated model, CAPRI table row, cluster, selected model, evaluation return code, and output digest.", "blocks_interpretation": true},
    {"id": "complex-score-semantics", "severity": "fatal", "description": "Keep HADDOCK score, DockQ reference agreement, and PRODIGY affinity estimation distinct from experimental interaction and binding evidence.", "blocks_interpretation": true},
    {"id": "structure-publication-figures", "severity": "major", "description": "Export PDF, SVG and 600-dpi PNG figures, editable scene instructions, interface contacts, score tables, legends, units, and a style-bound figure manifest.", "blocks_interpretation": true}
  ],
  "limitations": ["Docking generates structural hypotheses and does not establish interaction, affinity, kinetics, stoichiometry, cellular context, or mechanism.", "PRODIGY rejects unsupported non-standard residues unless the user applies a scientifically reviewed preparation step.", "HADDOCK3/PRODIGY and DockQ require isolated environments because their validated NumPy requirements conflict."],
