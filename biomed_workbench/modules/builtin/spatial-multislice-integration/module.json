  "agent_protocol": {
    "forbidden_actions": [
      "Use only project-approved isolated runtimes; do not mutate the host environment.",
      "Do not guess section order or spacing, force full overlap, interpret coupling as lineage, align independent samples as adjacent physical sections, treat cells/spots/sections as condition replicates, or omit convergence and alignment uncertainty."
    ],
    "languages": [
      "python",
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
