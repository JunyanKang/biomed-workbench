          "section modality",
          "common genes",
          "landmarks"
        ],
        "id": "alignment-backend",
        "parameter": "paste-paste2-image-registration",
        "selection_rule": "Use PASTE for broad adjacent overlap, PASTE2 for partial overlap, and image-based STalign/VALIS only when the declared image evidence supports it.",
        "validation_rule": "Compare pre/post overlays, correspondence error, deformation and partial-overlap sensitivity."
      },
      {
        "decision_inputs": [
          "condition",
          "biological sample",
          "section nesting",
          "domain",
          "covariates"
        ],
        "id": "hierarchical-model",
        "parameter": "fixed-random-effects",
        "selection_rule": "Treat sample as the experimental unit and section as nested within sample; predeclare condition-by-domain and nuisance effects.",
        "validation_rule": "Require replication, convergence, nonsingular fit, effect uncertainty and multiplicity control."
      }
    ],
    "postflight_checks": [
      "Reload aligned sections, couplings, xyz coordinates, model tables and reports; reconcile every observation and transform.",
      "Review order/overlap sensitivity, alignment diagnostics and biological-sample-level model validity."
    ],
    "preflight_checks": [
      "Inspect exact section order, spacing/unit, overlap, common genes, images/landmarks, samples, conditions and covariates.",
      "Detect exact isolated PASTE/PASTE2 or STalign/VALIS and R/lme4 versions."
