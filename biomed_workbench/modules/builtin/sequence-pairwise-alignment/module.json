    {
      "id": "pairwise-sequence-identity",
      "severity": "fatal",
      "description": "Block missing, empty, invalid, ambiguous, or alphabet-mismatched sequence inputs; preserve both declared input records.",
      "blocks_interpretation": true
    },
    {
      "id": "pairwise-scoring-contract",
      "severity": "fatal",
      "description": "Record and validate mode, every match/mismatch/gap score, Biopython version, and zero-based half-open coordinates before interpretation.",
      "blocks_interpretation": true
    },
    {
      "id": "pairwise-claim-boundary",
      "severity": "major",
      "description": "A two-sequence alignment alone cannot establish homology, orthology, genomic placement, variants, or function.",
      "blocks_interpretation": true
    }
  ],
