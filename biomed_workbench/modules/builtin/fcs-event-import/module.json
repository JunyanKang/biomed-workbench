    "required_metadata": ["module_version", "compatibility_row_id", "source_name", "fcs_version", "event_count", "channels"],
    "formats": [{"name": "inline-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["event-by-channel"]}]
  }],
