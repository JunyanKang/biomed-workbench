  "output_artifacts": [{"name": "ddr_hypothesis_network", "artifact_type": "statistical_hypothesis_network", "formats": [{"name": "inline-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["inherited-from-input"], "orientations": ["gene-pairs-by-statistical-evidence"]}], "processing_levels": ["derived"], "required_metadata": ["module_version", "compatibility_row_id", "sample-manifest-digest", "correlation-method", "multiplicity-method", "thresholds"]}],
