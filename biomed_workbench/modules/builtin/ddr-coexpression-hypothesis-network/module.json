  "module_type": "analysis",
  "domains": ["omics", "statistics"],
  "intents": ["DDR coexpression network", "DNA damage response network", "mutation informed coexpression hypotheses", "DNA损伤修复共表达假设网络"],
  "questions": ["Which FDR-controlled coexpression relationships involving declared DDR genes merit independent functional perturbation, without claiming synthetic lethality from correlation alone?"],
  "maturity": "validated",
  "entrypoint": "biomed_workbench.capabilities.omics:ddr_coexpression_hypothesis_network",
  "execution": {"kind": "python", "timeout_seconds": 60, "max_output_bytes": 20000000},
