  "preconditions": [
    "Fragments have valid five-column 10x FRAG semantics and declared genome build; paired ATAC and RNA matrices contain identical unique cells in identical order; peak coordinates, sequences, genes, motifs, and source count locations are explicit; output paths are new."
  ],
