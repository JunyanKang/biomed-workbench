  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "Every fragment record, count, and selected barcode must be structurally valid and reconciled before peak calling.",
      "id": "atac-fragment-accounting",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "MACS3 narrowPeak and summit outputs must be nonempty, coordinate-valid, reloaded, and bound to source and parameter digests.",
      "id": "atac-peak-coordinate-reload",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Recalled peaks must use declared sample or predeclared-group pseudobulks, reproducibility or union and blacklist/width filters, a frozen common peak set, exact FeatureMatrix cell order, a distinct preserved assay, and rerun LSI/WNN diagnostics.",
      "id": "atac-recalled-peak-matrix",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "RNA and ATAC cells, source counts, feature identifiers, and metadata order must be exact and unchanged.",
      "id": "atac-paired-cell-and-count-preservation",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Peak sequences and motif identities must be explicit; chromVAR backgrounds must be reproducible and matched on GC and accessibility rather than sampled without control.",
      "id": "atac-motif-and-background-contract",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Motif matches, chromVAR deviations, and peak-to-gene associations must remain method-specific evidence and cannot be collapsed into causal claims.",
      "id": "atac-regulatory-method-separation",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Reload and reconcile peak, motif, background, deviation, link, version, parameter, and digest outputs before admission.",
      "id": "atac-output-reload",
      "severity": "fatal"
    }
  ],
  "questions": [
    "Which accessible regions, motif deviations, and RNA-linked peaks are supported by validated single-cell ATAC and paired RNA evidence?"
  ],
