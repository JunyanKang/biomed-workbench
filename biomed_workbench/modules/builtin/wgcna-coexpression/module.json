    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not use cells or technical runs as independent samples, choose features or parameters after trait significance, silently remove outliers, force a module, call spatial layout a metric, or describe coexpression as physical interaction or causality."
    ],
    "languages": [
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
