        "parameter": "correlation-network-power",
        "selection_rule": "Choose Pearson or bicor and signed, signed-hybrid or unsigned semantics before trait results; select a predeclared power or the lowest candidate meeting the declared topology criterion while retaining connectivity.",
        "validation_rule": "Retain all candidate-power plots, selected-power rationale, exact network/TOM types and sensitivity near the selection."
      },
      {
        "decision_inputs": [
          "feature count",
          "sample count",
          "module sizes",
          "dendrogram",
          "resampling or cohort availability"
        ],
