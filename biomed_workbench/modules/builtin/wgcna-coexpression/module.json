        "parameter": "module-detection-and-stability",
        "selection_rule": "Declare deepSplit, minimum module size, merge height, block size, PAM rule and seed before module-trait review and define resampling, consensus or preservation analysis for consequential claims.",
        "validation_rule": "Report grey genes, module sizes, eigengenes, BH-adjusted trait associations and stability state; do not call unstable hubs."
      }
    ],
    "postflight_checks": [
      "Reload threshold diagnostics, membership, eigengene and module-trait tables and all figures; verify sample order, parameter record, seed, p-value bounds, adjustment and digests."
    ],
