    {
      "blocks_interpretation": true,
      "description": "Block matrices with inadequate independent samples, ambiguous normalization, duplicated technical replicates, unresolved missingness/outliers, bad samples or genes, or mismatched sample order.",
      "id": "wgcna-input-eligibility",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require declared correlation and network type, full candidate-power diagnostics, an explicit power selection rule, deterministic seed, module parameters, eigengene construction, trait encoding and BH-adjusted module-trait results.",
      "id": "wgcna-network-parameters",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Treat modules and hubs as coexpression evidence; consequential module preservation or hub claims require resampling, consensus, or an independent cohort and never imply physical interaction or causality.",
      "id": "wgcna-stability-claim",
      "severity": "major"
    }
  ],
