{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Do not treat cells as independent condition-level replicates.",
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not guess raw counts, species, gene namespaces, cell types, samples, conditions, or resource versions.",
      "Do not infer physical contact or causal signaling from ligand-receptor expression alone.",
      "Do not use cell-level differential expression as NicheNet receiver evidence when biological samples define the contrast.",
      "Do not overwrite source objects or previous outputs, and do not hide failed samples, methods, or interactions."
    ],
    "languages": [
      "python",
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "species",
          "question",
          "sample-counts",
          "resource-availability",
          "receiver-contrast",
          "tool-compatibility"
        ],
        "id": "select-communication-methods",
        "parameter": "requested-methods",
        "selection_rule": "Select only methods whose input, species, resource, design, and version assumptions are met; use multiple methods when their distinct score semantics answer the question.",
        "validation_rule": "Every selected method must execute on observed sample data and retain method-specific results; unavailable or incompatible methods are blocked with reasons rather than simulated."
      },
      {
        "decision_inputs": [
          "cells-per-type-per-sample",
          "samples-per-condition",
          "method-minimums",
          "predeclared-fdr"
        ],
        "id": "select-cell-and-sample-thresholds",
        "parameter": "minimum-support",
        "selection_rule": "Choose cell eligibility and sample reproducibility thresholds before viewing interaction rankings, respecting method requirements and the independent replicate design.",
        "validation_rule": "Condition-level interpretation requires the declared independent-sample support and multiplicity control; otherwise results remain sample-specific or descriptive."
      },
      {
        "decision_inputs": [
          "reviewed-receiver-label",
          "condition-design",
          "donor-aware-de",
          "background-genes",
          "network-release"
        ],
        "id": "select-nichenet-contrast",
        "parameter": "receiver-contrast",
        "selection_rule": "Define receiver, reference, contrast, donor-aware DE model, background genes, and network resources from the project hypothesis before ligand ranking.",
        "validation_rule": "Block NicheNet when receiver DE is cell-level, sample counts are inadequate, resources are unpinned, or ligand and target universes cannot be reconciled."
      }
    ],
    "postflight_checks": [
      "Reconcile all input cells, genes, samples, conditions, eligible and blocked populations, and sample runs.",
      "Validate recognized method output fields, finite scores, p-value or rank semantics, and standardized interaction identities.",
      "Require cross-sample support and multiplicity control for replicated interactions and donor-aware receiver evidence for NicheNet.",
      "Reload all tables, reports, and objects and verify source preservation, versions, resources, parameters, quality states, and artifact digests."
    ],
    "preflight_checks": [
      "Inspect the real h5ad or Matrix Market bundle and identify immutable integer-like raw counts without relying on a conventional layer name.",
      "Cross-tabulate cell types, unknowns, samples, conditions, and batches and verify one condition per biological sample.",
      "Reconcile gene identifiers and species with every selected resource and record resource release and digest.",
      "Confirm requested tool APIs in the existing environment and freeze sample, method, permutation, threshold, and output contracts."
    ],
    "provenance_fields": [
      "module-version",
      "source-artifact-digest",
      "cell-and-gene-counts",
      "cell-type-key",
      "biological-sample-key",
      "condition-key",
      "species",
      "raw-count-location",
      "gene-identifier-namespace",
      "annotation-release",
      "quantification-provenance",
      "methods-and-parameters",
      "tool-versions",
      "resource-releases-and-digests",
      "sample-run-accounting",
      "blocked-reasons",
      "replicate-thresholds",
      "quality-gate-results",
      "output-artifact-digests"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "inspect-communication-design",
        "output_artifact_types": [
          "single_cell_communication_validation"
        ],
        "purpose": "Establish whether communication and ligand-activity questions are identifiable from the real project design.",
        "required_logic": [
          "Inspect immutable raw counts, gene identifiers, species, cell types, unknown labels, samples, conditions, batches, quantification provenance, source digest, and resource releases.",
          "Count every cell type within every biological sample and block sample runs with fewer than two adequately represented populations.",
          "Freeze methods, resources, normalization, expression proportions, permutations, minimum cells, minimum sample support, multiple-testing control, contrasts, and outputs before execution."
        ],
        "template_files": [
          "templates/run_liana_cellphonedb.py",
          "templates/run_cellchat_nichenet.R"
        ]
      },
      {
        "id": "execute-ligand-receptor-methods",
        "output_artifact_types": [
          "single_cell_communication_evidence",
          "single_cell_communication_validation"
        ],
        "purpose": "Run selected communication methods within each biological sample and retain method-native evidence.",
        "required_logic": [
          "Adapt LIANA, CellPhoneDB, and CellChat templates to detected APIs and run each eligible biological sample independently with fixed seeds and explicit resources.",
          "Preserve raw method tables and standardize sender, receiver, ligand, receptor, score, significance, sample, condition, and method without equating unlike score semantics.",
          "Keep unknown cell labels if sufficiently represented and never select interactions from a desired condition pattern or visualization."
        ],
        "template_files": [
          "templates/run_liana_cellphonedb.py",
          "templates/run_cellchat_nichenet.R"
        ]
      },
      {
        "id": "execute-nichenet-ligand-activity",
        "output_artifact_types": [
          "single_cell_communication_evidence",
          "single_cell_communication_validation"
        ],
        "purpose": "Prioritize ligands against independent receiver-state evidence without cell-level pseudoreplication.",
        "required_logic": [
          "Require donor-aware receiver differential expression with explicit contrast, background genes, independent samples, and reviewed receiver identity.",
          "Load project-pinned ligand-target, ligand-receptor, and weighted network resources and record their digests and releases.",
          "Rank ligand activities and retain ligand-target links while distinguishing prior-network support from causal signaling evidence."
        ],
        "template_files": [
          "templates/run_cellchat_nichenet.R"
        ]
      },
      {
        "id": "replicate-reload-and-admit",
        "output_artifact_types": [
          "single_cell_communication_evidence",
          "single_cell_communication_validation"
        ],
        "purpose": "Admit only reloadable communication evidence with independent sample support and intact source data.",
        "required_logic": [
          "Summarize interaction support across biological samples within condition and control multiplicity without treating cells as replicates.",
          "Compare method support as complementary evidence while retaining method disagreement and score semantics.",
          "Reload tables, reports, and model objects; verify source dimensions and digests, parameters, versions, resources, sample runs, blocked reasons, and quality state before evidence admission."
        ],
        "template_files": [
          "templates/run_liana_cellphonedb.py",
          "templates/run_cellchat_nichenet.R"
        ]
      }
    ]
  },
  "alternatives": [],
  "assumptions": [
    "Cell types were established independently of the communication result; biological samples are independently prepared; each sample maps to one condition; raw counts and normalized expression semantics are known; gene identifiers match the declared species and resources; communication scores indicate compatible expression and prior knowledge rather than physical contact or causal signaling; and cells are not treated as condition-level replicates."
  ],
