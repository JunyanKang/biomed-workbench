  "preconditions": [
    "Codex can inspect immutable raw counts, gene identifiers, cell types including unknown labels, biological samples, conditions, species, quantification provenance, and the existing scientific environments; versioned interaction and ligand-target resources are locally available or explicitly fetched for the project; outputs are new; and no environment or compute-infrastructure management is required."
  ],
  "provenance": {
    "concept_sources": [
      "Project-owned Codex-native communication workflow synthesized from independently validated LIANA, CellPhoneDB, CellChat, and NicheNet APIs and biological-replicate requirements.",
      "https://liana-py.readthedocs.io/en/latest/",
      "https://cellphonedb.readthedocs.io/en/stable/",
      "https://github.com/jinworks/CellChat",
      "https://github.com/saeyslab/nichenetr"
    ],
    "license": "Apache-2.0"
  },
  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "Block when raw counts, gene identifiers, species, cell types, samples, conditions, quantification provenance, or versioned communication resources cannot be established without guessing.",
      "id": "communication-input-semantics",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require reason-coded cell-type eligibility within each biological sample, at least two eligible populations for a sample run, and independent sample counts for any condition-level statement.",
      "id": "communication-cell-sample-accounting",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require observed LIANA, CellPhoneDB, CellChat, or NicheNet execution with detected APIs, explicit parameters, fixed seeds, recognized result fields, and retained method-specific raw outputs.",
      "id": "communication-method-execution",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require predeclared cross-sample support and multiple-testing control for replicated interactions; single-sample results remain descriptive and cannot establish a condition effect.",
      "id": "communication-replicate-support",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "NicheNet ligand activity requires donor-aware receiver differential expression, an explicit background gene universe, sender expression, versioned ligand-receptor and ligand-target resources, and independent samples in both contrast levels.",
      "id": "communication-nichenet-receiver-evidence",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Source counts, cells, genes, labels, samples, and conditions remain immutable; outputs reload with parameters, versions, resources, sample runs, quality states, and artifact digests intact.",
      "id": "communication-source-output-integrity",
      "severity": "fatal"
    }
  ],
  "questions": [
    "Which sender-receiver ligand-receptor programs recur across independent biological samples and are supported by receiver-state evidence?"
  ],
