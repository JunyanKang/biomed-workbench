{
  "schema_version": 1,
  "id": "claim-evidence-integrity-audit",
  "version": "1.0.0",
  "title": "Audit claim provenance and evidence integrity",
  "description": "Reconcile declared and emitted claims with independently reviewed literature and experiment evidence, preserving unresolved retrieval, negative results, refutation, causal-design limits, and prespecified constraints.",
  "module_type": "validation",
  "domains": ["publication", "evidence", "research-quality"],
  "intents": [
    "audit claim evidence integrity before research delivery",
    "verify manuscript claims against reviewed citations and executed experiments",
    "核查论文主张与原文证据、实验结果和预设约束的一致性",
    "审计科研结论是否存在未读原文、未执行实验、因果升级或反证遗漏"
  ],
  "questions": [
    "Are emitted scientific claims within their declared scope and supported by independently reviewed, provenance-complete, design-appropriate literature or experiment evidence without ignored refutation or constraint violations?"
  ],
  "entrypoint": "biomed_workbench.capabilities.claim_integrity:audit_claim_evidence_integrity",
  "execution": {"kind": "python", "timeout_seconds": 30, "max_output_bytes": 10000000},
  "maturity": "validated",
  "input_artifacts": [
    {
      "name": "claim_evidence_bundle",
      "artifact_type": "claim_evidence_bundle",
      "formats": [{"name": "claim-evidence-bundle", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["request-object"]}],
      "processing_levels": ["independently-adjudicated"],
      "required_metadata": ["audit_id", "audit_version", "review_owner", "reviewed_at", "rules_independent_from_writer", "leakage_reviewed"]
    }
  ],
  "output_artifacts": [
    {
      "name": "claim_integrity_report",
      "artifact_type": "claim_integrity_report",
      "formats": [{"name": "claim-integrity-report", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["module-output"]}],
      "processing_levels": ["validated"],
      "required_metadata": ["module_version", "compatibility_row_id", "audit_version", "audit_digest"]
    }
  ],
  "preconditions": [
    "Semantic evidence relations and constraint verdicts have been recorded by a reviewer or deterministic result check independently of the writer being audited."
  ],
  "assumptions": [
    "Evidence IDs, independent-group assignments, source acquisition claims, experiment execution records, and adjudication rationales accurately describe the reviewed materials."
  ],
  "quality_gates": [
    {"id": "claim-source-content-review", "severity": "major", "description": "Citation identity or metadata resolution cannot establish claim support without original-source content review.", "blocks_interpretation": true},
    {"id": "claim-experiment-execution", "severity": "major", "description": "Fully skipped, unreviewed, or result-less experiments cannot support claims, and every skipped planned unit requires a reason.", "blocks_interpretation": true},
    {"id": "claim-refutation-priority", "severity": "major", "description": "Eligible refuting evidence and prespecified negative-constraint violations override concurrent support for release decisions.", "blocks_interpretation": true},
    {"id": "claim-causal-design", "severity": "major", "description": "Causal claims require eligible evidence from randomized, interventional, or controlled-perturbation designs.", "blocks_interpretation": true},
    {"id": "claim-audit-independence", "severity": "major", "description": "Audit rules must be independent of the writer and leakage must be reviewed.", "blocks_interpretation": true}
  ],
  "limitations": [
    "This deterministic reducer audits supplied adjudications; it does not itself read papers, inspect raw experiment files, infer semantic entailment, or prove reviewer independence."
  ],
  "evidence_effects": ["validates_claim_evidence_alignment", "detects_claim_scope_drift", "preserves_refuting_evidence", "limits_release_readiness_claim"],
  "alternatives": [],
  "complements": ["citation-resolution-adjudication", "classification-gold-set-evaluation", "research-contract-consistency-audit", "literature-evidence", "manuscript-audit", "reviewer-assessment", "response-matrix"],
  "tool_requirements": [],
  "dependencies": [
    {"name": "python", "ecosystem": "runtime", "identity": "python-runtime", "required": true, "tested_versions": ["3.14.3"], "allowed_versions": [">=3.14,<3.15"], "version_source": "https://www.python.org/downloads/release/python-3143/", "verified_at": "2026-07-13", "version_probe": ["biomed_workbench.modules.compatibility:probe_python_runtime"], "version_probe_kind": "python_callable", "version_probe_timeout_seconds": 5, "version_pattern": "([0-9]+(?:\\.[0-9]+)+)", "purpose": "Validate bounded claim, citation, experiment, provenance, and directional evidence records with deterministic release gates.", "conflicts": [], "platforms": ["any"]}
  ],
  "compatibility_matrix": [
    {"id": "python-3.14.3-claim-evidence-bundle-1", "module_version": "1.0.0", "tool_versions": {}, "dependency_versions": {"python": [">=3.14,<3.15"]}, "input_formats": {"claim_evidence_bundle": ["claim-evidence-bundle@1"]}, "output_formats": {"claim_integrity_report": ["claim-integrity-report@1"]}, "platforms": ["any"], "regression_evidence_ids": ["claim-evidence-integrity-audit-regression-v1"], "end_to_end_evidence_ids": ["claim-evidence-integrity-audit-e2e-v1"], "verified_at": "2026-07-13"}
