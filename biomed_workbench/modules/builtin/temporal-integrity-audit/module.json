{
  "schema_version": 1,
  "id": "temporal-integrity-audit",
  "version": "1.0.0",
  "title": "Audit temporal integrity of scientific assertions",
  "description": "Verify source effective ranges, event chronology, version comparators, causal ordering, date precision, provenance confidence, supersession chains, and publication-safe temporal language from explicit research facts.",
  "module_type": "validation",
  "domains": ["publication", "evidence", "research-quality"],
  "intents": [
    "audit temporal integrity of scientific claims",
    "check dates chronology source versions and causal ordering in a manuscript",
    "审计论文日期、事件顺序、来源版本、适用期和因果时间逻辑",
    "检查未来事件被写成过去、过时或未来版本误引、虚构比较版本和时间炸弹措辞"
  ],
  "questions": [
    "Do the manuscript's explicit temporal assertions agree with provenance-qualified source effective ranges, event intervals, version catalogs, and causal endpoint ordering?"
  ],
  "entrypoint": "biomed_workbench.capabilities.temporal_integrity:audit_temporal_integrity",
  "execution": {"kind": "python", "timeout_seconds": 30, "max_output_bytes": 10000000},
  "maturity": "validated",
  "input_artifacts": [
    {
      "name": "temporal_fact_bundle",
      "artifact_type": "temporal_fact_bundle",
      "formats": [{"name": "temporal-fact-bundle", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["request-object"]}],
      "processing_levels": ["provenance-qualified"],
      "required_metadata": ["report_reference_date", "terminal_policy", "audit_id", "audit_version"]
    }
  ],
  "output_artifacts": [
    {
      "name": "temporal_integrity_report",
      "artifact_type": "temporal_integrity_report",
      "formats": [{"name": "temporal-integrity-report", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["module-output"]}],
      "processing_levels": ["validated"],
      "required_metadata": ["module_version", "compatibility_row_id", "audit_digest", "report_reference_date", "release_safe"]
    }
  ],
  "preconditions": [
    "Date-bearing source, event, and assertion records are explicitly bound and their precision, provenance method, confidence, and effective-range semantics are declared."
  ],
  "assumptions": [
    "Structured assertion bindings faithfully identify the claims and source or event facts actually used in the research deliverable."
  ],
  "quality_gates": [
    {"id": "temporal-effective-range", "severity": "major", "description": "Publication date must never be substituted for a source's effective date range when adjudicating governance or applicability.", "blocks_interpretation": true},
    {"id": "temporal-ground-truth-confidence", "severity": "major", "description": "Missing, low-confidence, or unverified dates remain unresolved and cannot be used as arithmetic ground truth.", "blocks_interpretation": true},
    {"id": "temporal-causal-order", "severity": "major", "description": "Causal temporal direction requires nonoverlapping verified intervals in the asserted order.", "blocks_interpretation": true},
    {"id": "temporal-version-catalog", "severity": "major", "description": "Comparator nonexistence may be asserted only against an explicitly exhaustive version catalog.", "blocks_interpretation": true},
    {"id": "temporal-audit-completeness", "severity": "major", "description": "Incomplete timeline extraction, assertion extraction, or independent rule review prevents a clean release result.", "blocks_interpretation": true}
  ],
  "limitations": [
    "The deterministic reducer evaluates supplied structured bindings; it does not discover every implicit temporal relation in unrestricted prose or prove source provenance declarations."
  ],
  "evidence_effects": ["validates_temporal_claim_integrity", "detects_anachronistic_evidence", "detects_causal_order_inversion", "limits_release_readiness_claim"],
  "alternatives": ["source-freshness-audit"],
  "complements": ["assertion-citation-coverage-audit", "claim-evidence-integrity-audit", "source-freshness-audit", "citation-resolution-adjudication", "manuscript-audit", "reviewer-assessment"],
  "tool_requirements": [],
  "dependencies": [
    {"name": "python", "ecosystem": "runtime", "identity": "python-runtime", "required": true, "tested_versions": ["3.14.3"], "allowed_versions": [">=3.14,<3.15"], "version_source": "https://www.python.org/downloads/release/python-3143/", "verified_at": "2026-07-13", "version_probe": ["biomed_workbench.modules.compatibility:probe_python_runtime"], "version_probe_kind": "python_callable", "version_probe_timeout_seconds": 5, "version_pattern": "([0-9]+(?:\\.[0-9]+)+)", "purpose": "Validate ISO calendar dates, interval arithmetic, source effective ranges, version chains, and temporal assertion gates with the standard library.", "conflicts": [], "platforms": ["any"]}
  ],
  "compatibility_matrix": [
    {"id": "python-3.14.3-temporal-fact-bundle-1", "module_version": "1.0.0", "tool_versions": {}, "dependency_versions": {"python": [">=3.14,<3.15"]}, "input_formats": {"temporal_fact_bundle": ["temporal-fact-bundle@1"]}, "output_formats": {"temporal_integrity_report": ["temporal-integrity-report@1"]}, "platforms": ["any"], "regression_evidence_ids": ["temporal-integrity-audit-regression-v1"], "end_to_end_evidence_ids": ["temporal-integrity-audit-e2e-v1"], "verified_at": "2026-07-13"}
