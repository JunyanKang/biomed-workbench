            "right_binding": {"type": "object", "nullable": true, "additionalProperties": false, "properties": {"kind": {"type": "string", "enum": ["source", "event", "direct"]}, "id": {"type": "string", "minLength": 1, "maxLength": 128, "nullable": true}, "date": {"type": "object", "nullable": true, "additionalProperties": false, "properties": {"value": {"type": "string", "nullable": true}, "precision": {"type": "string", "enum": ["day", "month", "year", "interval", "unknown"]}, "open_ended": {"type": "boolean"}, "provenance_method": {"type": "string", "enum": ["publisher_metadata", "original_document", "user_verified", "adapter_metadata", "unknown"]}, "confidence": {"type": "string", "enum": ["high", "medium", "low", "unverified"]}, "source_record_id": {"type": "string", "minLength": 1, "maxLength": 128, "nullable": true}}, "required": ["value", "precision", "open_ended", "provenance_method", "confidence", "source_record_id"]}}, "required": ["kind", "id", "date"]}
