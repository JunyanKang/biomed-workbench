    "template_sections": [
      {
        "id": "inspect-spatial-contract",
        "output_artifact_types": [
          "spatial_single_cell_analysis_evidence"
        ],
        "purpose": "Establish counts, samples, coordinates, annotations and spatial elements.",
        "required_logic": [
          "Inspect the actual H5AD or SpatialData table, raw counts, cells or spots, genes, sample identity, annotations, coordinates, units, coordinate systems, images, labels, points, shapes, transformations and source digests.",
          "Freeze graph, permutation, SVG and domain parameters before execution."
        ],
        "template_files": [
          "templates/run_spatial_analysis.py"
        ]
      },
      {
        "id": "compute-sample-aware-spatial-statistics",
        "output_artifact_types": [
          "spatial_single_cell_analysis_evidence"
        ],
        "purpose": "Build spatial evidence without cross-sample geometry.",
        "required_logic": [
          "Build the spatial graph independently within biological samples and prove zero cross-sample edges.",
          "Run sample-restricted neighborhood permutations, per-sample co-occurrence and global plus sample-level Moran permutation tests with multiplicity correction."
        ],
        "template_files": [
          "templates/run_spatial_analysis.py"
        ]
      },
      {
        "id": "discover-spatial-domains",
        "output_artifact_types": [
          "spatial_single_cell_analysis_evidence"
        ],
        "purpose": "Create exploratory expression-spatial domains without label leakage.",
        "required_logic": [
          "Select variable genes, calculate expression PCs, standardize coordinates within samples and construct a frozen joint representation.",
          "Run explicit igraph Leiden without cluster labels and retain post hoc evaluation separately."
        ],
        "template_files": [
          "templates/run_spatial_analysis.py"
        ]
      },
      {
        "id": "reload-and-admit",
        "output_artifact_types": [
          "spatial_single_cell_analysis_evidence"
        ],
        "purpose": "Verify source preservation and inferential boundaries.",
        "required_logic": [
          "Reload every object and table and reconcile counts, cells, genes, coordinates, graphs, spatial genes, domains, versions, parameters and digests.",
          "Require at least two independent biological samples for replicated spatial-gene status; label single-sample outputs as spatial candidates and keep condition inference at the biological-sample level."
        ],
        "template_files": [
          "templates/run_spatial_analysis.py"
        ]
      }
    ]
  },
