        "id": "spatial-graph-selection",
        "parameter": "neighbors-radius-delaunay",
        "selection_rule": "Select a graph from observed platform geometry and physical scale and build it independently within each sample.",
        "validation_rule": "Require zero cross-sample edges and review degree, distance, connectivity and sensitivity to neighboring parameter values."
      },
      {
        "decision_inputs": [
          "candidate genes",
          "sample count",
          "graph",
          "permutations",
          "effect threshold"
        ],
        "id": "spatial-gene-admission",
        "parameter": "moran-effect-fdr-sample-support",
        "selection_rule": "Use declared candidates and require global multiplicity control plus concordant effect support in the declared minimum number of samples.",
        "validation_rule": "Report every tested gene globally and per sample, including failed and discordant candidates."
      }
    ],
    "postflight_checks": [
      "Reconcile source cells, genes, counts, coordinates, graph edges and every output after reload.",
      "Review graph sensitivity, neighborhood and co-occurrence structure, global and per-sample Moran evidence, SVG replication, domain stability and sample composition before interpretation."
    ],
    "preflight_checks": [
      "Inspect actual format, table, counts, observations, genes, samples, annotations, coordinates, units, image and shape provenance, transformations and output paths.",
      "Detect exact Squidpy, SpatialData, Scanpy, Python and dependency versions in an existing scientific runtime and require a validated compatibility profile."
