    {"name": "sample_exposures", "artifact_type": "factor_exposures", "formats": [{"name": "biomed-nmf-exposures", "versions": ["1.0.0"], "representations": ["text", "structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["components-by-samples"]}], "processing_levels": ["derived"], "required_metadata": ["module-version", "compatibility-row-id", "component-axis", "observation-axis", "sample-manifest-digest", "parameter-digest"]},
    {"name": "factorization_report", "artifact_type": "quality_report", "formats": [{"name": "biomed-nmf-report", "versions": ["1.0.0"], "representations": ["structured", "text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["candidate-ranks-by-stability-and-reconstruction"]}], "processing_levels": ["derived"], "required_metadata": ["module-version", "compatibility-row-id", "sample-manifest-digest", "parameter-digest", "implementation-digest"]}
  ],
  "assumptions": ["Input values are biologically meaningful, nonnegative, finite, normalized measurements on comparable experimental units; candidate ranks and stability thresholds were declared before interpretation; feature and sample manifests preserve the exact matrix axes."],
  "preconditions": ["The matrix is uncompressed tab-delimited numeric data without headers, accompanied by unique newline-delimited feature and sample manifests; rows are features, columns are samples; values are nonnegative and contain no missing or infinite entries; at least the largest candidate rank of informative nonconstant features remains."],
  "quality_gates": [
    {"id": "nmf-matrix-identity-and-semantics", "severity": "fatal", "description": "Matrix dimensions, ordered feature and sample identities, value semantics, normalization, experimental unit, sample manifest, missing-value policy, and nonnegativity must be explicit and internally consistent; negative values are rejected rather than clipped.", "blocks_interpretation": true},
    {"id": "nmf-multistart-rank-selection", "severity": "fatal", "description": "Every candidate rank requires the declared deterministic restarts; the selected rank must maximize aligned component then sample-assignment stability within the declared additive relative-reconstruction-error gap, with smaller rank as final tie breaker.", "blocks_interpretation": true},
    {"id": "nmf-independent-reconstruction", "severity": "fatal", "description": "An independent parser must recompute the source matrix approximation, relative Frobenius error, MSE, loading normalization, top features, sample assignments, and component similarity from emitted factors.", "blocks_interpretation": true},
    {"id": "nmf-stability-and-redundancy", "severity": "major", "description": "Nonconverged restarts, component or assignment stability below declared thresholds, or exposure cosine similarity above the declared redundancy threshold block biological naming and hypothesis claims pending sensitivity analysis.", "blocks_interpretation": true},
    {"id": "nmf-association-not-causation", "severity": "major", "description": "Metagene factors are unsupervised associations and do not establish cell identity, pathway mechanism, causal regulation, clinical class, or generalization without orthogonal evidence and held-out validation.", "blocks_interpretation": true}
  ],
  "evidence_effects": ["identifies_reproducible_nonnegative_feature_programs", "quantifies_sample_program_exposures", "tests_factorization_stability_and_redundancy"],
