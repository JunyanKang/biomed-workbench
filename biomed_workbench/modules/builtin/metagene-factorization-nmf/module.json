  "module_type": "analysis",
  "domains": ["omics", "statistics"],
  "intents": ["discover metagene programs with NMF", "stable nonnegative matrix factorization", "compare NMF ranks and sample programs", "用稳定NMF识别元基因表达程序"],
  "questions": ["Which reproducible nonnegative feature programs explain the declared normalized measurements, which samples express each program, and is the selected factorization stable and nonredundant across candidate ranks and restarts?"],
  "maturity": "validated",
  "entrypoint": "scientific-command",
  "input_schema": {"type": "object", "additionalProperties": false, "properties": {}, "required": []},
  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"payload_roles": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3}}, "required": ["payload_roles"]},
