            "colony_count": {"type": "integer", "minimum": 0}
          },
          "required": ["plate_id", "replicate_id", "dilution_factor", "plated_volume_ml", "count_status"]
        }
      },
      "countable_minimum": {"type": "integer", "minimum": 1},
      "countable_maximum": {"type": "integer", "minimum": 2},
      "replicate_level": {"type": "string", "enum": ["unspecified", "technical", "biological"]}
    },
    "required": ["plates"]
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "estimate_admissible": {"type": "boolean"},
      "enumeration_status": {"type": "string"},
      "comparative_interpretation_status": {"type": "string"},
      "cfu_per_ml": {"type": "number", "nullable": true},
