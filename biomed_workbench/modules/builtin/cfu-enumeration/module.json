      "countable_plate_count": {"type": "integer"},
      "total_plate_count": {"type": "integer"},
      "replicate_level": {"type": "string"},
      "replicate_design_status": {"type": "string"},
      "heterogeneity": {"type": "object", "nullable": true},
      "plate_results": {"type": "array"},
      "quality_gates": {"type": "array"}
    },
    "required": ["estimate_admissible", "enumeration_status", "comparative_interpretation_status", "cfu_per_ml", "confidence_interval_95", "countable_plate_count", "total_plate_count", "replicate_level", "replicate_design_status", "heterogeneity", "plate_results", "quality_gates"]
  },
  "preconditions": ["Plate observations are actual counts from one declared sample and dilution convention, with plated volumes in mL and retained plate-level identities.", "The user has declared the countable range appropriate for the plating method and organism; the default 25 to 250 colonies is not universal."],
  "assumptions": ["Countable plate counts are conditionally Poisson around one CFU concentration per mL after accounting for cumulative dilution and plated volume.", "The selected countable range and culture conditions are suitable for the declared organism and assay."],
  "quality_gates": [
    {"id": "cfu-observed-plate-contract", "severity": "fatal", "description": "Require unique plate identities, observed count states, finite cumulative dilution factors, positive plated volumes, and numeric counts only for explicitly counted plates.", "blocks_interpretation": true},
    {"id": "cfu-countable-range-policy", "severity": "fatal", "description": "Use only declared countable plates for the primary estimate while retaining TNTC, invalid, low-count, and high-count plates as reason-coded diagnostics.", "blocks_interpretation": true},
    {"id": "cfu-heterogeneity-and-claim-boundary", "severity": "major", "description": "Block a pooled estimate when countable plates show strong extra-Poisson heterogeneity, and block condition or fitness claims without independent biological replication and a design-aware comparison.", "blocks_interpretation": true}
  ],
  "limitations": ["This module does not count colonies from images, detect contamination, infer viability, infer organism identity, choose incubation conditions, impute uncountable plates, or convert CFU to cells.", "It estimates one declared sample concentration; it does not perform condition-level inference or validate plating recovery efficiency."],
  "evidence_effects": ["adds_diagnostic_bound_cfu_enumeration"],
  "alternatives": [],
  "complements": ["dilution-plan", "growth-curve"],
