  "preconditions": [
    "Codex can inspect the real count object or Matrix Market bundle, biological sample field, chemistry and loading context; the requested method is available in an existing compatible scientific environment; output locations are new; and doublet decisions will be reviewed before removal."
  ],
  "provenance": {
    "concept_sources": [
      "Project-owned conservative doublet-adjudication workflow synthesized from explicit sample, loading, and source-preservation contracts.",
      "https://github.com/swolock/scrublet",
      "https://bioconductor.org/packages/3.18/bioc/html/scDblFinder.html"
    ],
    "license": "Apache-2.0"
  },
  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "Block when counts, cell identities, sample membership, chemistry, raw-count location, expected loading, or source digest cannot be established without guessing.",
      "id": "doublet-input-semantics",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Every input cell must be completed or retained with an explicit not-run or exclusion reason; cells must not be pooled across biologically distinct samples without a declared rationale.",
      "id": "doublet-sample-accounting",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Scores, calls, thresholds, parameters, seeds, direct dependency versions, sparse counts, cells, features, and capture-library identities must be finite, reloadable, and method-specific.",
      "id": "doublet-method-output",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Flag results when called fractions are incompatible with declared loading, sample distribution, or score structure; a method threshold cannot be selected to obtain a desired retention fraction.",
      "id": "doublet-rate-plausibility",
      "severity": "major"
    },
    {
      "blocks_interpretation": true,
      "description": "Automatic deletion is prohibited. Concordance, discordance, neighborhood context, lineage markers, and downstream sensitivity must be recorded before a cell is removed from biological inference.",
      "id": "doublet-adjudication",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Raw counts, source cells, features, sample labels, and pre-existing annotations must survive sparse output reload unchanged, and every source-file digest must remain stable during execution.",
      "id": "doublet-source-preservation",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Independent demultiplexing labels may be used only after fitting; ambiguous labels must be excluded from metrics, and genetic labels must not be described as complete ground truth because same-donor doublets are not identified.",
      "id": "doublet-independent-label-boundary",
      "severity": "major"
    }
  ],
  "questions": [
    "Which cells have reproducible doublet evidence under methods whose assumptions, sample structure, expected loading, and score distributions are explicit, and which cells require review rather than automatic exclusion?"
  ],
