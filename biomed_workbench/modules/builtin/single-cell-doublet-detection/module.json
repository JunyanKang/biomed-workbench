{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not pool biologically distinct samples, guess loading, infer a raw-count layer, tune a threshold from desired retention, or use desired cell labels during fitting.",
      "Do not overwrite raw counts, source cells, features, sample labels, or existing annotations.",
      "Do not automatically remove cells or claim a called doublet is ground truth.",
      "Do not report generated code or unreloaded outputs as validated doublet evidence."
    ],
    "languages": [
      "python",
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "chemistry",
          "recovery",
          "loading concentration",
          "multiplexing",
          "sample size"
        ],
        "id": "expected-doublet-rate",
        "parameter": "expected-doublet-rate",
        "selection_rule": "Derive a sample-specific expected rate from documented loading and chemistry, then retain sensitivity around the chosen value.",
        "validation_rule": "Flag implausible called fractions and prohibit changing the rate after observing desired retention."
      },
      {
        "decision_inputs": [
          "input format",
          "sample design",
          "available compatible runtime",
          "computational constraints"
        ],
        "id": "method-selection",
        "parameter": "requested-methods",
        "selection_rule": "Use both compatible methods when formats and runtime permit; otherwise state exactly which method was not run and why.",
        "validation_rule": "Never relabel an unavailable method as a negative doublet finding."
      },
      {
        "decision_inputs": [
          "method agreement",
          "score distribution",
          "cell neighborhood",
          "marker context",
          "rare-state impact",
          "downstream sensitivity"
        ],
        "id": "exclusion-decision",
        "parameter": "doublet-adjudication",
        "selection_rule": "Require explicit biological and technical review before destructive removal.",
        "validation_rule": "Keep scores, calls, reasons, and a retained sensitivity branch for every consequential exclusion."
      }
    ],
    "postflight_checks": [
      "Reconcile all input cells to completed, insufficient-sample, or explicit error states for every method.",
      "Inspect finite scores, method classes, thresholds, called fractions, agreement, sample distributions, parameter sensitivity, and no automatic source-cell deletion.",
      "Reload sparse outputs and verify raw counts, cells, features, sample labels, previous annotations, method fields, complete direct versions, and SHA-256 digests are preserved.",
      "When predeclared independent labels exist, assess them only after fitting, exclude ambiguous labels from discrimination metrics, and state which doublet classes the labels cannot detect."
    ],
    "preflight_checks": [
      "Inspect the actual count object or Matrix Market bundle, raw-count location, sample field, chemistry, recovery, expected doublet rate, source digest, and requested methods.",
      "Detect Scrublet, scDblFinder, Python, R, and their supporting package versions in existing compatible environments.",
      "Verify integer-like nonnegative counts, unique cells and features, adequate cells per sample, immutable source artifacts, new output paths, and a predeclared downstream sensitivity plan."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
      "input-artifact-sha256",
      "raw-count-location",
      "biological-sample-key",
      "chemistry",
      "loading-rationale",
      "expected-doublet-rate",
      "actual-tool-versions",
      "method-parameters",
      "random-seeds",
      "sample-accounting",
      "method-scores-and-calls",
      "agreement",
      "review-recommendations",
      "output-artifact-sha256",
      "quality-gate-results"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "inspect-doublet-design",
        "output_artifact_types": [
          "single_cell_doublet_evidence"
        ],
        "purpose": "Establish count, sample, chemistry, loading, and downstream-use semantics before doublet detection.",
        "required_logic": [
          "Inspect immutable counts, cells, features, biological samples, chemistry, expected recovery, existing labels, raw-count location, and source digest.",
          "Block guessed sample identities, pooled incompatible samples, noninteger counts, missing loading rationale, or a request to optimize retention after reviewing outcomes.",
          "Predeclare requested methods, expected-rate prior, score or call review policy, and downstream sensitivity plan."
        ],
        "template_files": [
          "templates/run_scrublet.py",
          "templates/run_scdblfinder.R"
        ]
      },
      {
        "id": "execute-per-sample-methods",
        "output_artifact_types": [
          "single_cell_doublet_annotated_object",
          "single_cell_doublet_evidence"
        ],
        "purpose": "Run detected compatible methods independently for each capture library while retaining method-specific evidence.",
        "required_logic": [
          "Run Scrublet on count-backed H5AD libraries and scDblFinder on count-backed Matrix Market libraries using the declared expected-rate rationale.",
          "Preserve every score, threshold, class, warning, not-run sample, parameter, seed, exact cell order, direct dependency version, and source-file SHA-256.",
          "Do not delete cells, use independent labels to fit or tune thresholds, or replace raw counts during detection."
        ],
        "template_files": [
          "templates/run_scrublet.py",
          "templates/run_scdblfinder.R"
        ]
      },
      {
        "id": "adjudicate-and-sensitivity",
        "output_artifact_types": [
          "single_cell_doublet_evidence"
        ],
        "purpose": "Turn method outputs into reviewable quality evidence rather than a black-box filter.",
        "required_logic": [
          "Compare score distributions, expected and observed called fractions, between-method agreement, sample-specific shifts, neighborhood context, lineage-marker context, and potential rare-population impact.",
          "Treat concordance as stronger review evidence and preserve discordant calls; evaluate justified parameter sensitivity before exclusion.",
          "Write a cell-level retain, review, or exclude recommendation with reasons, but require an explicit project decision before destructive filtering."
        ],
        "template_files": [
          "templates/run_scrublet.py",
          "templates/run_scdblfinder.R"
        ]
      },
      {
        "id": "reload-and-admit",
        "output_artifact_types": [
          "single_cell_doublet_annotated_object",
          "single_cell_doublet_evidence"
        ],
        "purpose": "Bind doublet evidence to reloadable source-preserving artifacts.",
        "required_logic": [
          "Reload output H5AD and tabular outputs, reconcile cells, raw counts, sample labels, scores, calls, statuses, versions, and digests.",
          "Record non-run methods and insufficient samples explicitly rather than interpreting absence as a negative result.",
          "Admit only observed evidence that passes all quality gates; preserve unresolved doublet status for downstream sensitivity analysis."
        ],
        "template_files": [
          "templates/run_scrublet.py",
          "templates/run_scdblfinder.R"
        ]
      }
    ]
  },
