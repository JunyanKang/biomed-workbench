  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "Block when FASTA identifiers, sequence alphabet, duplicate records, sequence provenance, or declared homology basis are ambiguous; sequence similarity alone is not accepted as orthology proof.",
      "id": "comparative-sequence-identity-and-homology",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "MAFFT output must reload with exactly the input record set, one common aligned length, finite nonempty residues, and an explicitly reported gap burden; failed alignment never falls back to position-wise comparison.",
      "id": "comparative-alignment-completeness",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "IQ-TREE output must retain the declared model, support method, replicate count, seed, and a reloadable tree whose tips match the alignment records; a tree without required support remains exploratory.",
      "id": "comparative-tree-model-and-support",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Rooting requires declared, present and biologically appropriate outgroup records; topology does not by itself establish orthology, selection, species history, recombination, divergence time, or functional conservation.",
      "id": "comparative-outgroup-and-claim-boundary",
      "severity": "major"
    },
    {
      "blocks_interpretation": true,
      "description": "Reload alignment, tree, metadata join and report; reconcile every input record, tool version, parameter, digest and rejected record before scientific interpretation.",
      "id": "comparative-output-provenance",
      "severity": "fatal"
    }
  ],
  "questions": [
