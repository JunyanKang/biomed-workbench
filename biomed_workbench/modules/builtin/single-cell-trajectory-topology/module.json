{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Do not manage runtimes or infrastructure, guess anchors, tune topology to desired conclusions, treat cells as donor replicates, overwrite counts, or report unreloaded outputs."
    ],
    "languages": [
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "biology",
          "external time",
          "cluster coverage",
          "independent markers"
        ],
        "id": "topology-anchors",
        "parameter": "start-end-root",
        "selection_rule": "Freeze anchors from independent evidence.",
        "validation_rule": "Do not tune anchors toward desired genes or branches."
      }
    ],
    "postflight_checks": [
      "Check lineage coverage, external-time direction, method concordance, all tradeSeq tables and native object reload."
    ],
    "preflight_checks": [
      "Inspect aligned counts, metadata and embedding and detect exact R package versions."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
      "input-digests",
      "anchors",
      "nknots",
      "actual-tool-versions",
      "lineage-support",
      "time-correlations",
      "output-digests",
      "quality-gates"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "inspect-topology-design",
        "output_artifact_types": [
          "single_cell_trajectory_evidence"
        ],
        "purpose": "Establish aligned counts, embedding, clusters, samples, time and anchors.",
        "required_logic": [
          "Inspect source digests, cells, genes, counts, samples, external time, embedding, cluster coverage, roots and ends.",
          "Freeze topology and tradeSeq parameters before execution."
        ],
        "template_files": [
          "templates/run_slingshot_monocle_tradeseq.R"
        ]
      },
      {
        "id": "fit-and-cross-check-topology",
        "output_artifact_types": [
          "single_cell_trajectory_evidence"
        ],
        "purpose": "Infer lineages and graph with independent methods.",
        "required_logic": [
          "Fit Slingshot lineages and weights and Monocle3 graph pseudotime.",
          "Require both methods to agree with withheld time and each other."
        ],
        "template_files": [
          "templates/run_slingshot_monocle_tradeseq.R"
        ]
      },
      {
        "id": "fit-tradeseq-and-reload",
        "output_artifact_types": [
          "single_cell_trajectory_evidence"
        ],
        "purpose": "Test lineage gene programs and validate outputs.",
        "required_logic": [
          "Fit lineage-weighted GAMs and retain all four prefixed test tables.",
          "Reload cell and gene tables and native Monocle3 directory including indexes."
        ],
        "template_files": [
          "templates/run_slingshot_monocle_tradeseq.R"
        ]
      }
    ]
  },
  "alternatives": [
    "single-cell-fate-mapping",
    "single-cell-trajectory-velocity"
  ],
  "assumptions": [
    "Embedding and cluster choices are reviewed inputs; cell-level trajectories are descriptive and do not replace donor-level condition inference or prove ancestry."
