    },
    {
      "id": "specificity-product-accounting",
      "severity": "major",
      "description": "Retain every exact-match product per declared reference, including truncation state and reference topology.",
      "blocks_interpretation": true
    },
    {
      "id": "specificity-claim-boundary",
      "severity": "major",
      "description": "Block general specificity claims when the finite panel is incomplete, mismatch-tolerant screening is absent, or an off-target product is present.",
      "blocks_interpretation": true
    }
  ],
