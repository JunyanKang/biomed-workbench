{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Do not edit the packaged workflow source, invent sample metadata, infer library properties from filenames, or use cells, nuclei, reads, exons, junctions or transcripts as biological replicates.",
      "Do not call intronic or exonic abundance, spliced/unspliced velocity layers, differential exon usage, transcript usage, local events and full-length isoforms interchangeable forms of evidence.",
      "Do not infer a direct RNA-processing mechanism from gene overlap with binding, chromatin, R-loop, expression or protein-interaction results.",
      "Do not admit a generated command, dry run, process exit, unreloaded result, empty panel or audit report as completed scientific analysis."
    ],
    "languages": [
      "python",
      "r",
      "workflow"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "assay class",
          "event, exon, transcript or isoform estimand",
          "annotation dependence",
          "novel junction objective",
          "replicate design",
          "read coverage"
        ],
        "id": "minimum-sufficient-method",
        "parameter": "analysis-branch",
        "selection_rule": "Choose the single primary branch whose native estimand answers the stated question and add at most one orthogonal validation that can change the scientific decision.",
        "validation_rule": "Reject a method whose input model, replicate unit, event definition or claim boundary does not match the observed data."
      },
      {
        "decision_inputs": [
          "biological unit",
          "pairing",
          "batch",
          "condition",
          "sample count",
          "coverage",
          "design rank"
        ],
        "id": "sample-level-inference",
        "parameter": "replicate-and-contrast",
        "selection_rule": "Fit condition effects at the independent sample level with pairing and justified covariates declared before reviewing results.",
        "validation_rule": "Block formal inference for pseudo-replication, confounding, rank deficiency, inadequate sample replication or condition-specific coverage failure."
      },
      {
        "decision_inputs": [
          "scientific minimum effect",
          "event family",
          "coverage",
          "replicate variability",
          "confirmatory or exploratory role"
        ],
        "id": "effect-and-multiplicity",
        "parameter": "decision-thresholds",
        "selection_rule": "Declare a biologically meaningful delta-PSI or usage threshold, coverage filter, replicate consistency rule and multiplicity family before inspecting significance.",
        "validation_rule": "Retain sensitivity near thresholds and never promote nominal P values, post hoc filters or visually selected events as formal evidence."
      }
    ],
    "postflight_checks": [
      "Reload all result tables, logs, normalized event records and figures; reconcile event identifiers, coordinates, group direction, sample order, record counts, parameters, versions and file digests.",
      "Review coverage, replicate PSI or usage consistency, event-family counts, effect and P-value distributions, multiplicity, method agreement and candidate-to-formal status.",
      "Write exact claim boundaries for event, exon, transcript, isoform, processing-kinetic and integrated evidence before project promotion."
    ],
    "preflight_checks": [
      "Inspect real inputs and record source digests, sample identities, biological units, conditions, pairing, batch, read layout, strandedness, read length, reference and annotation.",
      "Detect exact versions and official parameter surfaces for the selected backend; stop when the installed version falls outside the compatibility row.",
      "Freeze the primary method, orthogonal validation, filtering, effect threshold, multiplicity family and required figure panels before execution."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "analysis-branch",
      "assay-class",
      "sample-manifest-digest",
      "source-digests",
      "reference",
      "annotation-release",
      "library-layout",
      "strandedness",
      "read-length",
      "biological-unit",
      "design",
      "contrast",
      "filtering",
      "effect-threshold",
      "multiplicity-family",
      "actual-tool-versions",
      "parameters",
      "output-digests",
      "quality-gates",
      "scientific-status"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "admit-design-and-select-branch",
        "output_artifact_types": [
          "rna_processing_analysis_evidence"
        ],
        "purpose": "Resolve the data-generating assay and scientific estimand before choosing an RNA-processing method.",
        "required_logic": [
          "Inspect actual source files, sample sheet, experimental units, condition and pairing structure, library layout, strandedness, read length, reference, annotation and upstream quality reports.",
          "Use one primary analysis and one decision-relevant orthogonal validation; do not stack methods that answer the same question without added decision value.",
          "Distinguish event-level splicing, exon usage, transcript usage, droplet junction screening, long-read isoforms, processing kinetics and cross-assay integration."
        ],
        "template_files": [
          "templates/run_rna_processing_workflow.py"
        ]
      },
      {
        "id": "execute-reload-and-integrate",
        "output_artifact_types": [
          "rna_processing_analysis_evidence"
        ],
        "purpose": "Run the admitted branch, reload all outputs, create standardized event tables and figures, and relate accepted events to independent evidence without causal inflation.",
        "required_logic": [
          "For replicated short-read bulk event testing, execute rMATS with measured read length, declared library type, explicit variable-length, pairing, novel-site and effect-size-null parameters.",
          "For transcript usage use Salmon or equivalent transcript counts with DRIMSeq and stageR; for exon usage use DEXSeq; preserve method-native hypothesis families and filtering.",
          "For 3-prime droplet data, retain sample-level junction candidates and coverage sensitivity but block formal event claims based on cells, intronic signal, exon signal or velocity layers.",
          "For long reads, follow FLAIR alignment, correction, shared collapse, sample-wise quantification and replicated differential analysis, retaining isoform structure and productivity uncertainty.",
          "Reload normalized outputs and figures, then link binding, R-loop, chromatin, expression or protein evidence as separate support types with direct causality unresolved."
        ],
        "template_files": [
          "templates/run_rna_processing_workflow.py"
        ]
      }
    ]
  },
