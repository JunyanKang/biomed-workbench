  "output_artifacts": [{"name": "protein_network_result", "artifact_type": "evidence_bundle", "formats": [{"name": "normalized-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["STRING-12.0"], "orientations": ["module-output"]}], "processing_levels": ["source-preserved", "derived"], "required_metadata": ["service-contract", "database-release", "retrieval-time"]}, {"name": "protein_network_figures", "artifact_type": "network_figure_bundle", "formats": [{"name": "publication-figure-set", "versions": ["1"], "representations": ["container"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["STRING-12.0"], "orientations": ["module-output"]}], "processing_levels": ["derived"], "required_metadata": ["style-version", "source-digest", "replot-tables"]}],
  "preconditions": ["A bounded unique protein list and exact NCBI taxonomy identifier are available and public HTTPS access is permitted."],
  "assumptions": ["Input identifiers refer to the intended species and mapping ambiguities or losses are scientifically reviewed before network interpretation."],
  "quality_gates": [{"id": "string-identifier-mapping", "severity": "fatal", "description": "Preserve query index, submitted identifier, STRING ID, preferred name, organism and every unmapped identifier without silent substitution.", "blocks_interpretation": true}, {"id": "string-network-semantics", "severity": "fatal", "description": "Record release, network type, required score, added-node policy and all combined and channel-specific edge scores.", "blocks_interpretation": true}, {"id": "string-enrichment-semantics", "severity": "major", "description": "Preserve node and edge counts, expected edges, average degree, clustering and PPI enrichment p-value without converting enrichment into mechanism.", "blocks_interpretation": true}, {"id": "ppi-publication-render", "severity": "major", "description": "Export node and edge TSVs, Cytoscape style, PDF, SVG and 600-dpi PNG with fixed layout and explicit edge semantics.", "blocks_interpretation": true}],
