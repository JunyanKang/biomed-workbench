        "validation_rule": "Record every reader argument and enumerate imported tables, images, labels, shapes and points."
      },
      {
        "decision_inputs": [
          "image channel",
          "existing boundaries",
          "object scale",
          "landmarks",
          "section modality"
        ],
        "id": "image-operation",
        "parameter": "segmentation-registration",
        "selection_rule": "Use existing validated boundaries when present; otherwise predeclare watershed or Cellpose. Use paired landmarks for an explicit SpatialData transform.",
        "validation_rule": "Review boundary quality, transcript assignment, pre/post overlays and registration residual error."
      }
    ],
    "postflight_checks": [
      "Reload every H5AD/Zarr/TSV/JSON output and reconcile dimensions, coordinate systems, transforms and digests.",
      "Review platform-specific controls, segmentation overlays and registration error before downstream inference."
    ],
    "preflight_checks": [
      "Inspect exact platform files, vendor software release, panel/genome annotation, coordinate unit, sample key, image channels, boundaries and transforms.",
      "Detect exact workspace-isolated Python, SpatialData, SpatialData-IO, Squidpy and optional Cellpose versions."
