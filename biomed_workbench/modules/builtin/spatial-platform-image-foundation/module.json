    "forbidden_actions": [
      "Use only project-approved isolated runtimes; do not mutate the host environment.",
      "Do not guess platform, coordinate unit, bin size, image channel, sample identity or transform; do not impute absent negative controls; do not resample source imagery merely to simplify coordinates; do not overwrite vendor output."
    ],
    "languages": [
      "python",
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
