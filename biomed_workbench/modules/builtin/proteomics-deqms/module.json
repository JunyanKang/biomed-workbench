{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not invent protein support counts, impute design variables, treat technical runs as replicates, repair rank deficiency silently, select a coefficient after reviewing significance, or present generated but unexecuted code as evidence."
    ],
    "languages": [
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "experimental design",
          "quantification method",
          "missingness",
          "peptide or PSM evidence",
          "contrast"
        ],
        "id": "deqms-design-support",
        "parameter": "formula-coefficient-support-count",
        "selection_rule": "Declare a full-rank design and directional coefficient and construct the protein support count according to the upstream quantification design before inspecting differential significance.",
        "validation_rule": "Require ordered sample identity, residual degrees of freedom, positive integer support, the same coefficient in both DEqMS calls, and official count-variance diagnostics."
      }
    ],
    "postflight_checks": [
      "Reload the full DEqMS result and every PDF/SVG diagnostic, verify coefficient identity, finite effects, bounded p values, digests, versions and quality gates."
    ],
    "preflight_checks": [
      "Detect exact R, DEqMS, limma, jsonlite and digest versions in the project-approved runtime.",
      "Inspect actual matrices and design; block ambiguous support-count semantics, non-biological replication, rank deficiency, or unrecorded preprocessing."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
      "input-digests",
      "normalization",
      "missingness-policy",
      "support-count-semantics",
      "formula",
      "coefficient",
      "factor-levels",
      "actual-tool-versions",
      "plot-standard-version",
      "output-digests",
      "quality-gates"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "fit-diagnose-reload-deqms",
        "output_artifact_types": [
          "deqms_proteomics_inference"
        ],
        "purpose": "Validate protein abundance, support, sample design, coefficient, DEqMS fit, official diagnostics, and result reload.",
        "required_logic": [
          "Inspect ordered samples, protein identifiers, abundance scale, missingness, normalization, support-count construction, experimental units, factor levels, design rank and coefficient direction.",
          "Execute limma, attach the declared protein count, call spectraCounteBayes and outputResult with the same coefficient, and retain official DEqMS diagnostics.",
          "Reload tables and figures, verify p-value bounds and provenance, and block causal or pathway claims."
        ],
        "template_files": [
          "templates/run_deqms.R"
        ]
      }
    ]
  },
  "alternatives": [
    "differential-expression"
  ],
  "assumptions": [
    "The supplied support count has the peptide or PSM semantics justified for the upstream quantification method and declared contrast."
  ],
  "code_templates": [
    {
      "language": "r",
      "path": "templates/run_deqms.R",
