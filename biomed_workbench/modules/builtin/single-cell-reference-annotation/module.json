    "schema_version": 1,
    "template_sections": [
      {
        "id": "inspect-query-reference-contract",
        "output_artifact_types": [
          "single_cell_annotation_validation"
        ],
        "purpose": "Establish whether the query, reference, markers, and ontology are semantically compatible before mapping.",
        "required_logic": [
          "Inspect real h5ad count locations, cells, genes, group keys, existing labels, reference labels, feature namespaces, annotation releases, and provenance.",
          "Validate exact gene overlap and reject guessed identifier conversion, duplicated features, missing labels, incomplete marker contracts, and undeclared ontology edges.",
          "Declare thresholds and optional post hoc evaluation labels before viewing mapping outcomes."
        ],
        "template_files": [
          "templates/annotate_reference.py",
          "templates/run_singler.R"
        ]
      },
      {
        "id": "execute-reference-mapping",
        "output_artifact_types": [
          "single_cell_annotated_object",
          "single_cell_annotation_validation"
        ],
        "purpose": "Run SingleR on aligned sparse log-normalized expression without modifying source objects.",
        "required_logic": [
          "Adapt the template to the observed query and reference structures and exchange genes-by-cells sparse matrices through a temporary workspace.",
          "Run the detected SingleR API and retain forced labels, pruned labels, delta.next, maximum score, and per-label scores in exact query-cell order.",
          "Treat SingleR labels as candidates rather than final annotations."
        ],
        "template_files": [
          "templates/annotate_reference.py",
          "templates/run_singler.R"
        ]
      },
      {
        "id": "adjudicate-marker-ontology-unknown",
        "output_artifact_types": [
          "single_cell_annotated_object",
          "single_cell_annotation_validation"
        ],
        "purpose": "Accept only reference labels supported by independent biological and ontology constraints.",
        "required_logic": [
          "Compute group consensus from forced and pruned SingleR labels and evaluate declared positive and negative markers against the query-wide background.",
          "Resolve candidate ontology identifiers through the declared parent graph and enforce group-level allowed ancestors.",
          "Require cell-level pruning and delta thresholds after group acceptance; retain every conflict, low-confidence cell, or unsupported population as unknown with reason codes."
        ],
        "template_files": [
          "templates/annotate_reference.py"
        ]
      },
      {
        "id": "reload-evaluate-and-admit",
        "output_artifact_types": [
          "single_cell_annotated_object",
          "single_cell_annotation_validation"
        ],
        "purpose": "Bind annotations to a reloadable h5ad and optional independent evaluation.",
        "required_logic": [
          "Write candidate, pruned, delta, ontology, conservative label, status, and reason fields to a new h5ad without changing existing labels or raw counts.",
          "Reload and reconcile cells, genes, source labels, counts, annotation fields, contracts, versions, thresholds, and digests.",
          "If independent truth exists, calculate post hoc performance only after decisions are frozen; admit only observed annotations passing all source-preservation gates."
        ],
        "template_files": [
          "templates/annotate_reference.py"
        ]
      }
    ]
  },
