{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not guess gene identifier mappings, ontology edges, reference scope, marker evidence, missing labels, or annotation releases.",
      "Do not use existing labels, evaluation truth, expected markers, desired cell types, conditions, or conclusions to tune SingleR or thresholds.",
      "Do not accept a maximum reference score without pruning, group consensus, marker support, ontology allowance, and cell-level confidence.",
      "Do not overwrite raw counts, source h5ad objects, existing labels, unknown labels, cells, genes, or sample provenance.",
      "Do not force transitional, novel, discordant, or unsupported populations into the nearest known reference class.",
      "Do not report generated code, temporary matrix exchange, or an unreloaded h5ad as validated annotation evidence."
    ],
    "languages": [
      "python",
      "r",
      "notebook"
    ],
    "mode": "codex_generated_project_code",
    "parameter_rules": [
      {
        "decision_inputs": [
          "species",
          "tissue",
          "developmental stage",
          "disease state",
          "assay",
          "feature namespace",
          "annotation release"
        ],
        "id": "reference-selection",
        "parameter": "reviewed-reference",
        "selection_rule": "Use a biologically matched, independently reviewed reference whose scope and missing populations are explicitly documented.",
        "validation_rule": "An unmatched or uncertified atlas remains unavailable rather than silently substituted."
      },
      {
        "decision_inputs": [
          "query genes",
          "reference genes",
          "identifier namespace",
          "reference markers"
        ],
        "id": "gene-overlap",
        "parameter": "minimum-common-genes-and-fraction",
        "selection_rule": "Declare both an absolute and query-relative overlap requirement before mapping.",
        "validation_rule": "Block guessed identifier conversion and references missing required marker genes."
      },
      {
        "decision_inputs": [
          "cluster granularity",
          "reference class similarity",
          "pruning behavior",
          "class balance"
        ],
        "id": "confidence-and-consensus",
        "parameter": "delta-and-group-consensus-thresholds",
        "selection_rule": "Require independent cell-level and group-level agreement rather than one maximum score.",
        "validation_rule": "Retain pruned, discordant, or low-delta cells as unknown."
      },
      {
        "decision_inputs": [
          "positive markers",
          "negative markers",
          "query background",
          "ontology release",
          "group constraints"
        ],
        "id": "marker-and-ontology",
        "parameter": "marker-support-conflict-and-ontology-allowance",
        "selection_rule": "Predeclare minimum positive support, maximum negative conflict, and allowed ontology ancestors.",
        "validation_rule": "Any marker or ontology conflict blocks acceptance regardless of SingleR score."
      }
    ],
    "postflight_checks": [
      "Reconcile every SingleR score and label to query-cell order and declared reference classes.",
      "Inspect group consensus, positive marker support, negative conflicts, ontology ancestors, cell pruning, delta thresholds, accepted labels, unknowns, and reason codes.",
      "Reload the annotated h5ad and verify all source cells, genes, existing labels, raw counts, annotations, contracts, tool versions, thresholds, and digests.",
      "Compare optional independent truth only after annotation decisions are frozen and report unsupported reference populations explicitly."
    ],
    "preflight_checks": [
      "Inspect query, reference, marker, ontology, feature, label, group, unknown, and optional evaluation semantics from the real artifacts.",
      "Detect SingleR, Scanpy, AnnData, NumPy, pandas, SciPy, scikit-learn, R, Matrix, BiocParallel, and jsonlite versions in existing environments.",
      "Verify unique identifiers, integer-like counts, exact label-contract coverage, ontology graph fields, query-reference overlap, source immutability, and new output paths.",
      "Freeze normalization, SingleR API, thresholds, reference scope, marker evidence, ontology release, and post hoc evaluation policy before execution."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
