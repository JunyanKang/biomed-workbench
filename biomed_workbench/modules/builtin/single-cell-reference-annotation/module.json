  "preconditions": [
    "Codex can inspect the real query, reference, marker, and ontology artifacts; the existing Python and R environments contain the declared compatible tools; all output paths are new; and no environment or compute-infrastructure management is required."
  ],
  "provenance": {
    "concept_sources": [
      "Project-owned Codex-native conservative annotation workflow synthesized from validated SingleR APIs, marker evidence requirements, and explicit ontology graph constraints.",
      "https://bioconductor.org/packages/3.18/bioc/html/SingleR.html",
      "https://obophenotype.github.io/cell-ontology/"
