  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "Block when query or reference counts, cells, genes, label provenance, feature namespace, annotation release, query groups, marker contract, ontology release, or source digest cannot be established without guessing.",
      "id": "annotation-input-and-feature-semantics",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Block when query-reference gene overlap is inadequate, reference labels lack cells or contracts, or reference classes and marker or ontology labels disagree.",
      "id": "annotation-reference-coverage",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "The complete finite SingleR score matrix, maximum scores, labels, pruning, delta values, and cell order must reconcile exactly to the query object and every declared reference label.",
      "id": "annotation-singler-reconciliation",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Accept a label only when group consensus, pruned cell agreement, positive-marker support, and negative-marker conflict satisfy predeclared thresholds.",
      "id": "annotation-marker-and-group-support",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Candidate ontology identifiers or their declared ancestors must satisfy any group constraint; ontology conflicts remain unknown.",
      "id": "annotation-ontology-consistency",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Low-confidence, pruned, discordant, marker-conflicting, ontology-conflicting, or absent-reference populations remain unknown; SHA-256 identities of query, reference, marker, and ontology sources must remain stable, and source labels, raw counts, cells, and features are never overwritten.",
      "id": "annotation-unknown-and-source-preservation",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "The annotated h5ad must reload with all source identities, annotation fields, reason codes, contracts, raw counts, and output digest intact.",
      "id": "annotation-output-reload",
      "severity": "fatal"
    }
  ],
  "questions": [
    "Which query cells and clusters can be conservatively assigned to reviewed reference labels when SingleR, marker evidence, ontology constraints, and uncertainty all agree?"
  ],
