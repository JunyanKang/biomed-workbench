        "required_logic": [
          "Detect the exact CrossMap version and execute only the declared chain and input artifacts.",
          "Reload mapped and unmapped outputs, validate target BED widths and reconcile each source identifier exactly once or as explicit split mappings."
        ],
        "template_files": [
          "templates/run_crossmap_bed.py"
        ]
      }
    ]
