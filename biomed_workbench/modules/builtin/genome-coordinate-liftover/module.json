      }
    ],
    "postflight_checks": [
      "Reload mapped and unmapped outputs; reconcile every input identifier, validate target interval widths, count split mappings and preserve commands, versions, digests and policy decisions."
    ],
    "preflight_checks": [
      "Detect CrossMap and Python versions in an existing compatible environment.",
      "Validate BED column structure, unique stable identifiers, source and target assemblies, zero-based half-open semantics, chain URL/digest and output paths."
