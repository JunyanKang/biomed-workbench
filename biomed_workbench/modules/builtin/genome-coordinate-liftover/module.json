          "Inspect every BED record, reference build, coordinate convention, record identifier, chain direction and chain digest.",
          "Refuse guessed assemblies, one-based BED labels, mutable chain URLs and undeclared split or unmapped policies."
        ],
        "template_files": [
          "templates/run_crossmap_bed.py"
        ]
      },
      {
        "id": "execute-and-reconcile-liftover",
