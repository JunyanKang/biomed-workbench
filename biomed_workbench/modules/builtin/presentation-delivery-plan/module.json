{
  "schema_version": 1,
  "id": "presentation-delivery-plan",
  "version": "1.0.0",
  "title": "Build a presentation delivery plan",
  "description": "Create a publication-facing presentation plan and execution graph that binds findings, slide outputs, peer-response states, and review modules into a bounded delivery workflow.",
  "module_type": "delivery",
  "domains": ["publication"],
  "intents": [
    "presentation delivery plan",
    "build presentation workflow",
    "presentation plan"
  ],
  "questions": [
    "How should this scientific output be translated into an auditable presentation package for a specific audience?"
  ],
  "entrypoint": "biomed_workbench.capabilities.publication:presentation_delivery_plan",
  "execution": {
    "kind": "python",
    "timeout_seconds": 30,
    "max_output_bytes": 10000000
  },
  "maturity": "validated",
  "input_artifacts": [
    {
      "name": "presentation_request",
      "artifact_type": "presentation_request",
      "processing_levels": ["declared"],
      "required_metadata": ["project-id", "audience-boundary", "version"],
      "formats": [
        {
          "name": "inline-json",
          "versions": ["1"],
          "representations": ["structured"],
          "compression": ["none"],
          "required_indexes": [],
          "coordinate_systems": [],
          "genome_build_policy": "not_applicable",
          "genome_builds": [],
          "annotation_releases": [],
          "orientations": ["request-object"]
        }
      ]
    }
  ],
  "output_artifacts": [
    {
      "name": "presentation_plan",
      "artifact_type": "presentation_plan",
      "processing_levels": ["derived", "delivery"],
      "required_metadata": ["module-version", "compatibility_row_id"],
      "formats": [
        {
          "name": "inline-json",
          "versions": ["1"],
          "representations": ["structured"],
          "compression": ["none"],
          "required_indexes": [],
          "coordinate_systems": [],
          "genome_build_policy": "not_applicable",
          "genome_builds": [],
          "annotation_releases": [],
          "orientations": ["delivery-plan"]
        }
      ]
    }
  ],
  "preconditions": [
    "A bounded set of findings and a target audience definition are supplied."
  ],
  "assumptions": [
    "The available module catalog and manuscript state are correctly described when provided."
  ],
  "quality_gates": [
    {
      "id": "presentation-delivery-boundary",
      "severity": "major",
      "description": "A delivery plan cannot be marked ready when key findings, figure bindings, or peer comments contain unresolved blocks.",
      "blocks_interpretation": true
    },
    {
      "id": "presentation-provenance-complete",
      "severity": "major",
      "description": "Downstream publication outputs must retain module lineage before final delivery.",
      "blocks_interpretation": true
    }
  ],
  "limitations": [
    "This module plans delivery sequence and gating; it does not itself verify scientific truth, model fitness, or biological validity.",
    "Missing evidence is kept as explicit gaps and must be closed before claiming delivery completeness."
  ],
  "evidence_effects": [
    "qualifies-presentation-delivery-readiness",
    "blocks-presentation-gaps"
  ],
  "alternatives": [],
  "complements": [
