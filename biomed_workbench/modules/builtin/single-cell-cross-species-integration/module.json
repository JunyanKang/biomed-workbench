        "orthology-ledger-and-feature-coverage",
        "native-method-and-baseline-comparison",
        "cross-species-inference-boundary"
      ],
      "requires_adaptation": false
    },
    {
      "language": "python",
      "path": "templates/run_samap.py",
      "purpose": "Run SAMap with precomputed sequence-homology maps and native output retention.",
      "quality_gate_ids": [
        "orthology-ledger-and-feature-coverage",
        "native-method-and-baseline-comparison",
        "held-out-species-and-state-retention"
      ],
      "requires_adaptation": false
    },
    {
      "language": "python",
      "path": "templates/run_saturn.py",
      "purpose": "Validate species count matrices and protein embeddings, then invoke the official SATURN entrypoint with explicit parameters.",
      "quality_gate_ids": [
        "native-method-and-baseline-comparison",
        "held-out-species-and-state-retention"
      ],
      "requires_adaptation": false
    },
    {
      "language": "python",
      "path": "templates/run_came.py",
      "purpose": "Run pairwise CAME with one-to-many and many-to-many gene relations retained in the heterogeneous graph.",
      "quality_gate_ids": [
        "orthology-ledger-and-feature-coverage",
        "native-method-and-baseline-comparison",
        "held-out-species-and-state-retention"
      ],
      "requires_adaptation": false
    },
    {
      "language": "python",
      "path": "templates/evaluate_cross_species.py",
      "purpose": "Evaluate species mixing, biology preservation, leave-one-species-out transfer, unsupported states and conserved modules.",
      "quality_gate_ids": [
        "held-out-species-and-state-retention",
        "cross-species-inference-boundary"
      ],
      "requires_adaptation": false
    }
  ],
