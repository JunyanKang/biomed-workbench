{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Do not silently collapse many-to-many orthology, tune against desired labels, force query-specific states into reference labels, select by UMAP appearance, overwrite raw counts, or use integrated values for confirmatory differential inference."
    ],
    "languages": [
      "python",
      "r"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "evolutionary distance",
          "orthology complexity",
          "species count",
          "protein embeddings",
          "compute",
          "reference direction"
        ],
        "id": "cross-species-method",
        "parameter": "baseline-samap-saturn-came",
        "selection_rule": "Always include a one-to-one baseline; use SAMap for sequence-plus-neighborhood mapping, SATURN for multi-species protein-embedding integration, and CAME for pairwise many-to-many graph transfer.",
        "validation_rule": "Block any method whose sequence map, protein embedding, graph relation or declared direction is absent."
      },
      {
        "decision_inputs": [
          "species",
          "labels",
          "samples",
          "modules",
          "unsupported states"
        ],
        "id": "cross-species-admission",
        "parameter": "mixing-preservation-loso-specific-state",
        "selection_rule": "Retain all metric families and method-native outputs; do not rank by UMAP appearance or require species signal to vanish.",
        "validation_rule": "Block claims when held-out species, unsupported labels or species-specific states were not evaluated."
      }
    ],
    "postflight_checks": [
      "Reload every H5AD and report; reconcile cells, species, genes, orthology relations, parameters, seeds, native models, unsupported states and input/output digests."
    ],
    "preflight_checks": [
      "Inspect actual counts, species, samples/donors, reviewed labels, unknown states, feature identifiers, orthology evidence, sequence maps, protein embeddings, compute and runtime versions."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "input-digests",
      "species",
      "samples",
      "orthology-resource-release-confidence",
      "method-version",
      "protein-embedding-release",
      "parameters",
      "seed",
      "output-digests",
      "quality-gates"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "orthology-and-baselines",
        "output_artifact_types": [
          "cross_species_integration_evidence"
        ],
        "purpose": "Freeze gene relationships and construct a conservative method-neutral baseline.",
        "required_logic": [
          "Retain resource, release, confidence and one-to-one/one-to-many/many-to-many relations.",
          "Report per-species coverage and prepare only complete high-confidence one-to-one orthogroups for classical baselines.",
          "Compare scVI/scANVI, Harmony and CCA/RPCA without treating any one method as a default winner."
        ],
        "template_files": [
          "templates/build_orthology_ledger.py",
          "templates/prepare_shared_ortholog_baseline.py"
        ]
      },
      {
        "id": "native-cross-species-methods",
        "output_artifact_types": [
          "cross_species_integration_evidence"
        ],
        "purpose": "Run sequence-, protein-embedding- or graph-based methods with their native contracts.",
        "required_logic": [
          "Use SAMap only with reviewed bidirectional sequence maps.",
          "Use SATURN with versioned protein embeddings and compute/resource provenance.",
          "Use CAME pairwise with explicit reference/query direction and broad orthology mappings."
        ],
        "template_files": [
          "templates/run_samap.py",
          "templates/run_saturn.py",
          "templates/run_came.py"
        ]
      },
      {
        "id": "held-out-adjudication",
        "output_artifact_types": [
          "cross_species_integration_evidence"
        ],
        "purpose": "Separate conserved state transfer from overcorrection and forced labels.",
        "required_logic": [
          "Run leave-one-species-out label transfer and list unsupported truth labels.",
          "Score species mixing and biological preservation separately; review species-specific populations in unintegrated and integrated spaces.",
          "Compare conserved module scores when available and return inference to species-specific raw counts."
        ],
        "template_files": [
          "templates/evaluate_cross_species.py"
        ]
      }
    ]
  },
  "alternatives": [
    "single-cell-integration-benchmark",
    "single-cell-reference-mapping"
  ],
  "assumptions": [
    "One-to-one shared-gene matrices are conservative baselines; SAMap uses sequence homology plus expression neighborhoods, SATURN uses protein embeddings and macrogenes, and CAME uses a pairwise heterogeneous graph with broader orthology relations."
  ],
  "code_templates": [
    {
      "language": "python",
      "path": "templates/build_orthology_ledger.py",
      "purpose": "Build a release-aware relation ledger and quantify feature coverage before method selection.",
      "quality_gate_ids": [
        "orthology-ledger-and-feature-coverage"
      ],
      "requires_adaptation": false
    },
    {
      "language": "python",
      "path": "templates/prepare_shared_ortholog_baseline.py",
      "purpose": "Prepare a conservative count-backed one-to-one ortholog matrix for scVI, scANVI, Harmony and Seurat CCA/RPCA baseline comparison.",
