{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Do not copy MSBio2 software, license contents or private project outputs into the public repository.",
      "Do not use the full genome as an implicit background when the assay tested a narrower universe.",
      "Do not label MCODE topology or visual proximity as a validated pathway, complex or mechanism.",
      "Do not leave a task-launched Cytoscape process running after exports are validated, and do not terminate a pre-existing user-owned Cytoscape process."
    ],
    "languages": [
      "python"
    ],
    "mode": "packaged_parameterized_workflow",
