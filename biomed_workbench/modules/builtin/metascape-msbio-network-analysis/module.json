          "list-count",
          "hypothesis",
          "network-size"
        ],
        "id": "select-metascape-design",
        "parameter": "universe-thresholds-and-ppi-source",
        "selection_rule": "Choose identifier mapping, background, category, multiplicity, similarity and PPI settings from the assay design and declared hypothesis before viewing results.",
        "validation_rule": "Block interpretation if the universe, organism, identifier losses, thresholds, database release, network-size eligibility or MCODE settings are unknown."
      }
    ],
    "postflight_checks": [
      "Reload the report and workbook, reconcile GO/PPI/MCODE tables with XGMML and CYS assets, and verify every PDF, SVG, PNG and digest.",
      "If this task launched Cytoscape, save the editable session, request a normal exit, and verify that the task-owned process terminated; never close a Cytoscape session that was already owned by the user."
    ],
    "preflight_checks": [
      "Confirm lawful MSBio2 access, gene-list provenance, organism, background, identifiers, option schema, output path and Cytoscape availability."
    ],
