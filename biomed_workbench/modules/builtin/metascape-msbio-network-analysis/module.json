          "Validate identifiers and universe, freeze parameters, execute or ingest, and reconcile the full report and network inventory."
        ],
        "template_files": [
          "templates/run_msbio2_metascape_analysis.py"
        ]
      },
      {
        "id": "render-cytoscape-networks",
        "output_artifact_types": [
          "network_figure_bundle"
        ],
        "purpose": "Render Metascape networks consistently through Cytoscape automation.",
