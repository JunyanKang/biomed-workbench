  "preconditions": [
    "Expression values are finite and nonnegative with immutable source counts available; TF identities and species-matched motif resources are declared; pySCENIC rankings span the exact expression gene universe; SCENIC+ receives identical RNA and ATAC cells in identical order plus explicit motif and region-gene evidence; output paths are new."
  ],
  "provenance": {
    "concept_sources": [
      "Project-owned regulatory workflow preserving independent coexpression, motif, region-gene and activity evidence.",
      "https://pyscenic.readthedocs.io/en/stable/",
      "https://scenicplus.readthedocs.io/en/stable/api.html"
    ],
    "license": "Apache-2.0"
  },
  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "Block unless cells, genes, regions, raw counts, transformations, TFs, species, genome build, motif resources, ranking universe, annotations and source digests are explicit and structurally valid.",
      "id": "regulatory-input-and-resource-semantics",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Retain GRNBoost2 adjacency, coexpression modules, motif enrichment and pruned regulons as distinct evidence layers; do not relabel coexpression as motif-supported regulation.",
      "id": "regulatory-grn-and-motif-separation",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "AUCell must score every source cell against every admitted regulon with finite output and declared ranking/AUC parameters.",
      "id": "regulatory-aucell-accounting",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Every SCENIC+ eRegulon requires explicit TF, motif, region, region-gene and TF-gene evidence and minimum unique gene and region targets.",
      "id": "regulatory-eregulon-evidence",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "SCENIC+ RNA and ATAC matrices must retain exactly the same unique cells in the same order; silent intersections, reordering and missing-modality imputation are prohibited.",
      "id": "regulatory-paired-modality-accounting",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "pySCENIC regulons and SCENIC+ eRegulons remain method-specific evidence; causal, condition-level and lineage claims require independent perturbation, replication or temporal support.",
      "id": "regulatory-method-and-claim-boundary",
      "severity": "major"
    },
    {
      "blocks_interpretation": true,
      "description": "Reload every output and reconcile cells, features, regulons, eRegulons, parameters, versions, resources, source hashes and output hashes before admission.",
      "id": "regulatory-source-and-output-reload",
      "severity": "fatal"
    }
  ],
  "questions": [
    "Which TF-target regulons and paired RNA-accessibility eRegulons are supported by explicit coexpression, motif, region-gene, and cell-level activity evidence?"
  ],
