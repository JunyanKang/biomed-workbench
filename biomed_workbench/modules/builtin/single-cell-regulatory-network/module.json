{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not guess TFs, silently intersect cells or features, substitute unmatched motif resources, overwrite source counts, invent missing motif or region-gene evidence, or tune against desired labels.",
      "Do not collapse pySCENIC and SCENIC+ scores, call coexpression direct binding, call eRegulon concordance causality, or report generated or unreloaded outputs as evidence."
    ],
    "languages": [
      "python",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "species",
          "genome build",
          "gene identifiers",
          "region identifiers",
          "motif collection",
          "ranking universe"
        ],
        "id": "regulatory-resource-selection",
        "parameter": "ranking-and-motif-resources",
        "selection_rule": "Use only versioned species- and genome-matched resources whose gene universe and coordinate system are explicitly reconciled to the project.",
        "validation_rule": "Hash every resource and block missing genes, invalid rankings, unresolved coordinates or annotation-free motifs."
      },
      {
        "decision_inputs": [
          "RNA-only question",
          "paired RNA-ATAC availability",
          "motif evidence",
          "region-gene evidence"
        ],
        "id": "regulatory-backend-selection",
        "parameter": "backend",
        "selection_rule": "Use pySCENIC for expression-based motif-pruned regulons and SCENIC+ only when paired chromatin and complete eRegulon evidence exist.",
        "validation_rule": "Keep each backend's outputs separate and report disagreement."
      }
    ],
    "postflight_checks": [
      "Reload and reconcile every source and output artifact, cell, feature, regulon, target, signature, parameter, version and digest.",
      "Review regulon target support, motif enrichment, AUCell coverage, gene-region concordance and claim scope before downstream use."
    ],
    "preflight_checks": [
      "Inspect matrices, raw counts, cells, feature identifiers, transformations, TFs, species, genome build, motif resources, ranking permutations, eRegulon evidence and output paths.",
      "Detect exact pySCENIC, SCENIC+, Python and dependency versions in existing runtimes and require a validated compatibility profile."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
      "input-sha256",
      "TF-resource-sha256",
      "motif-ranking-sha256",
      "motif-annotation-sha256",
      "eregulon-evidence-sha256",
      "species",
      "genome-build",
      "parameters",
      "actual-tool-versions",
      "output-sha256",
      "quality-gates"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "inspect-regulatory-contract",
        "output_artifact_types": [
          "single_cell_regulatory_network_evidence"
        ],
        "purpose": "Establish cells, matrices, TFs, resources and claim scope.",
        "required_logic": [
          "Inspect actual expression and accessibility objects, raw counts, transformations, cells, features, species, genome build, TF list, ranking universe, motif annotations, region-gene evidence and digests.",
          "Freeze backend-specific parameters and evidence fields before execution."
        ],
        "template_files": [
          "templates/run_grnboost2_programs.py",
          "templates/run_pyscenic.py",
          "templates/score_scenicplus_eregulons.py"
        ]
      },
      {
        "id": "infer-pre-motif-programs",
        "output_artifact_types": [
          "single_cell_regulatory_network_evidence"
        ],
        "purpose": "Infer reviewable TF coexpression programs when production motif resources are not yet available.",
        "required_logic": [
          "Run GRNBoost2 and AUCell with a declared TF list while withholding evaluation labels and retain complete adjacency, target-weight and cell-activity evidence.",
          "Label outputs as coexpression programs, not motif-pruned regulons, and require species-matched cisTarget resources before promotion to regulons."
        ],
        "template_files": [
          "templates/run_grnboost2_programs.py"
        ]
      },
      {
        "id": "infer-pyscenic-regulons",
        "output_artifact_types": [
          "single_cell_regulatory_network_evidence"
        ],
        "purpose": "Infer coexpression and motif-pruned regulons.",
        "required_logic": [
          "Run GRNBoost2 with a bounded in-process Dask client, retain complete adjacencies, construct coexpression modules and prune them against the exact declared cisTarget ranking and annotation resources.",
          "Construct regulons and score every cell with AUCell while retaining target weights, motif contexts and parameters."
        ],
        "template_files": [
          "templates/run_pyscenic.py"
        ]
      },
      {
        "id": "score-scenicplus-eregulons",
        "output_artifact_types": [
          "single_cell_regulatory_network_evidence"
        ],
        "purpose": "Score paired RNA and chromatin eRegulon activity.",
        "required_logic": [
          "Require exact paired cells plus explicit TF, gene, region, motif, region-gene and TF-gene evidence for every eRegulon row.",
          "Score gene- and region-based signatures independently and retain their per-eRegulon concordance rather than averaging them."
        ],
        "template_files": [
          "templates/score_scenicplus_eregulons.py"
        ]
      },
      {
        "id": "reload-and-admit",
        "output_artifact_types": [
          "single_cell_regulatory_network_evidence"
        ],
        "purpose": "Verify source preservation and regulatory evidence boundaries.",
        "required_logic": [
          "Reload all adjacency, coexpression-program, enrichment, regulon, gene-AUC, region-AUC, concordance and validated-eRegulon outputs and reconcile source hashes.",
          "Admit method-specific association evidence only; require independent experiments or replicated temporal evidence for causal claims."
        ],
        "template_files": [
          "templates/run_grnboost2_programs.py",
          "templates/run_pyscenic.py",
          "templates/score_scenicplus_eregulons.py"
        ]
      }
    ]
  },
  "alternatives": [
    "single-cell-marker-discovery"
  ],
  "assumptions": [
    "GRNBoost2 edges are predictive coexpression, cisTarget adds motif-enrichment support, AUCell estimates relative cell-level signature activity, and SCENIC+ scores supplied evidence-backed eRegulons; none alone proves direct binding, enhancer causality, or condition-level regulation."
