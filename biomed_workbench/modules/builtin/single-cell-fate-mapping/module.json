        "required_logic": [
          "Inspect immutable expression and its declared semantics, any state and velocity matrices, neighborhood representation, samples, ordered time, pseudotime provenance, terminal evidence, feature namespace, cell accounting, and source digest.",
          "Freeze kernel mode, connectivity weight, neighborhood, optimal-transport regularization, terminal cells, and quality thresholds before execution."
        ],
        "template_files": [
          "templates/run_cellrank_fate.py"
        ]
      },
      {
        "id": "fit-kernel-and-fates",
        "output_artifact_types": [
          "single_cell_fate_evidence"
        ],
        "purpose": "Execute separate transition kernels and GPCCA fate estimation.",
        "required_logic": [
          "Build a velocity kernel from explicitly named RegVelo or scVelo state and velocity matrices, optionally combine it with a separately weighted connectivity kernel, build a pseudotime kernel, or solve adjacent moscot temporal couplings and convert them to a RealTimeKernel.",
          "Require row-stochastic transitions, assign declared terminal cells, compute fate probabilities without PETSc dependence, and retain lineage-driver statistics."
        ],
        "template_files": [
          "templates/run_cellrank_fate.py"
        ]
      },
      {
        "id": "validate-and-reload",
        "output_artifact_types": [
          "single_cell_fate_evidence"
        ],
        "purpose": "Check withheld direction, terminal consistency, sensitivity, source preservation, and serialization.",
        "required_logic": [
          "Test expected withheld experimental-time or pseudotime transition deltas and report clamped terminal-state consistency without treating it as independent validation.",
          "Compare justified kernel or connectivity-weight variants without averaging them, then reload H5AD and evidence tables and reconcile every cell, expression value, transition, fate, driver, parameter, and version."
        ],
        "template_files": [
          "templates/run_cellrank_fate.py"
        ]
      }
    ]
