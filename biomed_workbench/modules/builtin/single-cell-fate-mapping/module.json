  "agent_protocol": {
    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not round continuous expression, guess state or velocity semantics, guess terminal states, tune kernels to desired fates, average incompatible kernels, or claim fate probabilities prove ancestry.",
      "Do not treat clamped terminal-cell fate of one as independent validation.",
      "Do not overwrite source expression or report generated or unreloaded outputs as evidence."
    ],
    "languages": [
      "python",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "velocity provenance",
          "state semantics",
          "experimental time",
          "pseudotime evidence",
          "sampling design",
          "time-point coverage"
        ],
        "id": "fate-kernel",
        "parameter": "kernel-mode",
        "selection_rule": "Use velocity only with an admitted velocity field and withheld direction evidence, pseudotime for a validated continuous ordering, and moscot for observed replicated time-point transport; run justified alternatives as sensitivity models.",
        "validation_rule": "Never average kernel outputs or conceal disagreement."
      },
      {
        "decision_inputs": [
          "velocity confidence",
          "neighborhood stability",
          "terminal-state sensitivity"
        ],
        "id": "velocity-connectivity-weight",
        "parameter": "connectivity-weight",
        "selection_rule": "Freeze a pure velocity primary analysis and one biologically justified nonzero connectivity sensitivity weight before viewing fate outcomes.",
        "validation_rule": "Report fate and direction changes between weights; do not select a weight because it produces desired biology."
      }
    ],
    "postflight_checks": [
      "Recompute transition and fate row sums, withheld direction, terminal-state consistency, and any declared kernel sensitivity.",
      "Reload all objects and tables and preserve method-specific outputs and source expression exactly."
    ],
    "preflight_checks": [
      "Inspect actual object, expression location and semantics, velocity and state layers, representation, samples, time, pseudotime, terminal-state cells, neighbors, source digest, and output paths.",
      "Detect exact CellRank, moscot, Scanpy, AnnData, NumPy, pandas, SciPy, JAX, OTT-JAX, and Python versions in an existing runtime.",
      "On macOS, execute the template from a real script guarded by a main entry because CellRank kernel coordination uses multiprocessing spawn."
    ],
