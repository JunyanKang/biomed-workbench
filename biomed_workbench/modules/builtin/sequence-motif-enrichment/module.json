{
  "schema_version": 1,
  "id": "sequence-motif-enrichment",
  "version": "0.1.0",
  "title": "Test known sequence motif enrichment",
  "description": "Scan declared foreground and background DNA sequences against versioned known PWM motifs, test per-sequence enrichment, and preserve threshold, background, and provenance boundaries.",
  "module_type": "analysis",
  "domains": ["omics", "epigenomics"],
  "intents": ["known motif enrichment", "PWM motif enrichment", "peak sequence motif enrichment", "JASPAR motif enrichment", "\u8f6c\u5f55\u56e0\u5b50 motif \u5bcc\u96c6"],
  "questions": ["Which declared known PWM motifs occur more often in the declared foreground sequence set than in the declared background under a frozen bidirectional scanning threshold?"],
  "entrypoint": "biomed_workbench.capabilities.epigenomics:sequence_motif_enrichment",
  "execution": {"kind": "service", "timeout_seconds": 60, "max_output_bytes": 10000000},
  "maturity": "validated",
  "input_artifacts": [
    {"name": "foreground_sequences", "artifact_type": "genomic_sequence_set", "processing_levels": ["declared-foreground"], "required_metadata": ["source-sha256", "genome-build", "sequence-extraction-policy", "coordinate-system"], "formats": [{"name": "fasta", "versions": ["1"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["zero-based-half-open-source-intervals"], "genome_build_policy": "declared", "genome_builds": ["declared-in-project"], "annotation_releases": [], "orientations": ["records-by-sequence"]}]},
    {"name": "background_sequences", "artifact_type": "genomic_sequence_set", "processing_levels": ["declared-background"], "required_metadata": ["source-sha256", "genome-build", "sequence-extraction-policy", "matching-policy"], "formats": [{"name": "fasta", "versions": ["1"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["zero-based-half-open-source-intervals"], "genome_build_policy": "declared", "genome_builds": ["same-as-foreground"], "annotation_releases": [], "orientations": ["records-by-sequence"]}]},
    {"name": "pwm_collection", "artifact_type": "motif_pwm_collection", "processing_levels": ["versioned"], "required_metadata": ["source-sha256", "motif-database-release", "species-or-taxonomic-scope", "matrix-orientation"], "formats": [{"name": "normalized-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["declared-motif-release"], "orientations": ["base-by-position"]}]}
  ],
  "output_artifacts": [{"name": "motif_enrichment_evidence", "artifact_type": "sequence_motif_enrichment_evidence", "processing_levels": ["scanned", "multiple-testing-adjusted", "reloaded"], "required_metadata": ["module-version", "foreground-sha256", "background-sha256", "pwm-collection-sha256", "genome-build", "background-policy", "score-threshold", "statistical-method", "output-sha256", "quality-gates"], "formats": [{"name": "normalized-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["inherited-source-interval-coordinate-system"], "genome_build_policy": "declared", "genome_builds": ["inherited-from-foreground"], "annotation_releases": ["inherited-from-pwm-collection"], "orientations": ["motif-by-enrichment-result"]}] }],
  "preconditions": ["Foreground and background sequences derive from the same declared genome build and extraction policy; their record identifiers do not overlap; the background-matching rationale, PWM release, score threshold, and multiple-testing family are declared before analysis."],
  "assumptions": ["A per-sequence PWM hit is a sequence-level proxy and bidirectional scan is appropriate for the declared motif orientation; the supplied background is a valid comparator for the scientific question."],
  "quality_gates": [
    {"id": "motif-sequence-background-contract", "severity": "fatal", "description": "Block unless foreground and background sequence identities, build, extraction policy, digests and non-overlap are explicit; do not auto-create a background sequence universe.", "blocks_interpretation": true},
    {"id": "motif-pwm-and-statistical-validity", "severity": "fatal", "description": "Require unique valid A/C/G/T PWM matrices, a frozen normalized score threshold, bidirectional sequence scanning, per-sequence hit accounting, Fisher exact enrichment and declared Benjamini-Hochberg correction.", "blocks_interpretation": true},
    {"id": "motif-output-provenance", "severity": "fatal", "description": "Reload the result and reconcile every source digest, motif identifier, score threshold, foreground/background denominator, p value and adjusted p value before interpretation.", "blocks_interpretation": true},
    {"id": "motif-claim-boundary", "severity": "major", "description": "Do not equate PWM enrichment with transcription-factor occupancy, chromatin accessibility, direct binding, target regulation, condition effect, or causal function.", "blocks_interpretation": true}
  ],
  "limitations": ["This module is for known PWM enrichment only. It does not discover de novo motifs, fetch genome sequences, construct a matched background, model positional enrichment, correct for unmeasured sequence bias, infer factor activity, or establish occupancy or causality."],
  "evidence_effects": ["adds-known-pwm-sequence-enrichment-evidence", "preserves-background-and-score-threshold-policy"],
  "alternatives": ["single-cell-atac-regulatory"],
  "complements": ["bulk-chromatin-peak-calling", "single-cell-atac-regulatory", "single-cell-regulatory-network"],
