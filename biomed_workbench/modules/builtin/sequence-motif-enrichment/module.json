  "compatibility_matrix": [{"id": "python-3143-known-pwm-enrichment", "module_version": "0.1.0", "tool_versions": {}, "dependency_versions": {"python": [">=3.14,<3.15"]}, "input_formats": {"foreground_sequences": ["fasta@1"], "background_sequences": ["fasta@1"], "pwm_collection": ["normalized-json@1"]}, "output_formats": {"motif_enrichment_evidence": ["normalized-json@1"]}, "platforms": ["any"], "regression_evidence_ids": ["sequence-motif-enrichment-regression-v1"], "end_to_end_evidence_ids": ["sequence-motif-enrichment-e2e-v1"], "verified_at": "2026-07-23"}],
  "access": "offline",
