  "credentials": [],
  "input_schema": {"type": "object", "additionalProperties": false, "properties": {"foreground_sequences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "background_sequences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}, "motifs": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}, "required": ["foreground_sequences", "background_sequences", "motifs"]},
  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"method": {"type": "string"}, "threshold": {"type": "number"}, "foreground_sequence_count": {"type": "integer"}, "background_sequence_count": {"type": "integer"}, "motif_count": {"type": "integer"}, "results": {"type": "array"}, "limitations": {"type": "array"}}, "required": ["method", "threshold", "foreground_sequence_count", "background_sequence_count", "motif_count", "results", "limitations"]},
  "kernel_compatibility": [">=0.2.0,<0.3.0"],
