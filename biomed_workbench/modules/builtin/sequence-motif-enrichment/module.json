  "code_templates": [{"path": "templates/run_sequence_motif_enrichment.py", "language": "python", "purpose": "Execute and reload known-PWM sequence enrichment with source provenance.", "quality_gate_ids": ["motif-sequence-background-contract", "motif-pwm-and-statistical-validity", "motif-output-provenance", "motif-claim-boundary"], "requires_adaptation": false}]
