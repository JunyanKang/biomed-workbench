{
  "schema_version": 1,
  "id": "dna-align-bwa-mem-single",
  "version": "1.0.0",
  "title": "Align single-end DNA reads with BWA-MEM",
  "description": "Guide and execute single-end short-read DNA alignment against a declared BWA reference bundle while preserving sample read-group identity and a portable SAM artifact.",
  "module_type": "transform",
  "domains": ["omics"],
  "intents": ["align single-end DNA reads", "run BWA-MEM", "FASTQ to SAM", "单端DNA测序比对"],
  "questions": ["How should declared single-end DNA reads be aligned to the project reference while preserving sample identity and reference provenance for downstream validation?"],
  "maturity": "validated",
  "entrypoint": "scientific-command",
  "input_schema": {"type": "object", "additionalProperties": false, "properties": {"threads": {"type": "integer", "minimum": 1, "maximum": 32}, "sample-id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}}, "required": ["threads", "sample-id"]},
  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"payload_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1}}, "required": ["payload_roles"]},
  "input_artifacts": [
    {"name": "reads", "artifact_type": "sequencing_reads", "formats": [{"name": "fastq", "versions": ["sanger-phred33"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["single-end"]}], "processing_levels": ["raw", "adapter-trimmed", "quality-trimmed"], "required_metadata": ["sample-id", "sample-manifest-digest", "read-layout", "quality-encoding"]},
    {"name": "reference", "artifact_type": "bwa_reference_bundle", "formats": [{"name": "bwa-reference", "versions": ["0.7"], "representations": ["container", "binary"], "compression": ["zip"], "required_indexes": ["amb", "ann", "bwt", "pac", "sa"], "coordinate_systems": ["one-based-leftmost"], "genome_build_policy": "required", "genome_builds": ["declared-in-project"], "annotation_releases": [], "orientations": ["fasta-with-bwa-index-prefix"]}], "processing_levels": ["indexed-reference"], "required_metadata": ["reference-build", "reference-sequence-digest", "reference-manifest-digest", "sequence-dictionary", "bwa-index-version"]}
  ],
  "output_artifacts": [{"name": "alignments", "artifact_type": "sequence_alignments", "formats": [{"name": "sam", "versions": ["1.6"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["one-based-leftmost"], "genome_build_policy": "required", "genome_builds": ["inherited-matching-input-build"], "annotation_releases": [], "orientations": ["alignment-records"]}], "processing_levels": ["aligned"], "required_metadata": ["module_version", "compatibility_row_id", "sample-id", "read-group", "reference-build", "reference-sequence-digest", "sort-order"]}],
  "assumptions": ["Reads are single-end DNA short reads with Sanger Phred+33 qualities, and the reference FASTA plus all BWA index files were generated from the same declared sequence payload."],
  "preconditions": ["FASTQ structure and sample identity pass shared validation; the reference manifest reconciles FASTA digest, sequence dictionary, build identity, and all BWA index members."],
  "quality_gates": [
    {"id": "bwa-reference-bundle-integrity", "severity": "fatal", "description": "Reference FASTA, sequence dictionary, manifest digest, build identity, and BWA index members must reconcile before alignment.", "blocks_interpretation": true},
    {"id": "bwa-sample-read-group-identity", "severity": "fatal", "description": "The supplied sample identifier must appear consistently in SAM @RG and every alignment record without machine-local command paths.", "blocks_interpretation": true},
    {"id": "bwa-alignment-not-interpretation", "severity": "major", "description": "Raw unsorted SAM is a technical transformation and requires conversion, sorting, indexing, alignment QC, coverage review, and assay-specific interpretation.", "blocks_interpretation": true}
  ],
  "evidence_effects": ["produces_reference_aligned_dna_reads"],
  "alternatives": [],
  "complements": ["read-quality-fastqc", "read-quality-fastp", "read-contamination-screen", "alignment-quality-samtools"],
  "tool_requirements": [{"name": "bwa", "ecosystem": "system", "identity": "bwa", "required": true, "tested_versions": ["0.7.19-r1273"], "allowed_versions": [">=0.7.17,<0.8"], "version_source": "https://github.com/lh3/bwa/releases/tag/v0.7.19", "verified_at": "2026-07-13", "version_probe": ["biomed_workbench.quality.alignment:probe_bwa_version"], "version_probe_kind": "python_callable", "version_probe_timeout_seconds": 10, "version_pattern": "([0-9]+(?:\\.[0-9]+)+-r[0-9]+)", "mismatch_policy": "block", "version_differences": [{"id": "bwa-mem-sam-header-contract", "affected_versions": [">=0.7.17,<0.8"], "category": "output-format", "description": "The supported BWA-MEM line emits the validated SAM header, read-group, program, flag, coordinate, and CIGAR surfaces.", "compatibility_effect": "requires-parser", "required_action": "Validate the produced SAM header, reference dictionary, sample read group, records, and path portability before evidence ingestion.", "source": "https://github.com/lh3/bwa/blob/master/NEWS.md"}], "platforms": ["macos-arm64"]}],
  "dependencies": [{"name": "bwa-homebrew-bottle", "ecosystem": "runtime", "identity": "homebrew-bwa-runtime", "required": true, "tested_versions": ["0.7.19-bottle-arm64"], "allowed_versions": [">=0.7,<0.8"], "version_source": "https://formulae.brew.sh/formula/bwa", "verified_at": "2026-07-13", "version_probe": ["biomed_workbench.quality.alignment:probe_bwa_homebrew_bottle"], "version_probe_kind": "python_callable", "version_probe_timeout_seconds": 10, "version_pattern": "([0-9]+(?:\\.[0-9]+)+-bottle-arm64)", "purpose": "Record the validated macOS-arm64 BWA installation identity without managing the user's software environment.", "conflicts": [], "platforms": ["macos-arm64"]}],
  "compatibility_matrix": [{"id": "bwa-mem-0.7-single-fastq-sam", "module_version": "1.0.0", "tool_versions": {"bwa": [">=0.7.17,<0.8"]}, "dependency_versions": {"bwa-homebrew-bottle": [">=0.7,<0.8"]}, "input_formats": {"reads": ["fastq@sanger-phred33"], "reference": ["bwa-reference@0.7"]}, "output_formats": {"alignments": ["sam@1.6"]}, "platforms": ["macos-arm64"], "regression_evidence_ids": ["dna-align-bwa-mem-single-regression-v1"], "end_to_end_evidence_ids": ["dna-align-bwa-mem-single-e2e-v1"], "verified_at": "2026-07-13"}],
  "execution": {"kind": "command", "timeout_seconds": 300, "max_output_bytes": 50000000, "command": {"tool_name": "bwa", "executable": "bwa", "arguments": ["mem", "-t", "{parameter:threads}", "-R", "@RG\\tID:{parameter:sample-id}\\tSM:{parameter:sample-id}\\tPL:ILLUMINA", "{input:reference}", "{input:reads}"], "inputs": [{"name": "reads", "port": "reads", "role": "reads", "filename": "reads.fastq"}, {"name": "reference", "port": "reference", "role": "reference", "filename": "reference-bundle", "materialization": "zip-directory", "member": "reference.fa"}], "outputs": [{"name": "alignments", "port": "alignments", "role": "alignments", "filename": "alignments.sam", "media_type": "text/sam", "capture": "stdout"}], "parameter_names": ["threads", "sample-id"], "timeout_seconds": 300, "max_output_bytes": 50000000, "max_payload_bytes": 50000000, "path_mode": "workdir-relative"}},
  "access": "offline", "mutability": "read_only", "credentials": [],
  "limitations": ["The current module covers single-end short-read DNA alignment and emits unsorted SAM; paired-end reads, long reads, RNA splicing, ALT-aware post-processing, duplicate handling, sorted BAM production, and biological interpretation require separate modules."],
  "kernel_compatibility": [">=0.2.0,<0.3.0"],
  "provenance": {"license": "GPL-3.0-or-later", "concept_sources": ["https://github.com/lh3/bwa"]}
}
