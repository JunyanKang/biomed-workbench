  "execution": {
    "command": {
      "arguments": [
        "mem",
        "-t",
        "{parameter:threads}",
        "-R",
        "@RG\\tID:{parameter:sample-id}\\tSM:{parameter:sample-id}\\tPL:ILLUMINA",
        "{input:reference}",
        "{input:reads}"
