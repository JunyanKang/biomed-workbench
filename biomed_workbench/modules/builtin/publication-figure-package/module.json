{
  "schema_version": 1,
  "id": "publication-figure-package",
  "version": "1.0.0",
  "title": "Render a source-data-bound publication figure package",
  "description": "Render an explicit multi-panel scientific figure specification against registered CSV or TSV data without guessing column roles, silently discarding rows, running undeclared statistics, or reusing example pixels; deliver exact-size PDF, editable SVG, high-resolution PNG, panel source tables, a frozen specification, digests, and an independently reloaded quality report.",
  "module_type": "delivery",
  "domains": ["publication", "scientific-communication", "visualization"],
  "intents": [
    "render publication figure package",
    "create a multi-panel scientific figure from source data",
    "export PDF SVG PNG with plotting data",
    "publication-ready scientific plotting",
    "生成带作图数据和质量报告的科研图件"
  ],
  "questions": [
    "Can this explicit panel specification be rendered from the registered source table without row loss, undeclared inference, or loss of editable vector text?"
  ],
  "entrypoint": "scientific-command",
  "execution": {
    "kind": "command",
    "timeout_seconds": 600,
    "max_output_bytes": 250000000,
    "command": {
      "tool_name": "python3",
      "executable": "python3",
      "implementation_module": "biomed_workbench.implementations.publication_figure",
      "arguments": [
        "{implementation}",
        "--data", "{input:data}",
        "--spec", "{input:spec}",
        "--package", "{output:package}",
        "--report", "{output:report}",
        "--data-format", "{parameter:data-format}"
      ],
      "inputs": [
        {"name": "data", "port": "figure_data", "role": "data", "filename": "figure-data.table"},
        {"name": "spec", "port": "figure_specification", "role": "specification", "filename": "figure-specification.json"}
      ],
      "outputs": [
        {"name": "package", "port": "figure_package", "role": "package", "filename": "publication-figure-package.zip", "media_type": "application/zip"},
        {"name": "report", "port": "figure_quality_report", "role": "report", "filename": "publication-figure-report.json", "media_type": "application/json"}
      ],
      "parameter_names": ["data-format"],
      "timeout_seconds": 600,
      "max_output_bytes": 250000000,
      "max_payload_bytes": 250000000,
      "path_mode": "workdir-relative"
    }
  },
  "maturity": "validated",
  "input_artifacts": [
    {
      "name": "figure_data",
      "artifact_type": "scientific_figure_source_table",
      "formats": [
        {"name": "csv", "versions": ["rfc4180"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["header-row-records"]},
        {"name": "tab-separated-values", "versions": ["1"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["header-row-records"]}
      ],
      "processing_levels": ["tested", "reviewed", "panel-mapped"],
      "required_metadata": ["source-artifact", "source-sha256", "row-count", "column-semantics", "units", "missing-data-policy"],
      "source_policy": "project_or_upstream"
    },
    {
      "name": "figure_specification",
      "artifact_type": "figure_specification",
      "formats": [
        {"name": "json", "versions": ["1"], "representations": ["structured", "text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["closed-panel-contract"]}
      ],
      "processing_levels": ["declared", "reviewed"],
      "required_metadata": ["claim-per-panel", "explicit-column-mapping", "final-size", "journal-profile"],
      "source_policy": "project_or_upstream"
    }
  ],
  "output_artifacts": [
    {
      "name": "figure_package",
      "artifact_type": "publication_figure_package",
      "formats": [
        {"name": "zip", "versions": ["6.3.10"], "representations": ["binary", "container"], "compression": ["deflate"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["figure-source-data-manifest"]}
      ],
      "processing_levels": ["rendered", "reloaded", "digest-bound"],
      "required_metadata": ["module-version", "style-version", "input-digests", "panel-source-digests", "pdf-svg-png-digests", "final-dimensions"],
      "source_policy": "project_or_upstream"
    },
    {
      "name": "figure_quality_report",
      "artifact_type": "quality_report",
      "formats": [
        {"name": "json", "versions": ["1"], "representations": ["structured", "text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["rendering-quality-report"]}
      ],
      "processing_levels": ["derived", "reloaded", "review-required"],
      "required_metadata": ["module-version", "package-sha256", "row-coverage", "container-reload", "runtime-versions", "limitations"],
      "source_policy": "project_or_upstream"
    }
  ],
  "preconditions": [
    "The source table has reviewed scientific meanings, units, experimental-unit boundaries, missing-data decisions, and upstream statistics before rendering.",
    "Every panel declares a unique identifier, one bounded claim, an explicit plot type, exact column mappings, any explicit row-selection equality, final dimensions, and an allowed journal profile.",
    "Cell and Science submission profiles require the current target-journal guide to be implemented as a separately validated profile before export is represented as submission-ready."
  ],
  "assumptions": [
    "The registered table contains the exact data intended for display; the renderer preserves and validates those rows but does not repair, reinterpret, or scientifically validate upstream analysis."
  ],
  "quality_gates": [
    {"id": "figure-explicit-scientific-mapping", "severity": "fatal", "description": "Every panel must have one claim, supported plot type, explicit columns, declared row selection, labels and units; semantic column guessing, example-pixel embedding and manual template edits are prohibited.", "blocks_interpretation": true},
    {"id": "figure-source-data-row-integrity", "severity": "fatal", "description": "Every registered input row must be assigned to at least one panel, every plotted row must retain its source-row identity, and every panel source table must reload without missing or duplicated rows.", "blocks_interpretation": true},
    {"id": "figure-final-size-container-reload", "severity": "fatal", "description": "PDF, SVG and PNG must match declared final dimensions, reopen successfully, retain required editable vector text, and preserve the declared raster resolution.", "blocks_interpretation": true},
    {"id": "figure-statistical-reporting-boundary", "severity": "fatal", "description": "The renderer performs no inferential test; any statistical context must explicitly identify experimental unit, biological n, test, multiplicity, effect size and uncertainty, while negative and discordant results remain valid display inputs.", "blocks_interpretation": true},
    {"id": "figure-rendered-visual-review", "severity": "major", "description": "Automated label-overlap checks must pass and the actual final-size rendering still requires human review for clipping, hierarchy, axes, colors, legends, density, accessibility and claim adequacy.", "blocks_interpretation": true}
  ],
  "limitations": [
    "The validated renderer covers scatter, line, precomputed bar, box, violin, heatmap and volcano-style panels from explicit CSV or TSV columns. It does not replace method-native diagnostic plots, imaging integrity review, statistical analysis, illustration generation, three-dimensional rendering, interactive graphics, or target-journal production review.",
    "Passing delivery checks establishes that this package can be regenerated and inspected; it does not establish the validity of upstream data, analysis, biological interpretation, diagnosis, mechanism, or causal inference."
  ],
  "evidence_effects": [
    "produces-source-data-bound-publication-figure-package",
    "validates-final-size-vector-raster-delivery",
    "does-not-create-or-upgrade-biological-evidence"
  ],
  "alternatives": [],
  "complements": ["figure-specification", "statistical-reporting-audit", "manuscript-audit"],
  "tool_requirements": [
    {
      "name": "python3", "ecosystem": "system", "identity": "python3", "required": true,
      "tested_versions": ["3.14.3"], "allowed_versions": [">=3.14,<3.15"],
      "version_source": "https://www.python.org/downloads/release/python-3143/", "verified_at": "2026-08-24",
      "version_probe": ["python3", "--version"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10,
      "version_pattern": "Python ([0-9]+(?:\\.[0-9]+)+)", "mismatch_policy": "block",
      "version_differences": [{"id": "python-314-publication-figure-command", "affected_versions": [">=3.14,<3.15"], "category": "behavior", "description": "The validated command, deterministic serialization, and package construction execute under Python 3.14 semantics.", "compatibility_effect": "requires-parser", "required_action": "Re-run the information-dense rendering acceptance before changing the Python compatibility line.", "source": "https://docs.python.org/3.14/"}],
      "platforms": ["macos-arm64", "linux-x86_64"]
    }
  ],
  "dependencies": [
    {"name": "matplotlib", "ecosystem": "python", "identity": "matplotlib", "required": true, "tested_versions": ["3.10.8"], "allowed_versions": [">=3.10,<3.11"], "version_source": "https://matplotlib.org/stable/api/index.html", "verified_at": "2026-08-24", "version_probe": ["python3", "-c", "import matplotlib; print(matplotlib.__version__)"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "([0-9]+(?:\\.[0-9]+)+)", "purpose": "Render exact-size PDF, editable SVG, and high-resolution PNG panels.", "conflicts": [], "platforms": ["macos-arm64", "linux-x86_64"]},
    {"name": "pandas", "ecosystem": "python", "identity": "pandas", "required": true, "tested_versions": ["2.3.3", "3.0.5"], "allowed_versions": [">=2.3,<3.1"], "version_source": "https://pandas.pydata.org/docs/", "verified_at": "2026-08-24", "version_probe": ["python3", "-c", "import pandas; print(pandas.__version__)"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "([0-9]+(?:\\.[0-9]+)+)", "purpose": "Read, subset by explicit equality contracts, validate, and export panel source tables.", "conflicts": [], "platforms": ["macos-arm64", "linux-x86_64"]},
    {"name": "numpy", "ecosystem": "python", "identity": "numpy", "required": true, "tested_versions": ["2.4.4"], "allowed_versions": [">=2.4,<2.5"], "version_source": "https://numpy.org/doc/stable/", "verified_at": "2026-08-24", "version_probe": ["python3", "-c", "import numpy; print(numpy.__version__)"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "([0-9]+(?:\\.[0-9]+)+)", "purpose": "Validate finite numeric vectors and construct deterministic plotting coordinates.", "conflicts": [], "platforms": ["macos-arm64", "linux-x86_64"]},
    {"name": "Pillow", "ecosystem": "python", "identity": "PIL", "required": true, "tested_versions": ["10.4.0", "12.1.1"], "allowed_versions": [">=10.4,<13"], "version_source": "https://pillow.readthedocs.io/en/stable/", "verified_at": "2026-08-24", "version_probe": ["python3", "-c", "import PIL; print(PIL.__version__)"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "([0-9]+(?:\\.[0-9]+)+)", "purpose": "Reload and verify PNG dimensions, mode, and raster delivery.", "conflicts": [], "platforms": ["macos-arm64", "linux-x86_64"]},
    {"name": "PyMuPDF", "ecosystem": "python", "identity": "fitz", "required": true, "tested_versions": ["1.27.2", "1.28.0"], "allowed_versions": [">=1.27,<1.29"], "version_source": "https://pymupdf.readthedocs.io/en/latest/", "verified_at": "2026-08-24", "version_probe": ["python3", "-c", "import fitz; print(fitz.VersionBind)"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "([0-9]+(?:\\.[0-9]+)+)", "purpose": "Reload PDF pages, final dimensions, editable text, and font records.", "conflicts": [], "platforms": ["macos-arm64", "linux-x86_64"]}
  ],
  "compatibility_matrix": [
    {
      "id": "python314-matplotlib310-publication-figure-v1",
      "module_version": "1.0.0",
      "tool_versions": {"python3": [">=3.14,<3.15"]},
      "dependency_versions": {"matplotlib": [">=3.10,<3.11"], "pandas": [">=2.3,<3.1"], "numpy": [">=2.4,<2.5"], "Pillow": [">=10.4,<13"], "PyMuPDF": [">=1.27,<1.29"]},
      "input_formats": {"figure_data": ["csv@rfc4180", "tab-separated-values@1"], "figure_specification": ["json@1"]},
      "output_formats": {"figure_package": ["zip@6.3.10"], "figure_quality_report": ["json@1"]},
      "platforms": ["macos-arm64", "linux-x86_64"],
