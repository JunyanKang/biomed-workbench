  "output_schema": {"type": "object", "additionalProperties": false, "properties": {"payload_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1}}, "required": ["payload_roles"]},
  "input_artifacts": [
    {"name": "query_intervals", "artifact_type": "genomic_intervals", "formats": [{"name": "bed", "versions": ["1.0"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["zero-based-half-open"], "genome_build_policy": "required", "genome_builds": ["declared-in-project"], "annotation_releases": [], "orientations": ["interval-records"]}], "processing_levels": ["features", "peaks", "regions", "fragments"], "required_metadata": ["bed-field-count", "reference-build", "reference-sequence-digest", "sort-order", "sample-manifest-digest"]},
    {"name": "reference_intervals", "artifact_type": "genomic_intervals", "formats": [{"name": "bed", "versions": ["1.0"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["zero-based-half-open"], "genome_build_policy": "required", "genome_builds": ["declared-in-project"], "annotation_releases": [], "orientations": ["interval-records"]}], "processing_levels": ["features", "peaks", "regions"], "required_metadata": ["bed-field-count", "reference-build", "reference-sequence-digest", "sort-order", "source-release"]}
  ],
  "output_artifacts": [{"name": "overlaps", "artifact_type": "interval_overlap_pairs", "formats": [{"name": "bedtools-intersect-tsv", "versions": ["2.31.1"], "representations": ["text"], "compression": ["none"], "required_indexes": [], "coordinate_systems": ["zero-based-half-open"], "genome_build_policy": "required", "genome_builds": ["inherited-matching-input-build"], "annotation_releases": [], "orientations": ["query-fields-then-reference-fields"]}], "processing_levels": ["derived"], "required_metadata": ["module_version", "compatibility_row_id", "query-bed-field-count", "reference-bed-field-count", "reference-build"]}],
