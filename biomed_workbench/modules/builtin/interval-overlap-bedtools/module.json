  "domains": ["omics"],
  "intents": ["intersect genomic intervals", "bedtools intersect", "compare peaks and regions", "基因组区间取交集"],
  "questions": ["Which declared query and reference intervals overlap geometrically on the same reference assembly, and what is the bounded pairwise overlap extent?"],
  "maturity": "validated",
  "entrypoint": "scientific-command",
