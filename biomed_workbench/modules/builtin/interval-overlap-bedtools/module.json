  "dependencies": [{"name": "xz", "ecosystem": "runtime", "identity": "xz-runtime", "required": true, "tested_versions": ["5.8.3"], "allowed_versions": [">=5.8,<5.9"], "version_source": "https://github.com/tukaani-project/xz/releases/tag/v5.8.3", "verified_at": "2026-07-12", "version_probe": ["xz", "--version"], "version_probe_kind": "command", "version_probe_timeout_seconds": 10, "version_pattern": "XZ Utils\\) ([0-9]+(?:\\.[0-9]+)+)", "purpose": "Provide the exact liblzma runtime declared by the validated Homebrew bedtools bottle.", "conflicts": [], "platforms": ["macos-arm64"]}],
  "compatibility_matrix": [{"id": "bedtools-2.31.1-xz-5.8.3-bed-1.0-wa-wb", "module_version": "1.0.0", "tool_versions": {"bedtools": [">=2.31,<2.32"]}, "dependency_versions": {"xz": [">=5.8,<5.9"]}, "input_formats": {"query_intervals": ["bed@1.0"], "reference_intervals": ["bed@1.0"]}, "output_formats": {"overlaps": ["bedtools-intersect-tsv@2.31.1"]}, "platforms": ["macos-arm64"], "regression_evidence_ids": ["interval-overlap-bedtools-regression-v1"], "end_to_end_evidence_ids": ["interval-overlap-bedtools-e2e-v1"], "verified_at": "2026-07-12"}],
  "execution": {"kind": "command", "timeout_seconds": 120, "max_output_bytes": 10000000, "command": {"tool_name": "bedtools", "executable": "bedtools", "arguments": ["intersect", "-a", "{input:query}", "-b", "{input:reference}", "-wa", "-wb"], "inputs": [{"name": "query", "port": "query_intervals", "role": "query", "filename": "query.bed"}, {"name": "reference", "port": "reference_intervals", "role": "reference", "filename": "reference.bed"}], "outputs": [{"name": "overlaps", "port": "overlaps", "role": "overlaps", "filename": "overlaps.tsv", "media_type": "text/tab-separated-values", "capture": "stdout"}], "parameter_names": [], "timeout_seconds": 120, "max_output_bytes": 10000000, "max_payload_bytes": 10000000}},
  "access": "offline", "mutability": "read_only", "credentials": [],
