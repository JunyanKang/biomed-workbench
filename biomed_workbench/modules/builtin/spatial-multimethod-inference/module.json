    ],
    "license": "Apache-2.0"
  },
  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "Require shared gene namespace, raw counts, one spatial sample per fit, reference labels/batches, signatures, uncertainty or residual diagnostics, held-out-gene assessment and explicit proportion, abundance or mapping-probability semantics.",
      "id": "deconvolution-reference-contract",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Separate spot mixture deconvolution from cell-to-space mapping; call JSD accuracy only against independent or simulated truth and otherwise report concordance; never interpret super-resolution or mapped cells as directly observed cells.",
      "id": "projection-truth-and-resolution-contract",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Fit BayesSpace, SpaGCN and STAGATE without reviewed biological labels; compare at least three seeds using stability, coherence, fragmentation, runtime and discordance; labels enter only post hoc.",
      "id": "domain-label-blind-benchmark",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require a positive physical-distance threshold, sample-separated graphs, versioned LR database, heteromeric policy, global multiplicity control and biological-sample support.",
      "id": "communication-distance-and-replicates",
      "severity": "fatal"
    }
  ],
  "questions": [
    "Which spot-deconvolution or cell-to-space projection method matches the platform, resolution and biological question; which estimates survive reference, held-out-gene and method sensitivity checks; which spatial domains are stable under label-blind benchmarks; and which ligand-receptor hypotheses survive an explicit physical-distance constraint across samples?"
  ],
