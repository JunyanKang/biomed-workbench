  "preconditions": [
    "Spatial counts, physical coordinates/units and biological samples are valid; deconvolution has a count-preserved annotated reference; domain benchmark settings and communication database/distance scale are frozen before review."
  ],
  "provenance": {
    "concept_sources": [
      "https://www.nature.com/articles/s41587-021-01139-4",
      "https://www.nature.com/articles/s41587-021-00830-w",
