{
  "access": "agent_generated",
  "agent_protocol": {
    "forbidden_actions": [
      "Use only project-approved isolated runtimes; do not mutate the host environment.",
      "Do not impute cell types absent from the reference, call concordance accuracy, average methods into truth, call inferred or super-resolved cells observed, tune domains using reviewed labels, connect samples spatially, omit the distance threshold, treat locations/cells as biological replicates, or claim causality from proximity plus expression."
    ],
    "languages": [
      "python",
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
    "parameter_rules": [
      {
        "decision_inputs": [
          "spot versus single-cell resolution",
          "count depth",
          "number of locations",
          "reference match",
          "cell-type granularity",
          "continuous-state objective",
          "spatial-prior need",
          "uncertainty need",
          "GPU availability"
        ],
        "id": "deconvolution-method",
        "parameter": "rctd-cell2location-stereoscope-spotlight-card-spatialdwls-destvi-tangram",
        "selection_rule": "Choose from model assumptions before viewing anatomy: RCTD is a robust baseline with full or doublet modes; cell2location models abundance and technical effects; Stereoscope is a simpler negative-binomial baseline; SPOTlight is marker-seeded NMF; CARD and SpatialDWLS explicitly use spatial or marker screening; DestVI adds continuous within-type state; Tangram maps cells or clusters to locations.",
        "validation_rule": "Review held-out/reconstructed genes, abundance or proportion conservation, uncertainty/residuals, reference and marker subsampling, truth-qualified JSD, method discordance and between-sample reproducibility."
      },
      {
        "decision_inputs": [
          "platform capture diameter",
          "estimated cells per location",
          "segmentation availability",
          "desired output"
        ],
        "id": "projection-resolution",
        "parameter": "mixture-proportion-abundance-or-mapping-probability",
        "selection_rule": "Declare output semantics and resolution before fitting; do not call Tangram mapping probability, CARD imputation or other super-resolution output an observed cell.",
        "validation_rule": "Require matched location identifiers, nonnegative finite outputs, compositional checks where applicable and independent truth or simulation for accuracy claims."
      },
      {
        "decision_inputs": [
          "platform geometry",
          "spot count",
          "image availability",
          "expected scale",
          "runtime"
        ],
        "id": "domain-benchmark",
        "parameter": "method-native-domain-parameters",
        "selection_rule": "Freeze BayesSpace, SpaGCN and STAGATE settings and compare the same observations across at least three seeds.",
        "validation_rule": "Report label-blind stability, coherence, fragmentation, runtime and discordant regions; no automatic winner."
      },
      {
        "decision_inputs": [
          "coordinate unit",
          "cell or spot spacing",
          "ligand range",
          "platform resolution",
          "database"
        ],
        "id": "physical-communication",
        "parameter": "database-distance-heteromeric",
        "selection_rule": "Predeclare a biologically interpretable physical distance and build the graph separately within each sample.",
        "validation_rule": "Prove zero cross-sample edges and report threshold sensitivity, sample support and multiplicity."
      }
    ],
    "postflight_checks": [
      "Reload method-native objects and normalized TSV/JSON outputs; reconcile locations, genes, cell types/domains/interactions, parameters and digests.",
      "Review reference sensitivity, marker sensitivity, truth-qualified JSD, label-blind domain stability, distance-threshold sensitivity and biological-sample support before interpretation."
    ],
    "preflight_checks": [
      "Inspect raw counts, physical coordinates/units, sample identity, reference annotation/batch, gene namespace, platform scale and desired output semantics.",
      "Detect exact method-specific isolated runtimes; do not install or mix incompatible backends inside the analysis step."
    ],
    "provenance_fields": [
      "module-id",
      "module-version",
      "generated-code-sha256",
      "input-digests",
      "method-and-version",
      "sample-key",
      "coordinate-system-and-unit",
      "reference-and-label-source",
      "marker-source",
      "database-and-release",
      "parameters",
      "seeds",
      "runtime-and-memory",
      "output-digests",
      "quality-gates"
    ],
    "requires_observed_execution": true,
    "schema_version": 1,
    "template_sections": [
      {
        "id": "reference-map",
        "output_artifact_types": [
          "spatial_inference_evidence"
        ],
        "purpose": "Estimate cell-state abundance, proportions or mapping probabilities under explicit method and resolution semantics.",
        "required_logic": [
          "Validate raw counts, shared identifiers, reference cell types and batches and run one biological spatial sample per fit.",
          "Use RCTD, cell2location, Stereoscope, SPOTlight, CARD or SpatialDWLS for spot mixtures; use DestVI when continuous within-type state is the objective; use Tangram for cell- or cluster-to-space mapping probabilities.",
          "Run declared methods separately and preserve native models, normalized outputs, uncertainty, residual, reconstruction and held-out-gene diagnostics.",
          "Use JSD as accuracy only with independent or simulated truth and otherwise label it concordance; never average methods into biological truth."
        ],
        "template_files": [
          "templates/run_deconvolution.py",
          "templates/run_rctd_spotlight.R",
          "templates/run_scvi_spatial_deconvolution.py",
          "templates/run_card_spatialdwls.R",
          "templates/evaluate_deconvolution.py"
        ]
      },
      {
        "id": "benchmark-domains",
        "output_artifact_types": [
          "spatial_inference_evidence"
        ],
        "purpose": "Compare BayesSpace, SpaGCN and STAGATE without label leakage.",
        "required_logic": [
          "Freeze preprocessing, number of domains, seeds and method-native parameters.",
          "Calculate seed/resolution stability, spatial coherence, fragmentation, runtime and pairwise discordance.",
          "Use reviewed labels only as post-hoc evaluation and never as a fitting/tuning target."
        ],
        "template_files": [
          "templates/run_domain_benchmark.py",
          "templates/run_python_domain_backend.py",
          "templates/run_bayesspace_backend.R"
        ]
      },
      {
        "id": "distance-constrained-communication",
        "output_artifact_types": [
          "spatial_inference_evidence"
        ],
        "purpose": "Restrict ligand-receptor hypotheses to physical neighborhoods.",
        "required_logic": [
          "Build no cross-sample edges and require a physical distance threshold in the declared unit.",
          "Run COMMOT with declared database, heteromeric and pathway policies.",
          "Aggregate effects, FDR and support at the biological-sample level; retain distance-threshold sensitivity."
        ],
        "template_files": [
          "templates/run_spatial_communication.py"
        ]
      }
    ]
  },
  "alternatives": [
    "single-cell-spatial-analysis",
    "single-cell-communication"
  ],
  "assumptions": [
    "Reference cell states are relevant to the tissue; spatial domains are exploratory; ligand-receptor expression plus proximity proposes communication but does not establish signaling or causality."
  ],
