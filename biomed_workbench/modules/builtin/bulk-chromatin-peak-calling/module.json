    "id": "bulk-chromatin-peak-calling",
    "version": "0.3.0",
    "title": "Call peaks and audit normalization for bulk chromatin profiling",
    "description": "Validate and execute peak calling for bulk ChIP-seq, CUT&RUN, or CUT&Tag, with the measured target or antibody, control design, peak geometry, optional internal-reference normalization, and target-specific validation represented as separate parameters rather than separate assay types.",
    "module_type": "analysis",
    "domains": [
        "omics"
    ],
    "intents": [
        "bulk ChIP-seq peak calling",
        "CUT&RUN peak calling",
        "CUT&Tag peak calling",
        "CUT&Tag with S9.6 declared as the target and optional internal-reference normalization",
        "CUT&Tag targeting S9.6 with RNase H specificity controls",
        "MACS3 narrowPeak broadPeak",
        "ChIP CUTRUN CUTTag \u5cf0\u8c03\u7528",
        "CUT&Tag \u9776\u6807 S9.6 \u3001\u53ef\u9009\u5916\u6e90\u5185\u53c2\u5f52\u4e00\u5316\u4e0e RNase H \u7279\u5f02\u6027\u8bc1\u636e"
    ],
    "questions": [
        "Which assay- and parameter-specific chromatin enrichment intervals are supported by declared treatment and, when applicable, control evidence after MACS3 output reload?"
    ],
    "entrypoint": "biomed_workbench.capabilities.agent_analysis:prepare_agent_analysis",
