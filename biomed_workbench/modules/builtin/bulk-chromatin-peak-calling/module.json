    "preconditions": [
        "Treatment evidence has a declared assay, genome build, coordinate semantics, biological replicate identity and immutable digest; matched input/control is available for ChIP-seq; peak shape and thresholds are declared before execution; output paths are new."
    ],
    "assumptions": [
        "MACS3 intervals are assay- and parameter-specific enrichment evidence. A matched ChIP input reduces but does not eliminate technical and biological confounding; no-control CUT&RUN or CUT&Tag requires separately documented specificity controls."
    ],
    "quality_gates": [
        {
            "id": "bulk-chromatin-input-control",
            "severity": "fatal",
            "description": "Block unless treatment assay, format, build, coordinates, digest, replicate identity, peak mode and threshold are declared; ChIP-seq requires an explicitly matched control in this workflow.",
            "blocks_interpretation": true
        },
        {
            "id": "bulk-chromatin-macs3-output",
            "severity": "fatal",
            "description": "MACS3 must complete without fallback and produce nonempty, coordinate-valid narrowPeak or broadPeak output with finite statistical fields; narrow peaks also require reloadable summits.",
            "blocks_interpretation": true
        },
        {
            "id": "bulk-chromatin-provenance",
            "severity": "fatal",
            "description": "Reload every output and reconcile source digests, command, detected version, assay, control decision, peak mode, genome size, duplicate policy and thresholds before interpretation.",
            "blocks_interpretation": true
        },
        {
            "id": "bulk-chromatin-claim-boundary",
            "severity": "major",
            "description": "Do not interpret a peak as direct binding, motif occupancy, enhancer activity, condition effect, or causal target regulation without appropriate replicate-level and orthogonal evidence.",
            "blocks_interpretation": true
        },
        {
            "id": "cuttag-target-normalization-specificity",
            "severity": "fatal",
            "description": "When CUT&Tag uses an internal reference, the workflow must declare competitive alignment and addition timing, block unreliable reference counts, preserve scale factors, and apply target-specific controls separately; for S9.6, RNase H sensitivity is specificity evidence rather than a biological replicate.",
            "blocks_interpretation": true
        }
    ],
    "limitations": [
        "This module does not perform alignment, duplicate marking, IDR, motif discovery, chromatin interaction calling, or causal peak-to-gene assignment. Internal-reference scaling is optional and valid only when the addition stage and material support between-library normalization. S9.6 is recorded as the CUT&Tag target or antibody; pooled or unreplicated RNase H material is only a specificity annotation, not a condition-level replicate."
    ],
    "evidence_effects": [
        "adds-reloaded-bulk-chromatin-peak-evidence",
        "records-control-and-peak-shape-policy"
    ],
    "alternatives": [
        "single-cell-atac-regulatory"
    ],
    "complements": [
