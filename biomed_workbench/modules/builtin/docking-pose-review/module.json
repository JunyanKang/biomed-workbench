  "quality_gates": [
    {
      "blocks_interpretation": true,
      "description": "Require the exact four-column DiffDock batch contract, unique safe complex names, exclusive protein path or sequence, and complete row accounting.",
      "id": "docking-preparation-manifest",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require stable in-boundary PDB or SDF files, parseable finite protein coordinates, bounded protein sequences, and RDKit-validated ligand identity.",
      "id": "docking-preparation-identity",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require a closed configuration schema, explicit model-family flags, bounded diffusion and sampling parameters, and internally consistent step counts.",
      "id": "docking-preparation-parameters",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Inventory every expected and observed pose, duplicate rank, parse failure, confidence value, and source digest.",
      "id": "docking-review-result-accounting",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require RDKit sanitization, declared ligand identity reconciliation, stereochemical SMILES, heavy-atom count, fragment count, and finite 3D coordinates.",
      "id": "docking-review-chemical-identity",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require receptor coordinate parsing, distance thresholds fixed before review, severe-clash and close-contact counts, and pose-diversity accounting.",
      "id": "docking-review-geometry",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Treat DiffDock confidence as producer-specific ranking evidence, never affinity, thermodynamics, kinetics, or experimental binding.",
      "id": "docking-review-score-semantics",
      "severity": "fatal"
    },
    {
      "blocks_interpretation": true,
      "description": "Require reloadable per-pose and summary outputs with versions, parameters, warnings, and digests.",
      "id": "docking-review-output-integrity",
      "severity": "fatal"
    }
  ],
  "questions": [
    "Which docking poses remain chemically and geometrically reviewable after complete result accounting, and what prevents any pose from being interpreted as binding evidence?"
  ],
