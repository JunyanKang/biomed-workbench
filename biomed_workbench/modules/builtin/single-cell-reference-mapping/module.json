  "title": "Single-cell reference mapping",
  "description": "Map count-backed query cells to frozen scArches SCVI or SCANVI references or portable Symphony references; decompose spatial locations with RCTD full or doublet modes; evaluate probability or abundance projections with Jensen-Shannon divergence; preserve reference geometry, query identities and unknown states.",
  "module_type": "analysis",
  "domains": ["omics", "classification"],
  "intents": ["reference-map", "atlas-project", "label-transfer", "query-to-reference mapping"],
  "questions": ["How does a query map onto a frozen reference atlas?", "Which query states are unsupported by the reference?", "Which cell-type mixtures explain spatial locations?", "Does JSD measure accuracy against truth or only concordance between projections?"],
  "entrypoint": "agent-generated-analysis",
  "execution": {"kind": "workflow", "timeout_seconds": 30, "max_output_bytes": 2000000},
  "maturity": "validated",
  "input_artifacts": [
    {
