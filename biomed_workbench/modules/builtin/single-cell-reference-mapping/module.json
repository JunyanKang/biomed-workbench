  "preconditions": ["Reference model and annotation release are frozen and versioned; query raw counts, cells and feature namespace are explicit; reference-query feature overlap is measured before mapping."],
  "assumptions": ["The reference covers at least part of the query biology and compatible assay features; nearest reference states are hypotheses rather than ground truth."],
  "quality_gates": [
    {"id": "frozen-reference-and-feature-overlap", "severity": "fatal", "description": "Block unversioned references, ambiguous feature namespaces, inadequate feature overlap or accidental reference retraining.", "blocks_interpretation": true},
    {"id": "query-identity-and-unknown-retention", "severity": "fatal", "description": "Every query cell must be retained exactly once and low-confidence, unsupported or absent-reference populations must remain unknown.", "blocks_interpretation": true},
    {"id": "mapping-holdout-and-reload", "severity": "fatal", "description": "Require label holdout or independent query evaluation, saved native reference/query objects, output reload and unchanged source counts.", "blocks_interpretation": true},
    {"id": "spatial-mixture-and-jsd-semantics", "severity": "fatal", "description": "Use RCTD full mode for multicellular spots and doublet mode only for near-single-cell locations; interpret JSD as accuracy only against independent or simulated truth and otherwise as concordance.", "blocks_interpretation": true}
  ],
  "limitations": ["Reference mapping cannot discover a missing reference population by forced nearest-neighbor assignment. scArches inherits the base model and reference limitations. Symphony maps to a linear Harmony-style reference and does not create count-level evidence. RCTD estimates reference-defined cell-type mixtures and cannot recover states absent from the reference. JSD is a bounded distribution distance, not an integration or labeling algorithm."],
  "evidence_effects": ["adds-scarches-symphony-rctd-and-jsd-reference-projection-evidence"],
  "alternatives": ["single-cell-atlas-annotation", "single-cell-reference-annotation"],
  "complements": ["single-cell-integration-benchmark", "single-cell-generative-modeling"],
