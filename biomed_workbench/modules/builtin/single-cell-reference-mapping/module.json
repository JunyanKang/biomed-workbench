        {"name": "seurat-rds", "versions": ["5"], "representations": ["binary", "container"], "compression": ["internal"], "required_indexes": ["cell-id", "feature-id"], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["declared-reference-release"], "orientations": ["reference-or-query-cell-by-gene"]}
      ]
    }
  ],
  "output_artifacts": [
    {
      "name": "reference_mapping_evidence",
      "artifact_type": "single_cell_reference_mapping_evidence",
      "processing_levels": ["mapped", "confidence-reviewed", "unknown-retained", "reloaded"],
      "required_metadata": ["method", "version", "reference-digest", "query-digest", "feature-overlap", "parameters", "mapping-confidence", "unknown-reasons"],
      "source_policy": "upstream_required",
      "formats": [
        {"name": "h5ad", "versions": ["0.1.0"], "representations": ["container", "sparse"], "compression": ["internal"], "required_indexes": ["observation-id", "feature-id"], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["inherited-from-reference"], "orientations": ["query-cell-by-gene-with-reference-embedding"]},
        {"name": "seurat-rds", "versions": ["5"], "representations": ["binary", "container"], "compression": ["internal"], "required_indexes": ["cell-id", "feature-id"], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": ["inherited-from-reference"], "orientations": ["query-cell-by-feature-with-symphony-reduction"]},
        {"name": "inline-json", "versions": ["1"], "representations": ["structured"], "compression": ["none"], "required_indexes": [], "coordinate_systems": [], "genome_build_policy": "not_applicable", "genome_builds": [], "annotation_releases": [], "orientations": ["mapping-provenance-and-gates"]}
      ]
    }
