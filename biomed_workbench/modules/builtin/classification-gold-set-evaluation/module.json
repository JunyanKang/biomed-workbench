  "id": "classification-gold-set-evaluation",
  "version": "1.0.0",
  "title": "Evaluate a classification gold set with provenance and regression gates",
  "description": "Compute closed-label confusion, aggregate and per-class metrics, minimum-support-aware thresholds, advisory expert concordance, and baseline regressions while blocking circular or leakage-unreviewed gold sets.",
  "module_type": "validation",
  "domains": [
    "evidence",
    "research-quality",
    "statistics"
  ],
  "intents": [
    "classification gold set evaluation",
    "evaluate benchmark thresholds and regressions",
    "评估分类 gold set 的阈值、逐类指标和回归",
    "科研算法评测与基准回归检查"
  ],
  "questions": [
    "Does the independently adjudicated classification gold set meet declared aggregate, per-class, support, provenance, leakage, and regression gates?"
  ],
  "entrypoint": "biomed_workbench.capabilities.evaluation:evaluate_classification_gold_set",
  "execution": {
    "kind": "python",
    "timeout_seconds": 30,
    "max_output_bytes": 10000000
  },
