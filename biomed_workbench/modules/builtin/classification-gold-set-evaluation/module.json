  "preconditions": [
    "Cases have unique IDs, closed declared labels, independently recorded expected and observed labels, and explicit gold-set provenance."
  ],
  "assumptions": [
    "Each case is an independent evaluation unit unless the study design explicitly justifies a different effective-sample interpretation outside this module."
  ],
  "quality_gates": [
    {
      "id": "gold-set-independence",
      "severity": "major",
      "description": "Gold annotations must be independent of the evaluated system rather than copied from its reducer or outputs.",
      "blocks_interpretation": true
    },
    {
      "id": "gold-set-leakage",
      "severity": "major",
      "description": "Train, prompt, fixture, benchmark, and annotation leakage must be reviewed before performance interpretation.",
      "blocks_interpretation": true
    },
    {
      "id": "gold-set-class-support",
      "severity": "major",
      "description": "Every gated class metric must meet its declared minimum gold support; empty or undersampled classes cannot silently pass.",
      "blocks_interpretation": true
    },
    {
      "id": "gold-set-regression",
      "severity": "major",
      "description": "Dropped baseline metrics and polarity-corrected regressions beyond the declared fractional limit block acceptance.",
      "blocks_interpretation": true
    }
  ],
  "limitations": [
    "Performance applies only to the declared task, population, label policy, gold-set version, and sampled cases; correlated cases, prevalence shift, calibration, uncertainty intervals, and external validity require separate analysis."
  ],
  "evidence_effects": [
    "validates_algorithm_performance",
    "detects_performance_regression",
    "limits_benchmark_claim"
  ],
