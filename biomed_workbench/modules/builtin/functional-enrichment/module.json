          "complete ranking",
          "ranking direction"
        ],
        "id": "ora-vs-gsea-input",
        "parameter": "mode-universe-ranking",
        "selection_rule": "Use ORA only for a predeclared selected set with its measured universe; use GSEA only for the complete ranking and a declared statistic direction.",
        "validation_rule": "Block incompatible inputs, duplicate or nonfinite rankings, missing universe, post hoc threshold relaxation and significance-selected GSEA."
