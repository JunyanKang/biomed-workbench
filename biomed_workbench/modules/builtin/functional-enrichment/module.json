        "parameter": "organism-namespace-resource-size",
        "selection_rule": "Declare the exact identifier namespace, resource/release and gene-set size limits before inspecting enriched terms.",
        "validation_rule": "Report mapping losses and all parameters and keep GO, KEGG, ORA and GSEA results distinct."
      }
    ],
    "postflight_checks": [
      "Reload complete term tables and PDF/SVG figures, validate bounds and ordering, retain empty results and block causal language."
    ],
    "preflight_checks": [
      "Detect exact R, clusterProfiler, fgsea, enrichplot, AnnotationDbi, ggplot2, jsonlite, digest and selected OrgDb versions.",
      "Inspect actual list, universe or ranking and freeze database, mapping, size, p-adjustment and seed parameters."
