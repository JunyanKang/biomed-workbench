  "agent_protocol": {
    "forbidden_actions": [
      "Use only already available, project-approved scientific runtimes; do not change the user's execution environment from this module.",
      "Do not invent a background, run GSEA on significance-filtered genes, silently deduplicate rankings, switch databases, relax thresholds after seeing results, fill empty results, or claim pathway activation or causality from enrichment alone."
    ],
    "languages": [
      "r",
      "notebook"
    ],
    "mode": "packaged_parameterized_workflow",
