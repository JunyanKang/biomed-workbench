        "output_artifact_types": [
          "functional_enrichment_evidence"
        ],
        "purpose": "Separate ORA and GSEA input semantics, execute the declared GO or KEGG method, render official plot families, and preserve empty results.",
        "required_logic": [
          "Require selected genes plus tested universe for ORA or a complete finite unique ranked vector with direction and tie policy for GSEA.",
          "Record organism, identifier namespace, mapping losses, OrgDb or KEGG source, release, size limits, adjustment, seed and exact versions before execution.",
          "Reload all results and figures, preserve empty output, and maintain association-level claim boundaries."
